              }
            },
            "required": [
              "title",
              "copy"
            ],
            "additionalProperties": false
          }
        },
        "challengePoints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "interventionSteps": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "outcomes": {
