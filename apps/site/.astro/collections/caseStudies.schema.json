          "type": "string"
        },
        "seoTitle": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "badge": {
          "type": "string"
        },
        "statusLabel": {
          "type": "string"
        },
        "heroSubtitle": {
          "type": "string"
        },
        "typeLabel": {
          "type": "string"
        },
        "durationLabel": {
          "type": "string"
        },
        "scopeLabel": {
          "type": "string"
        },
