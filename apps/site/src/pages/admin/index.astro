---
import AdminLayout from '../../layouts/AdminLayout.astro';
import AdminDashboardCharts from '../../components/admin/AdminDashboardCharts.astro';
import { getAdminDashboardData } from '../../lib/admin-dashboard';

const dashboard = await getAdminDashboardData();
const focusClusters = dashboard.clusterSnapshots.slice(0, 3);
const barueriAlphavilleWatchlist = [
  {
    label: 'Hub Barueri',
    path: '/cidades/barueri/'
  },
  {
    label: 'Agência local',
    path: '/servicos/agencia-de-seo-em-barueri/'
  },
  {
    label: 'Consultoria local',
    path: '/servicos/consultoria-seo-em-barueri/'
  },
  {
    label: 'Auditoria local',
    path: '/servicos/auditoria-seo-em-barueri/'
  },
  {
    label: 'BOFU preço',
    path: '/blog/quanto-custa-seo-em-barueri-e-alphaville/'
  },
  {
    label: 'BOFU prazo',
    path: '/blog/em-quanto-tempo-seo-gera-resultado-em-barueri-e-alphaville/'
  },
  {
    label: 'BOFU escolha',
    path: '/blog/agencia-seo-ou-consultoria-seo-em-barueri-e-alphaville/'
  }
];
const barueriAlphavilleQueryMatrix = [
  {
    family: 'Contratação genérica',
    primaryPage: '/servicos/agencia-de-seo-em-barueri/',
    acceptablePage: '/agencia-de-seo/',
    queries: ['agencia de seo em barueri', 'agencia de seo alphaville', 'empresa de seo em barueri', 'empresa de seo alphaville']
  },
  {
    family: 'Consultoria e consultor',
    primaryPage: '/servicos/consultoria-seo-em-barueri/',
    acceptablePage: '/servicos/agencia-de-seo-em-barueri/',
    queries: ['consultoria seo em barueri', 'consultoria seo alphaville', 'consultor seo em barueri', 'consultor seo alphaville', 'especialista seo barueri']
  },
  {
    family: 'Diagnóstico e auditoria',
    primaryPage: '/servicos/auditoria-seo-em-barueri/',
    acceptablePage: '/servicos/consultoria-seo-em-barueri/',
    queries: ['auditoria seo em barueri', 'especialista em seo alphaville', 'diagnostico seo barueri']
  }
];
const barueriAlphavilleSearchConsoleRules = [
  'Se a query local relevante cair na home ou na canônica ampla por 2 a 3 semanas, reforçar links internos e copy da página local correta.',
  'Se impressões subirem e CTR cair abaixo de 2%, revisar primeiro title, description e snippet da página que já recebe a impressão.',
  'Se a família de consultor ou especialista crescer, reforçar consultoria local antes de pensar em nova URL.',
  'Se auditoria local aparecer pouco e a query cair em consultoria, revisar FAQ, prova operacional e comparativos de entrada.'
];
---
<AdminLayout
  title="Painel Editorial"
  description="Camada administrativa da AUDITSEO para governar clusters, backlog editorial, categorias e ativos de prova sem quebrar a arquitetura do site."
  eyebrow="Admin"
>
  <div class="admin-banner">
    <strong>Fase 1 do admin</strong>
    <div>
      Painel operacional com dados reais do site. A próxima fase adiciona autenticação, persistência e fluxo de
      publicação transacional sem soltar a arquitetura.
    </div>
  </div>

  <section class="admin-grid admin-grid--metrics">
    {dashboard.metrics.map((metric) => (
      <article class="admin-stat-card">
        <div class="admin-card-eyebrow">{metric.label}</div>
        <div class="admin-stat-value">{metric.value}</div>
        <p class="admin-stat-copy">{metric.copy}</p>
      </article>
    ))}
  </section>

  <section class="admin-section" data-admin-capture-summary-root hidden>
    <div class="admin-section-head">
      <div>
        <div class="admin-card-eyebrow">Atribuição</div>
        <h2 class="admin-section-title">Resumo de captação do site</h2>
      </div>
      <p class="admin-section-copy">
        Resumo anônimo da origem das conversões capturadas pelo site público. Serve para identificar páginas e tipos de entrada com mais tração.
      </p>
    </div>

    <div class="admin-grid admin-grid--metrics" data-admin-capture-summary-cards></div>

    <div class="admin-grid admin-grid--two admin-section">
      <article class="admin-content-card">
        <div class="admin-section-head">
          <div>
            <div class="admin-card-eyebrow">Top páginas</div>
            <h3 class="admin-section-title">Páginas com mais origem de captura</h3>
          </div>
        </div>
        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Página</th>
                <th>Capturas</th>
              </tr>
            </thead>
            <tbody data-admin-capture-pages></tbody>
          </table>
        </div>
      </article>

      <article class="admin-content-card">
        <div class="admin-section-head">
          <div>
            <div class="admin-card-eyebrow">Tipos</div>
            <h3 class="admin-section-title">Mix de conversão</h3>
          </div>
        </div>
        <ul class="admin-list" data-admin-capture-types></ul>
      </article>
    </div>
  </section>

  <section class="admin-section" data-admin-local-cluster-summary-root data-admin-local-cluster-days="7" hidden>
    <script
      is:inline
      type="application/json"
      data-admin-local-cluster-watchlist
      set:html={JSON.stringify(barueriAlphavilleWatchlist)}
    ></script>

    <div class="admin-section-head">
      <div>
        <div class="admin-card-eyebrow">Praça prioritária</div>
        <h2 class="admin-section-title">Barueri / Alphaville nos últimos 7 dias</h2>
      </div>
      <p class="admin-section-copy">
        Leitura anônima da captação do cluster local principal. Use este bloco para revisar tração da praça antes de abrir novas derivações.
      </p>
    </div>

    <div class="admin-grid admin-grid--metrics" data-admin-local-cluster-summary-cards></div>

    <div class="admin-grid admin-grid--two admin-section">
      <article class="admin-content-card">
        <div class="admin-section-head">
          <div>
            <div class="admin-card-eyebrow">Watchlist</div>
            <h3 class="admin-section-title">Páginas locais monitoradas</h3>
          </div>
        </div>
        <div class="admin-table-wrap">
          <table class="admin-table">
            <thead>
              <tr>
                <th>Página</th>
                <th>Capturas</th>
              </tr>
            </thead>
            <tbody data-admin-local-cluster-pages></tbody>
          </table>
        </div>
      </article>

      <article class="admin-content-card">
        <div class="admin-section-head">
          <div>
            <div class="admin-card-eyebrow">Mix local</div>
            <h3 class="admin-section-title">Tipos de captura da praça</h3>
          </div>
        </div>
        <ul class="admin-list" data-admin-local-cluster-types></ul>
      </article>
    </div>
  </section>

  <section class="admin-grid admin-grid--two admin-section">
    <article class="admin-content-card">
      <div class="admin-section-head">
        <div>
          <div class="admin-card-eyebrow">Search Console</div>
          <h2 class="admin-section-title">Watchlist de queries esperadas</h2>
        </div>
        <p class="admin-section-copy">
          Esta matriz define qual página deveria receber cada família de query local de Barueri / Alphaville antes de qualquer expansão de URL.
        </p>
      </div>

      <div class="admin-table-wrap">
        <table class="admin-table">
          <thead>
            <tr>
              <th>Família</th>
              <th>Página primária</th>
              <th>Aceitável</th>
              <th>Queries</th>
            </tr>
          </thead>
          <tbody>
            {barueriAlphavilleQueryMatrix.map((group) => (
              <tr>
                <td>{group.family}</td>
                <td><code>{group.primaryPage}</code></td>
                <td><code>{group.acceptablePage}</code></td>
                <td>{group.queries.join(' • ')}</td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </article>

    <article class="admin-content-card">
      <div class="admin-section-head">
        <div>
          <div class="admin-card-eyebrow">Regras</div>
          <h2 class="admin-section-title">Como interpretar a praça</h2>
        </div>
        <p class="admin-section-copy">
          Antes de abrir qualquer nova derivação, estas são as respostas operacionais esperadas para as leituras do cluster.
        </p>
      </div>

      <ul class="admin-list">
        {barueriAlphavilleSearchConsoleRules.map((item) => (
          <li class="admin-list-item">
            <strong class="admin-list-title">{item}</strong>
          </li>
        ))}
      </ul>
    </article>
  </section>

  <AdminDashboardCharts categories={dashboard.categoryCoverage} clusters={dashboard.clusterSnapshots} />

  <section class="admin-section">
    <div class="admin-section-head">
      <div>
        <div class="admin-card-eyebrow">Foco imediato</div>
        <h2 class="admin-section-title">Clusters que definem a marca</h2>
      </div>
      <p class="admin-section-copy">
        Estes 3 clusters concentram a tese central do domínio. Se eles ficarem rasos, o restante cresce torto.
      </p>
    </div>

    <div class="admin-focus-grid">
      {focusClusters.map((cluster) => (
        <article class="admin-focus-card">
          <div class="admin-chip-row">
            <span class="admin-chip admin-pill-live">B{cluster.businessPriority}</span>
            <span class="admin-chip admin-pill-live">E{cluster.editorialPriority}</span>
            <span class="admin-chip">{cluster.status}</span>
          </div>
          <h3 class="admin-focus-title">{cluster.title}</h3>
          <p class="admin-focus-copy">{cluster.thesis}</p>
          <div class="admin-progress" aria-label={`Maturidade do cluster ${cluster.title}`}>
            <span style={`width:${cluster.completionRate}%`}></span>
          </div>
          <div class="admin-kpi-inline">{cluster.completionRate}% dos ativos priorizados já publicados</div>
          <ul class="admin-focus-list">
            {cluster.nextActions.slice(0, 3).map((item) => (
              <li class="admin-focus-item">
                <strong>{item}</strong>
              </li>
            ))}
          </ul>
          <div class="admin-chip-row">
            {cluster.dominantIntents.map((intent) => (
              <span class="admin-chip">{intent}</span>
            ))}
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="admin-grid admin-grid--two admin-section">
    <article class="admin-content-card">
      <div class="admin-section-head">
        <div>
          <div class="admin-card-eyebrow">Fila</div>
          <h2 class="admin-section-title">Backlog editorial prioritário</h2>
        </div>
      </div>
      <ul class="admin-list">
        {dashboard.publicationQueue.slice(0, 8).map((item) => (
          <li class="admin-list-item">
            <div class="admin-list-label">{item.type}</div>
            <strong class="admin-list-title">{item.label}</strong>
            <div class="admin-list-meta">{item.clusterTitle} • {item.priority}</div>
            <p class="admin-list-copy">{item.notes}</p>
          </li>
        ))}
      </ul>
    </article>

    <article class="admin-content-card">
      <div class="admin-section-head">
        <div>
          <div class="admin-card-eyebrow">Atualizações</div>
          <h2 class="admin-section-title">Artigos mais recentes</h2>
        </div>
      </div>
      <ul class="admin-list">
        {dashboard.recentUpdates.map((article) => (
          <li class="admin-list-item">
            <div class="admin-list-label">{article.category.shortTitle}</div>
            <a class="admin-list-title admin-inline-link" href={article.canonicalPath}>
              {article.title}
            </a>
            <div class="admin-list-meta">
              {article.publishedLabel} • atualizado em {new Intl.DateTimeFormat('pt-BR').format(new Date(article.modifiedTime))}
            </div>
            <p class="admin-list-copy">{article.excerpt}</p>
          </li>
        ))}
      </ul>
    </article>
  </section>

  <section class="admin-section">
    <div class="admin-section-head">
      <div>
        <div class="admin-card-eyebrow">Cobertura</div>
        <h2 class="admin-section-title">Categorias do blog</h2>
      </div>
      <p class="admin-section-copy">
        A categoria só pode escalar se tiver pilares, volume útil e ligação real com serviços.
      </p>
    </div>

    <div class="admin-table-wrap">
      <table class="admin-table">
        <thead>
          <tr>
            <th>Categoria</th>
            <th>Artigos</th>
            <th>Pilares</th>
            <th>Links para serviços</th>
            <th>Última atualização</th>
          </tr>
        </thead>
        <tbody>
          {dashboard.categoryCoverage.map((category) => (
            <tr>
              <td>
                <a href={`/blog/categoria/${category.slug}/`}>{category.title}</a>
              </td>
              <td>{category.articlesCount}</td>
              <td>
                {category.pillarCoverage}/{category.pillarTarget}
              </td>
              <td>{category.serviceLinksCount}</td>
              <td>{category.latestUpdate}</td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>
</AdminLayout>
