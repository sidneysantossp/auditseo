---
import SeoHead from '../../components/SeoHead.astro';
import AdminIcon from '../../components/admin/AdminIcon.astro';
import '../../styles/admin-prototype.css';

const menuGroups = [
  {
    title: 'Menu',
    items: [
      { label: 'Dashboard', count: '3', active: true, icon: 'dashboard' },
      { label: 'Pipeline', icon: 'pipeline' },
      { label: 'Leads', icon: 'leads' },
      { label: 'Atividades', icon: 'activities' }
    ]
  },
  {
    title: 'Editorial',
    items: [
      { label: 'Conteúdos', icon: 'content' },
      { label: 'Clusters', icon: 'clusters' },
      { label: 'Workflow', icon: 'workflow' }
    ]
  }
];

const metricCards = [
  { label: 'Receita aberta', value: 'R$ 184.000', delta: '+12%', icon: 'revenue' },
  { label: 'Leads qualificados', value: '27', delta: '+4', icon: 'users' },
  { label: 'Publicações ativas', value: '151', delta: '+9', icon: 'published' },
  { label: 'Clusters em ação', value: '7', delta: '2 locais', icon: 'stack' }
];

const overviewMatrix = [
  ['Leads', '27'],
  ['Propostas', '8'],
  ['Ganhos', '3'],
  ['Follow-up', '11'],
  ['Clusters', '7'],
  ['Backlog', '14']
];

const funnelCards = [
  { title: 'Inbound', amount: '06', note: 'site, WhatsApp e orgânico' },
  { title: 'Proposta', amount: '04', note: 'tickets entre R$ 7k e R$ 15k' },
  { title: 'Negociação', amount: '05', note: '3 com follow-up nesta semana' }
];

const priorities = [
  { rank: '#1', title: 'Alphaville / Barueri', note: 'money page + BOFU local' },
  { rank: '#2', title: 'AI Overviews', note: 'expansão comercial nacional' },
  { rank: '#3', title: 'Refresh / agência de SEO', note: 'preservar query vencedora' }
];

const timeline = [
  ['Hoje', 'Revisar títulos locais e links internos'],
  ['Amanhã', 'Publicar comparativo agência x consultoria'],
  ['Qui', 'Ler Search Console por família de query'],
  ['Sex', 'Validar saúde técnica do cluster']
];

const focusBlocks = [
  ['Cluster local', '4 ativos em execução'],
  ['AI Overviews', '3 ativos comerciais'],
  ['Refresh crítico', '2 páginas canônicas']
];

const alerts = [
  ['Alta', '3 follow-ups comerciais vencem hoje'],
  ['Média', '2 artigos BOFU aguardam revisão final'],
  ['Baixa', '1 money page precisa só de ajuste de snippet']
];

const recentAssets = [
  ['Hoje', 'Quanto custa SEO em Alphaville'],
  ['Ontem', 'Agência x consultoria para AI Overviews'],
  ['Seg', 'Refresh de agência de SEO']
];

const overviewSeries = [
  { month: 'Fev', previous: 42, current: 48 },
  { month: 'Mar', previous: 45, current: 54 },
  { month: 'Abr', previous: 37, current: 44 },
  { month: 'Mai', previous: 52, current: 61 },
  { month: 'Jun', previous: 48, current: 58 },
  { month: 'Jul', previous: 59, current: 66 },
  { month: 'Ago', previous: 55, current: 63 },
  { month: 'Set', previous: 68, current: 79 },
  { month: 'Out', previous: 57, current: 69 }
];
---
<!doctype html>
<html lang="pt-BR">
  <head>
    <SeoHead
      title="Protótipo Admin Borex Study"
      description="Estudo de dashboard administrativo inspirado na malha de Borex, adaptado para a AUDITSEO."
      canonicalPath="/admin/prototipo/"
      noindex={true}
    />
  </head>
  <body class="admin-prototype-body">
    <div class="proto-shell">
      <aside class="proto-sidebar">
        <div class="proto-sidebar__brand">
          <span class="proto-sidebar__mark">AUDITSEO</span>
          <button class="proto-sidebar__toggle" type="button" aria-label="Menu de navegação">
            <span></span>
            <span></span>
            <span></span>
          </button>
        </div>

        {menuGroups.map((group) => (
          <section class="proto-sidebar__group">
            <span class="proto-label">{group.title}</span>
            <nav class="proto-menu">
              {group.items.map((item) => (
                <a class:list={['proto-menu__item', item.active && 'is-active']} href="#">
                  <span class="proto-menu__label">
                    <AdminIcon name={item.icon} class="proto-menu__icon" size={18} />
                    <span>{item.label}</span>
                  </span>
                  {item.count && <em>{item.count}</em>}
                </a>
              ))}
            </nav>
          </section>
        ))}

        <div class="proto-sidebar__footer">
          <span class="proto-label">Stack atual</span>
          <strong>Astro + CMS API + operação editorial tipada</strong>
          <p>Este mockup testa malha, densidade e scanning antes da migração do admin real.</p>
        </div>
      </aside>

      <div class="proto-workspace">
        <header class="proto-topbar">
          <div>
            <span class="proto-label">Admin</span>
            <h1>Dashboard</h1>
          </div>

          <div class="proto-topbar__actions">
            <span class="proto-icon-button" aria-hidden="true"><AdminIcon name="search" size={18} /></span>
            <span class="proto-icon-button" aria-hidden="true"><AdminIcon name="grid" size={18} /></span>
            <span class="proto-icon-button" aria-hidden="true"><AdminIcon name="bell" size={18} /></span>
            <a class="proto-primary-button" href="/admin/">Admin real</a>
            <span class="proto-avatar" aria-hidden="true">AS</span>
          </div>
        </header>

        <main class="proto-content">
          <section class="proto-metrics">
            {metricCards.map((item) => (
              <article class="proto-card proto-card--metric">
                <span class="proto-metric__icon" aria-hidden="true">
                  <AdminIcon name={item.icon} class="proto-metric__icon-svg" size={24} stroke={1.7} />
                </span>
                <div class="proto-metric__body">
                  <span class="proto-metric__label">{item.label}</span>
                  <div class="proto-metric__row">
                    <strong>{item.value}</strong>
                    <em>{item.delta}</em>
                  </div>
                </div>
              </article>
            ))}
          </section>

          <section class="proto-dashboard-grid">
            <article class="proto-card proto-card--overview">
              <div class="proto-card__head">
                <div>
                  <span class="proto-card__eyebrow">Overview</span>
                  <h2>Operação do mês</h2>
                </div>
                <span class="proto-card__meta">Leitura anual</span>
              </div>

              <div class="proto-overview">
                <div class="proto-overview__stats">
                  <div class="proto-overview__lead">
                    <span class="proto-card__eyebrow">Este mês</span>
                    <strong>R$ 24.568</strong>
                    <em>+2,65%</em>
                  </div>

                  <div class="proto-overview__matrix">
                    {overviewMatrix.map((item) => (
                      <div class="proto-overview__cell">
                        <span>{item[0]}</span>
                        <strong>{item[1]}</strong>
                      </div>
                    ))}
                  </div>
                </div>

                <div class="proto-chart" aria-label="Gráfico ilustrativo">
                  <div class="proto-chart__yaxis">
                    <span>40k</span>
                    <span>30k</span>
                    <span>20k</span>
                    <span>10k</span>
                    <span>0k</span>
                  </div>
                  <div class="proto-chart__plot">
                    <div class="proto-chart__grid-lines">
                      <span></span>
                      <span></span>
                      <span></span>
                      <span></span>
                    </div>
                    <div class="proto-chart__bars">
                      {overviewSeries.map((item) => (
                        <div class="proto-chart__group">
                          <div class="proto-chart__group-bars">
                            <span class="is-previous" style={`height:${item.previous}%`}></span>
                            <span class="is-current" style={`height:${item.current}%`}></span>
                          </div>
                          <strong>{item.month}</strong>
                        </div>
                      ))}
                    </div>
                  </div>
                </div>
              </div>
            </article>

            <aside class="proto-side-column">
              <article class="proto-card proto-card--focus">
                <div class="proto-card__head">
                  <div>
                    <span class="proto-card__eyebrow">Foco</span>
                    <h2>Foco do trimestre</h2>
                  </div>
                </div>

                <div class="proto-focus">
                  <div class="proto-focus__lead">
                    <div class="proto-focus__progress">
                      <div class="proto-focus__bar">
                        <span style="width:76%"></span>
                      </div>
                      <strong>76%</strong>
                    </div>
                    <p>Prioridade concentrada em Alphaville/Barueri e expansão nacional orientada a SEO comercial.</p>
                  </div>

                  <div class="proto-focus__list">
                    {focusBlocks.map((item) => (
                      <div class="proto-focus__item">
                        <span>{item[0]}</span>
                        <strong>{item[1]}</strong>
                      </div>
                    ))}
                  </div>
                </div>
              </article>

              <article class="proto-card">
                <div class="proto-card__head">
                  <div>
                    <span class="proto-card__eyebrow">Alertas</span>
                    <h2>Leitura operacional</h2>
                  </div>
                </div>

                <div class="proto-alert-list">
                  {alerts.map((item) => (
                    <div class="proto-alert-item">
                      <em>{item[0]}</em>
                      <strong>{item[1]}</strong>
                    </div>
                  ))}
                </div>

                <div class="proto-card__divider"></div>

                <div class="proto-mini-feed">
                  <div class="proto-mini-feed__head">
                    <span class="proto-card__eyebrow">Publicados</span>
                    <span class="proto-card__meta">últimos ativos</span>
                  </div>
                  {recentAssets.map((item) => (
                    <div class="proto-mini-feed__item">
                      <span>{item[0]}</span>
                      <strong>{item[1]}</strong>
                    </div>
                  ))}
                </div>
              </article>
            </aside>
          </section>

          <section class="proto-bottom-grid">
            <article class="proto-card">
              <div class="proto-card__head">
                <div>
                  <span class="proto-card__eyebrow">Pipeline</span>
                  <h2>Movimento por etapa</h2>
                </div>
                <span class="proto-card__meta">R$ 184k em aberto</span>
              </div>

              <div class="proto-funnel">
                {funnelCards.map((item) => (
                  <div class="proto-funnel__card">
                    <span>{item.title}</span>
                    <strong>{item.amount}</strong>
                    <p>{item.note}</p>
                  </div>
                ))}
              </div>
            </article>

            <article class="proto-card">
              <div class="proto-card__head">
                <div>
                  <span class="proto-card__eyebrow">Prioridades</span>
                  <h2>Ativos que puxam receita</h2>
                </div>
                <span class="proto-card__meta">mensal</span>
              </div>

              <div class="proto-priority-list">
                {priorities.map((item) => (
                  <div class="proto-priority-item">
                    <span>{item.rank}</span>
                    <div>
                      <strong>{item.title}</strong>
                      <p>{item.note}</p>
                    </div>
                  </div>
                ))}
              </div>
            </article>

            <article class="proto-card">
              <div class="proto-card__head">
                <div>
                  <span class="proto-card__eyebrow">Agenda</span>
                  <h2>Ritmo da semana</h2>
                </div>
                <span class="proto-card__meta">execução</span>
              </div>

              <div class="proto-timeline">
                {timeline.map((item) => (
                  <div class="proto-timeline__item">
                    <span>{item[0]}</span>
                    <strong>{item[1]}</strong>
                  </div>
                ))}
              </div>
            </article>
          </section>
        </main>
      </div>
    </div>
  </body>
</html>
