---
import '../styles/agencia-seo-parity.css';
import AgencySeoLegacyContent from '../components/AgencySeoLegacyContent.astro';
import AgencySeoLocalCluster from '../components/AgencySeoLocalCluster.astro';
import AgencySeoSchemas from '../components/AgencySeoSchemas.astro';
import LegacyContentEnhancements from '../components/LegacyContentEnhancements.astro';
import InstitutionalLayout from '../layouts/InstitutionalLayout.astro';
---
<InstitutionalLayout
  title="Agencia de SEO AI-First para Empresas | AUDITSEO"
  description="A AUDITSEO oferece agencia e consultoria SEO especializada em SEO tecnico, AI Overviews, SEO local e busca generativa para empresas em todo o Brasil, com primeira frente local ativa em Barueri e Alphaville."
  canonicalPath="/agencia-de-seo/"
  imagePath="/images/agencia-de-seo.png"
  breadcrumbs={[
    { label: 'Home', path: '/' },
    { label: 'Agencia de SEO', path: '/agencia-de-seo/' }
  ]}
>
  <AgencySeoLegacyContent />
  <AgencySeoLocalCluster
    eyebrow="Primeira frente local"
    title="A PAGINA CANONICA DA AGENCIA JA DISTRIBUI PESO PARA BARUERI E ALPHAVILLE"
    subtitle="A URL institucional continua ampla e nacional. A aplicacao local de maior intencao fica concentrada no cluster de Barueri e Alphaville, onde agencia, empresa e especialista em SEO sao tratados sem abrir paginas duplicadas por sinonimo."
  />
  <AgencySeoSchemas />
  <LegacyContentEnhancements />
</InstitutionalLayout>
