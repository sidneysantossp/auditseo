---
import '../styles/agencia-seo-parity.css';
import AgencySeoLegacyContent from '../components/AgencySeoLegacyContent.astro';
import AgencySeoLocalCluster from '../components/AgencySeoLocalCluster.astro';
import AgencySeoSchemas from '../components/AgencySeoSchemas.astro';
import LegacyContentEnhancements from '../components/LegacyContentEnhancements.astro';
import InstitutionalLayout from '../layouts/InstitutionalLayout.astro';
---
<InstitutionalLayout
  title="Agencia de SEO AI-First para Empresas | AUDITSEO"
  description="A AUDITSEO oferece agencia de SEO AI-first para empresas que precisam combinar SEO tecnico, AI Overviews, SEO generativo, consultoria e auditoria em uma operacao comercial mais forte em Sao Paulo e em outras pracas prioritarias."
  canonicalPath="/agencia-de-seo/"
  imagePath="/images/agencia-de-seo.png"
  breadcrumbs={[
    { label: 'Home', path: '/' },
    { label: 'Agencia de SEO', path: '/agencia-de-seo/' }
  ]}
>
  <AgencySeoLegacyContent />
  <AgencySeoLocalCluster
    eyebrow="Hub comercial"
    title="A PAGINA DE AGENCIA PRECISA VIRAR O DISTRIBUIDOR PRINCIPAL DO CLUSTER AI-FIRST"
    subtitle="A URL de agencia continua ampla e nacional, mas agora precisa empurrar a vitoria de Sao Paulo para consultoria, auditoria, AI Overview Optimization, comparativos BOFU e aplicacoes locais sem abrir paginas duplicadas por sinonimo."
    signals={[
      'Empresa de SEO',
      'Especialista em SEO',
      'Consultor SEO',
      'AI Overviews',
      'SEO generativo',
      'Sao Paulo'
    ]}
    links={[
      {
        title: 'Consultoria SEO',
        copy: 'Entrada para operacoes que ja procuram consultor SEO, direcao continua e backlog com governanca mais clara.',
        path: '/servicos/consultoria-seo/'
      },
      {
        title: 'Auditoria SEO',
        copy: 'Porta de diagnostico quando a empresa ainda nao sabe se o problema principal esta em tecnica, arquitetura ou citabilidade.',
        path: '/servicos/auditoria-seo/'
      },
      {
        title: 'AI Overview Optimization',
        copy: 'Servico canonico que transforma a especializacao em AI Overviews em proposta comercial clara para empresas que precisam aparecer na nova camada da SERP.',
        path: '/servicos/ai-overview-optimization/'
      },
      {
        title: 'Sao Paulo',
        copy: 'Contexto geografico que hoje valida a tese vencedora da home e ajuda a sustentar a leitura comercial da capital sem criar competencia estrutural desnecessaria.',
        path: '/cidades/sao-paulo/'
      },
      {
        title: 'Barueri e Alphaville',
        copy: 'Primeira expansao local adjacente para Grande Sao Paulo, com cluster proprio de agencia, consultoria, auditoria e apoio BOFU.',
        path: '/servicos/agencia-de-seo-em-barueri/'
      },
      {
        title: 'Metodologia',
        copy: 'Camada de prova para quem ja esta avaliando empresa de SEO, especialista ou operacao mais estruturada antes da proposta.',
        path: '/metodologia/'
      }
    ]}
  />
  <AgencySeoSchemas />
  <LegacyContentEnhancements />
</InstitutionalLayout>
