---
import '../../styles/institutional-trust-pages.css';
import CityLayout from '../../layouts/CityLayout.astro';

const cityCards = [
  {
    title: 'São Paulo',
    copy:
      'Página local focada em empresas que disputam descoberta orgânica, AI Overviews, SEO local e arquitetura comercial em um mercado altamente competitivo.',
    href: '/cidades/sao-paulo/'
  },
  {
    title: 'Barueri',
    copy:
      'Página local orientada para demanda empresarial em Barueri, com leitura comercial específica do eixo de Alphaville e foco em serviços de SEO de alta intenção.',
    href: '/cidades/barueri/'
  },
  {
    title: 'Campinas',
    copy:
      'Página local orientada para negócios que precisam combinar autoridade regional, descoberta local e páginas comerciais com intenção clara.',
    href: '/cidades/campinas/'
  },
  {
    title: 'Rio de Janeiro',
    copy:
      'Página local focada em descoberta orgânica, Google Maps e páginas comerciais para uma das principais praças urbanas do país.',
    href: '/cidades/rio-de-janeiro/'
  },
  {
    title: 'Belo Horizonte',
    copy:
      'Página local orientada para empresas que precisam conectar contexto regional, busca local e estrutura comercial em uma capital estratégica.',
    href: '/cidades/belo-horizonte/'
  },
  {
    title: 'Curitiba',
    copy:
      'Página local voltada à descoberta regional, Google Maps e páginas comerciais para uma das principais praças do Sul.',
    href: '/cidades/curitiba/'
  },
  {
    title: 'Brasília',
    copy:
      'Página local orientada a empresas que precisam conectar contexto urbano, busca local e estrutura comercial no Distrito Federal.',
    href: '/cidades/brasilia/'
  },
  {
    title: 'Porto Alegre',
    copy:
      'Página local orientada para empresas que precisam combinar descoberta urbana, Google Maps e páginas comerciais em uma capital estratégica do Sul.',
    href: '/cidades/porto-alegre/'
  }
];

const faqs = [
  {
    question: 'Qual a diferença entre página de cidade e página de nicho?',
    answer:
      'A página de cidade organiza o contexto geográfico e local. A página de nicho organiza o contexto setorial. A landing page combina os dois quando há demanda real.'
  },
  {
    question: 'Toda cidade merece uma página própria?',
    answer:
      'Não. A AUDITSEO só materializa cidade quando existe cobertura comercial, intenção local e possibilidade de prova ou adaptação de mensagem.'
  },
  {
    question: 'Páginas locais servem só para SEO local?',
    answer:
      'Não. Elas também ajudam em descoberta orgânica, reforço de autoridade regional e conexão com landings mais específicas.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
};
---
<CityLayout
  title="Cidades Atendidas pela AUDITSEO"
  description="Páginas locais da AUDITSEO para organizar descoberta regional, mensagem comercial e conexão entre serviços, nichos e landing pages."
  canonicalPath="/cidades/"
  breadcrumbs={[
    { label: 'Home', path: '/' },
    { label: 'Cidades', path: '/cidades/' }
  ]}
>
  <div class="ee-page">
    <nav class="ee-page-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>›</span>
      <span class="current">Cidades</span>
    </nav>

    <section class="ee-page-hero">
      <div>
        <span class="ee-page-badge">Cobertura Local</span>
        <h1 class="ee-page-title">
          CIDADES COM <span class="accent">CONTEXTO</span>, SERVIÇO E INTENÇÃO REAL
        </h1>
        <p class="ee-page-subtitle">
          As páginas locais da AUDITSEO existem para traduzir a estratégia em um contexto
          geográfico específico, sem cair em páginas vazias. Cada cidade precisa sustentar
          <strong> demanda</strong>, <strong>mensagem local</strong> e
          <strong> conexão comercial clara</strong>.
        </p>
        <div class="ee-page-highlights">
          <span class="ee-page-highlight">SEO Local</span>
          <span class="ee-page-highlight">Descoberta Regional</span>
          <span class="ee-page-highlight">Clusters Comerciais</span>
          <span class="ee-page-highlight">Sem Página Inflada</span>
        </div>
      </div>

      <aside class="ee-page-hero-card">
        <h2>Como essa camada se encaixa</h2>
        <p>
          Cidade conecta o bloco institucional aos serviços, aos nichos e às landings de alta
          conversão quando existe combinação comercial válida.
        </p>
        <div class="ee-page-links">
          <a href="/servicos/">Ver serviços</a>
          <a href="/nichos/">Ver nichos</a>
          <a href="/contato/">Solicitar diagnóstico</a>
        </div>
      </aside>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Cobertura atual</span>
        <h2 class="ee-page-section-title">CIDADES JÁ ATIVAS NA NOVA ARQUITETURA</h2>
      </div>
      <div class="ee-page-panels">
        {cityCards.map((item) => (
          <article class="ee-page-panel">
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
            <div class="ee-page-links">
              <a href={item.href}>Abrir página</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Regra editorial</span>
        <h2 class="ee-page-section-title">QUANDO UMA NOVA CIDADE ENTRA</h2>
      </div>
      <div class="ee-page-grid three">
        <article class="ee-page-card">
          <h3>Demanda comercial</h3>
          <p>Sem busca, lead ou proposta real, a cidade não entra na estrutura pública.</p>
        </article>
        <article class="ee-page-card">
          <h3>Diferenciação local</h3>
          <p>Precisa existir algo de linguagem, prova ou contexto que não caiba em uma página genérica.</p>
        </article>
        <article class="ee-page-card">
          <h3>Conexão com serviço</h3>
          <p>A cidade precisa reforçar serviços e landings, não competir com a Home ou com o blog.</p>
        </article>
      </div>
    </section>

    <section class="ee-page-section ee-page-faq">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">FAQ</span>
        <h2 class="ee-page-section-title">DÚVIDAS COMUNS SOBRE PÁGINAS LOCAIS</h2>
      </div>
      <div class="ee-page-faqs">
        {faqs.map((item) => (
          <article class="ee-page-faq">
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </article>
        ))}
      </div>
    </section>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</CityLayout>
