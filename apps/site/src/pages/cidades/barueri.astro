---
import '../../styles/institutional-trust-pages.css';
import CityLayout from '../../layouts/CityLayout.astro';

const focusAreas = [
  {
    title: 'Agencia de SEO em Barueri sem inflar a arquitetura',
    copy:
      'Barueri entra como ancora estrutural segura para capturar buscas como agencia de SEO em Barueri e empresa de SEO em Barueri sem abrir uma URL para cada sinonimo.'
  },
  {
    title: 'Alphaville como contexto para consultoria, consultor e especialista SEO',
    copy:
      'O Centro Comercial de Alphaville entra como modificador comercial forte para buscas por consultoria SEO, consultor SEO e especialista em SEO dentro da mesma praca.'
  },
  {
    title: 'Empresa de SEO com expansao controlada',
    copy:
      'A frente local so deve ganhar novas derivacoes quando a pagina principal, os servicos, o BOFU e o tracking mostrarem aderencia real.'
  }
];

const faqs = [
  {
    question: 'Por que Barueri merece uma pagina local propria?',
    answer:
      'Porque a cidade funciona como ancora estrutural segura para uma praca empresarial forte que inclui o eixo de Alphaville, sem depender de paginas repetidas por variacao semantica.'
  },
  {
    question: 'Alphaville entra como pagina separada?',
    answer:
      'Nao nesta fase. Alphaville entra forte como contexto comercial, copy, FAQs, links internos e leitura de mercado dentro da mesma praca ancorada em Barueri.'
  },
  {
    question: 'Quem procura empresa de SEO em Alphaville ou consultor SEO em Barueri deveria começar por onde?',
    answer:
      'Na mesma malha local. A pagina money de agencia organiza a intencao generica de contratacao e as paginas de consultoria e auditoria filtram etapas mais especificas da decisao.'
  },
  {
    question: 'Empresa de SEO em Alphaville precisa de URL propria?',
    answer:
      'Nao. A intencao mais generica fica concentrada na pagina principal de Barueri, enquanto Alphaville ganha peso na copy, nos FAQs, no BOFU e na prova local.'
  },
  {
    question: 'A AUDITSEO recebe clientes presencialmente em Alphaville?',
    answer:
      'Nao como storefront aberto. O atendimento e remoto e reunioes presenciais so acontecem sob agendamento quando fizer sentido para a operacao.'
  },
  {
    question: 'Especialista em SEO e consultoria SEO viram paginas separadas em Alphaville?',
    answer:
      'Nao. Essas variacoes entram na copy, FAQ, links internos e artigos de apoio do mesmo cluster local para evitar canibalizacao e inflacao de URLs.'
  },
  {
    question: 'Quais frentes fazem mais sentido primeiro?',
    answer:
      'Agencia de SEO como pagina money local, seguida por consultoria SEO e auditoria SEO como portas tecnicas complementares.'
  }
];

const decisionLinks = [
  {
    title: 'Agencia de SEO em Barueri e Alphaville',
    copy: 'Pagina money local para buscas genericas de contratacao, agencia de SEO e empresa de SEO na praca.',
    path: '/servicos/agencia-de-seo-em-barueri/'
  },
  {
    title: 'Consultoria SEO em Barueri e Alphaville',
    copy: 'Entrada para operacoes que ja procuram consultor SEO, especialista SEO, backlog e governanca.',
    path: '/servicos/consultoria-seo-em-barueri/'
  },
  {
    title: 'Auditoria SEO em Barueri e Alphaville',
    copy: 'Porta tecnica para diagnostico quando o gargalo ainda nao esta claro.',
    path: '/servicos/auditoria-seo-em-barueri/'
  }
];

const bofuLinks = [
  {
    title: 'Como escolher agencia de SEO em Barueri e Alphaville',
    copy: 'Reduz comparacao rasa entre agencia generalista, especialista e operacao focada em SEO.',
    path: '/blog/agencia-seo-para-empresas-em-barueri-como-escolher/'
  },
  {
    title: 'Quanto custa SEO em Barueri e Alphaville',
    copy: 'Ajuda a calibrar escopo, preco e maturidade da operacao local.',
    path: '/blog/quanto-custa-seo-em-barueri-e-alphaville/'
  },
  {
    title: 'Em quanto tempo SEO gera resultado em Barueri e Alphaville',
    copy: 'Ajusta expectativa de prazo e evita leitura errada da praca.',
    path: '/blog/em-quanto-tempo-seo-gera-resultado-em-barueri-e-alphaville/'
  },
  {
    title: 'Agencia SEO ou consultoria SEO em Barueri e Alphaville',
    copy: 'Compara os modelos de contratacao mais proximos da decisao comercial local.',
    path: '/blog/agencia-seo-ou-consultoria-seo-em-barueri-e-alphaville/'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
};
---
<CityLayout
  title="SEO em Barueri e Alphaville | Hub Comercial da AUDITSEO"
  description="Hub comercial da AUDITSEO para Barueri e Alphaville com agencia de SEO, consultoria SEO, auditoria SEO e conteudos BOFU para decisao na praca."
  canonicalPath="/cidades/barueri/"
  breadcrumbs={[
    { label: 'Home', path: '/' },
    { label: 'Cidades', path: '/cidades/' },
    { label: 'Barueri', path: '/cidades/barueri/' }
  ]}
>
  <div class="ee-page">
    <nav class="ee-page-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>›</span>
      <a href="/cidades/">Cidades</a>
      <span>›</span>
      <span class="current">Barueri</span>
    </nav>

    <section class="ee-page-hero">
      <div>
        <span class="ee-page-badge">Cobertura em Barueri e Alphaville</span>
        <h1 class="ee-page-title">
          AGENCIA DE SEO EM <span class="accent">BARUERI</span> COM HUB COMERCIAL PARA ALPHAVILLE
        </h1>
        <p class="ee-page-subtitle">
          Em Barueri, a estrutura local precisa conectar <strong>cidade</strong>,
          <strong>eixo comercial</strong> e <strong>demanda de contratacao</strong> sem cair em
          paginas vazias. Alphaville entra aqui como contexto real para buscas por
          <strong> empresa de SEO</strong>, <strong>consultoria SEO</strong> e
          <strong> especialista em SEO</strong>, nao como inflacao de URL.
        </p>
        <div class="ee-page-highlights">
          <span class="ee-page-highlight">Barueri</span>
          <span class="ee-page-highlight">Alphaville</span>
          <span class="ee-page-highlight">Agencia de SEO</span>
          <span class="ee-page-highlight">Empresa de SEO</span>
          <span class="ee-page-highlight">Consultoria SEO</span>
        </div>
      </div>

      <aside class="ee-page-hero-card">
        <h2>Entradas mais aderentes</h2>
        <p>
          Em Barueri e Alphaville, a frente local mais forte comeca com a pagina money de agencia,
          apoiada por consultoria e auditoria como portas complementares. O atendimento e remoto e
          reunioes presenciais acontecem somente sob agendamento quando necessario.
        </p>
        <div class="ee-page-links">
          <a href="/servicos/agencia-de-seo-em-barueri/">Ver agencia de SEO</a>
          <a href="/servicos/consultoria-seo-em-barueri/">Ver consultoria SEO</a>
          <a href="/servicos/auditoria-seo-em-barueri/">Ver auditoria SEO</a>
        </div>
      </aside>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Prioridades</span>
        <h2 class="ee-page-section-title">O QUE MAIS PESA NESTA PRACA</h2>
      </div>
      <div class="ee-page-grid three">
        {focusAreas.map((item) => (
          <article class="ee-page-card">
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Entradas por intencao</span>
        <h2 class="ee-page-section-title">COMO A PRACA SE DIVIDE SEM ABRIR URL DESNECESSARIA</h2>
      </div>
      <div class="ee-page-grid three">
        {decisionLinks.map((item) => (
          <article class="ee-page-card">
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
            <div class="ee-page-links">
              <a href={item.path}>Abrir pagina</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">BOFU local</span>
        <h2 class="ee-page-section-title">RECURSOS DE DECISAO PARA BARUERI E ALPHAVILLE</h2>
      </div>
      <div class="ee-page-grid three">
        {bofuLinks.map((item) => (
          <article class="ee-page-card">
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
            <div class="ee-page-links">
              <a href={item.path}>Abrir artigo</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-cta">
      <div class="ee-page-cta-box">
        <span class="ee-page-section-badge">Proximo passo</span>
        <h2 class="ee-page-section-title">QUER TESTAR UMA OPERACAO LOCAL FORTE EM BARUERI E ALPHAVILLE?</h2>
        <p class="ee-page-cta-copy">
          Se a praca ja participa da geracao de demanda, o melhor inicio e um diagnostico que ligue
          cidade, pagina principal, servicos complementares, medicao local e criterio de proposta.
        </p>
        <div class="ee-page-cta-actions">
          <button class="ee-page-primary" type="button" data-open-cta-modal>Solicitar diagnostico da praca</button>
          <a class="ee-page-secondary" href="/servicos/agencia-de-seo-em-barueri/">Ver pagina principal</a>
        </div>
      </div>
    </section>

    <section class="ee-page-section ee-page-faq">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">FAQ</span>
        <h2 class="ee-page-section-title">DUVIDAS COMUNS SOBRE A FRENTE EM BARUERI</h2>
      </div>
      <div class="ee-page-faqs">
        {faqs.map((item) => (
          <article class="ee-page-faq">
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </article>
        ))}
      </div>
    </section>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</CityLayout>
