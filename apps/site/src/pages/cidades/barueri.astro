---
import '../../styles/institutional-trust-pages.css';
import CityLayout from '../../layouts/CityLayout.astro';

const focusAreas = [
  {
    title: 'Agência de SEO em Barueri sem inflar a arquitetura',
    copy:
      'Barueri entra como âncora estrutural segura para capturar buscas como agência de SEO em Barueri e empresa de SEO em Barueri sem abrir uma URL para cada sinônimo.'
  },
  {
    title: 'Alphaville como contexto para consultoria, consultor e especialista SEO',
    copy:
      'O Centro Comercial de Alphaville entra como modificador comercial forte para buscas por consultoria SEO, consultor SEO e especialista em SEO dentro da mesma praça.'
  },
  {
    title: 'Empresa de SEO com expansão controlada',
    copy:
      'A frente local só deve ganhar novas derivações quando a página principal, os serviços, o BOFU e o tracking mostrarem aderência real.'
  }
];

const faqs = [
  {
    question: 'Por que Barueri merece uma página local própria?',
    answer:
      'Porque a cidade funciona como âncora estrutural segura para uma praça empresarial forte que inclui o eixo de Alphaville, sem depender de páginas repetidas por variação semântica.'
  },
  {
    question: 'Alphaville entra como página separada?',
    answer:
      'Não nesta fase. Alphaville entra forte como contexto comercial, copy, FAQs, links internos e leitura de mercado dentro da mesma praça ancorada em Barueri.'
  },
  {
    question: 'Quem procura empresa de SEO em Alphaville ou consultor SEO em Barueri deveria começar por onde?',
    answer:
      'Na mesma malha local. A página money de agência organiza a intenção genérica de contratação e as páginas de consultoria e auditoria filtram etapas mais específicas da decisão.'
  },
  {
    question: 'Empresa de SEO em Alphaville precisa de URL própria?',
    answer:
      'Não. A intenção mais genérica fica concentrada na página principal de Barueri, enquanto Alphaville ganha peso na copy, nos FAQs, no BOFU e na prova local.'
  },
  {
    question: 'A AUDITSEO recebe clientes presencialmente em Alphaville?',
    answer:
      'Não como storefront aberto. O atendimento é remoto e reuniões presenciais só acontecem sob agendamento quando fizer sentido para a operação.'
  },
  {
    question: 'Especialista em SEO e consultoria SEO viram páginas separadas em Alphaville?',
    answer:
      'Não. Essas variações entram na copy, FAQ, links internos e artigos de apoio do mesmo cluster local para evitar canibalização e inflação de URLs.'
  },
  {
    question: 'Quais frentes fazem mais sentido primeiro?',
    answer:
      'Agência de SEO como página money local, seguida por consultoria SEO e auditoria SEO como portas técnicas complementares.'
  }
];

const decisionLinks = [
  {
    title: 'Agência de SEO em Barueri e Alphaville',
    copy: 'Página money local para buscas genéricas de contratação, agência de SEO e empresa de SEO na praça.',
    path: '/servicos/agencia-de-seo-em-barueri/'
  },
  {
    title: 'Consultoria SEO em Barueri e Alphaville',
    copy: 'Entrada para operações que já procuram consultor SEO, especialista SEO, backlog e governança.',
    path: '/servicos/consultoria-seo-em-barueri/'
  },
  {
    title: 'Auditoria SEO em Barueri e Alphaville',
    copy: 'Porta técnica para diagnóstico quando o gargalo ainda não está claro.',
    path: '/servicos/auditoria-seo-em-barueri/'
  }
];

const bofuLinks = [
  {
    title: 'Como escolher agência de SEO em Barueri e Alphaville',
    copy: 'Reduz comparação rasa entre agência generalista, especialista e operação focada em SEO.',
    path: '/blog/agencia-seo-para-empresas-em-barueri-como-escolher/'
  },
  {
    title: 'Quanto custa SEO em Barueri e Alphaville',
    copy: 'Ajuda a calibrar escopo, preço e maturidade da operação local.',
    path: '/blog/quanto-custa-seo-em-barueri-e-alphaville/'
  },
  {
    title: 'Em quanto tempo SEO gera resultado em Barueri e Alphaville',
    copy: 'Ajusta expectativa de prazo e evita leitura errada da praça.',
    path: '/blog/em-quanto-tempo-seo-gera-resultado-em-barueri-e-alphaville/'
  },
  {
    title: 'Agência SEO ou consultoria SEO em Barueri e Alphaville',
    copy: 'Compara os modelos de contratação mais próximos da decisão comercial local.',
    path: '/blog/agencia-seo-ou-consultoria-seo-em-barueri-e-alphaville/'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
};
---
<CityLayout
  title="SEO em Barueri e Alphaville | Hub Comercial da AUDITSEO"
  description="Hub comercial da AUDITSEO para Barueri e Alphaville com agência de SEO, consultoria SEO, auditoria SEO e conteúdos BOFU para decisão na praça."
  canonicalPath="/cidades/barueri/"
  breadcrumbs={[
    { label: 'Home', path: '/' },
    { label: 'Cidades', path: '/cidades/' },
    { label: 'Barueri', path: '/cidades/barueri/' }
  ]}
>
  <div class="ee-page">
    <nav class="ee-page-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>›</span>
      <a href="/cidades/">Cidades</a>
      <span>›</span>
      <span class="current">Barueri</span>
    </nav>

    <section class="ee-page-hero">
      <div>
        <span class="ee-page-badge">Cobertura em Barueri e Alphaville</span>
        <h1 class="ee-page-title">
          AGÊNCIA DE SEO EM <span class="accent">BARUERI</span> COM HUB COMERCIAL PARA ALPHAVILLE
        </h1>
        <p class="ee-page-subtitle">
          Em Barueri, a estrutura local precisa conectar <strong>cidade</strong>,
          <strong>eixo comercial</strong> e <strong>demanda de contratação</strong> sem cair em
          páginas vazias. Alphaville entra aqui como contexto real para buscas por
          <strong> empresa de SEO</strong>, <strong>consultoria SEO</strong> e
          <strong> especialista em SEO</strong>, não como inflação de URL.
        </p>
        <div class="ee-page-highlights">
          <span class="ee-page-highlight">Barueri</span>
          <span class="ee-page-highlight">Alphaville</span>
          <span class="ee-page-highlight">Agência de SEO</span>
          <span class="ee-page-highlight">Empresa de SEO</span>
          <span class="ee-page-highlight">Consultoria SEO</span>
        </div>
      </div>

      <aside class="ee-page-hero-card">
        <h2>Entradas mais aderentes</h2>
        <p>
          Em Barueri e Alphaville, a frente local mais forte começa com a página money de agência,
          apoiada por consultoria e auditoria como portas complementares. O atendimento é remoto e
          reuniões presenciais acontecem somente sob agendamento quando necessário.
        </p>
        <div class="ee-page-links">
          <a href="/servicos/agencia-de-seo-em-barueri/">Ver agência de SEO</a>
          <a href="/servicos/consultoria-seo-em-barueri/">Ver consultoria SEO</a>
          <a href="/servicos/auditoria-seo-em-barueri/">Ver auditoria SEO</a>
        </div>
      </aside>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Prioridades</span>
        <h2 class="ee-page-section-title">O QUE MAIS PESA NESTA PRAÇA</h2>
      </div>
      <div class="ee-page-grid three">
        {focusAreas.map((item) => (
          <article class="ee-page-card">
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Entradas por intenção</span>
        <h2 class="ee-page-section-title">COMO A PRAÇA SE DIVIDE SEM ABRIR URL DESNECESSÁRIA</h2>
      </div>
      <div class="ee-page-grid three">
        {decisionLinks.map((item) => (
          <article class="ee-page-card">
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
            <div class="ee-page-links">
              <a href={item.path}>Abrir página</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">BOFU local</span>
        <h2 class="ee-page-section-title">RECURSOS DE DECISÃO PARA BARUERI E ALPHAVILLE</h2>
      </div>
      <div class="ee-page-grid three">
        {bofuLinks.map((item) => (
          <article class="ee-page-card">
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
            <div class="ee-page-links">
              <a href={item.path}>Abrir artigo</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-cta">
      <div class="ee-page-cta-box">
        <span class="ee-page-section-badge">Próximo passo</span>
        <h2 class="ee-page-section-title">QUER TESTAR UMA OPERAÇÃO LOCAL FORTE EM BARUERI E ALPHAVILLE?</h2>
        <p class="ee-page-cta-copy">
          Se a praça já participa da geração de demanda, o melhor início é um diagnóstico que ligue
          cidade, página principal, serviços complementares, medição local e critério de proposta.
        </p>
        <div class="ee-page-cta-actions">
          <button class="ee-page-primary" type="button" data-open-cta-modal>Solicitar diagnóstico da praça</button>
          <a class="ee-page-secondary" href="/servicos/agencia-de-seo-em-barueri/">Ver página principal</a>
        </div>
      </div>
    </section>

    <section class="ee-page-section ee-page-faq">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">FAQ</span>
        <h2 class="ee-page-section-title">DÚVIDAS COMUNS SOBRE A FRENTE EM BARUERI</h2>
      </div>
      <div class="ee-page-faqs">
        {faqs.map((item) => (
          <article class="ee-page-faq">
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </article>
        ))}
      </div>
    </section>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</CityLayout>
