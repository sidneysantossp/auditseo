---
import '../../styles/institutional-trust-pages.css';
import CityLayout from '../../layouts/CityLayout.astro';

const serviceBlocks = [
  {
    title: 'AI Overview Optimization',
    copy:
      'Para empresas que disputam atenção nas respostas de IA do Google e precisam de páginas mais citáveis e mais claras.'
  },
  {
    title: 'SEO Local e GBP',
    copy:
      'Essencial para negócios com ponto físico, área de cobertura ou decisão comercial fortemente ancorada em localização.'
  },
  {
    title: 'Consultoria e Auditoria SEO',
    copy:
      'Entrada mais segura quando o problema é estrutura, canibalização, performance ou desalinhamento entre conteúdo e negócio.'
  }
];

const localSignals = [
  'Mensagem comercial calibrada para um mercado mais competitivo',
  'Conexão entre página local, serviço principal e contato',
  'Reforço de descoberta orgânica e local sem duplicar discurso da Home',
  'Espaço para landings válidas por nicho quando houver intenção real'
];

const faqs = [
  {
    question: 'Por que São Paulo merece uma página local própria?',
    answer:
      'Porque o volume, a concorrência e a diversidade de intenções fazem a mensagem local exigir mais clareza do que uma página nacional comporta.'
  },
  {
    question: 'Essa página substitui landing pages por nicho em São Paulo?',
    answer:
      'Não. Ela organiza o contexto local. As landings entram quando há combinação válida entre serviço, nicho e cidade.'
  },
  {
    question: 'Qual é a melhor entrada comercial para São Paulo hoje?',
    answer:
      'Depende do objetivo, mas AI Overview Optimization, SEO Local e Consultoria SEO costumam ser os blocos iniciais mais fortes.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
};
---
<CityLayout
  title="AUDITSEO em São Paulo | SEO, IA e Estrutura Comercial"
  description="Página local da AUDITSEO para São Paulo: SEO, IA, descoberta regional, AI Overviews e estrutura comercial para empresas em um mercado altamente competitivo."
  canonicalPath="/cidades/sao-paulo/"
  breadcrumbs={[
    { label: 'Home', path: '/' },
    { label: 'Cidades', path: '/cidades/' },
    { label: 'São Paulo', path: '/cidades/sao-paulo/' }
  ]}
>
  <div class="ee-page">
    <nav class="ee-page-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>›</span>
      <a href="/cidades/">Cidades</a>
      <span>›</span>
      <span class="current">São Paulo</span>
    </nav>

    <section class="ee-page-hero">
      <div>
        <span class="ee-page-badge">Cobertura em São Paulo</span>
        <h1 class="ee-page-title">
          SEO E IA EM <span class="accent">SÃO PAULO</span> COM FOCO EM ESTRUTURA E CONVERSÃO
        </h1>
        <p class="ee-page-subtitle">
          Em São Paulo, a disputa não é só por ranking. É por
          <strong> clareza comercial</strong>, <strong>autoridade</strong>,
          <strong> rastreabilidade</strong> e <strong>descoberta consistente</strong> em um mercado
          com mais oferta, mais ruído e mais competição.
        </p>
        <div class="ee-page-highlights">
          <span class="ee-page-highlight">Mercado Competitivo</span>
          <span class="ee-page-highlight">SEO + IA</span>
          <span class="ee-page-highlight">Descoberta Local</span>
          <span class="ee-page-highlight">Páginas Comerciais</span>
        </div>
      </div>

      <aside class="ee-page-hero-card">
        <h2>Entrada recomendada em São Paulo</h2>
        <p>
          Quando a empresa precisa disputar visibilidade em um mercado mais denso, a prioridade
          costuma ser alinhar agência, consultoria, auditoria e AI Overviews dentro da mesma
          arquitetura comercial.
        </p>
        <div class="ee-page-links">
          <a href="/agencia-de-seo/">Ver agência de SEO</a>
          <a href="/servicos/consultoria-seo/">Ver consultoria SEO</a>
          <a href="/servicos/auditoria-seo/">Ver auditoria SEO</a>
          <a href="/servicos/ai-overview-optimization/">Ver AI Overview Optimization</a>
        </div>
      </aside>
    </section>

    <section class="ee-page-stats" aria-label="Resumo local de São Paulo">
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">1</div>
        <div class="ee-page-stat-label">Mercado prioritário</div>
        <p class="ee-page-stat-copy">Cidade-chave para validar combinações de página, nicho e serviço.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">3</div>
        <div class="ee-page-stat-label">Entradas mais fortes</div>
        <p class="ee-page-stat-copy">Consultoria, AI Overview Optimization e SEO Local.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">0</div>
        <div class="ee-page-stat-label">Espaço para página genérica</div>
        <p class="ee-page-stat-copy">Aqui a mensagem precisa ser cirúrgica, não ampla demais.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">1</div>
        <div class="ee-page-stat-label">Objetivo</div>
        <p class="ee-page-stat-copy">Conectar descoberta qualificada a diagnóstico e contato.</p>
      </article>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Serviços mais aderentes</span>
        <h2 class="ee-page-section-title">O QUE COSTUMA FAZER MAIS SENTIDO EM SÃO PAULO</h2>
      </div>
      <div class="ee-page-grid three">
        {serviceBlocks.map((item) => (
          <article class="ee-page-card">
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Leitura local</span>
        <h2 class="ee-page-section-title">SINAIS QUE JUSTIFICAM UMA PÁGINA LOCAL EM SÃO PAULO</h2>
      </div>
      <div class="ee-page-panels">
        <article class="ee-page-panel">
          <h3>O que a página local organiza</h3>
          <ul class="ee-page-list">
            {localSignals.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
        <article class="ee-page-panel">
          <h3>Próximo passo comercial</h3>
          <p>
            Se sua empresa opera em São Paulo e precisa validar combinação entre IA, serviço e
            descoberta local, a próxima camada natural é escolher a porta correta entre agência,
            consultoria, auditoria e AI Overview Optimization.
          </p>
          <div class="ee-page-links">
            <a href="/blog/agencia-seo-para-ai-overviews-como-escolher/">Como escolher agência para AI Overviews</a>
            <a href="/blog/agencia-seo-ou-consultoria-seo-para-ai-overviews/">Agência ou consultoria para AI Overviews?</a>
            <a href="/contato/">Solicitar diagnóstico</a>
          </div>
        </article>
      </div>
    </section>

    <section class="ee-page-section ee-page-faq">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">FAQ</span>
        <h2 class="ee-page-section-title">DÚVIDAS COMUNS SOBRE A FRENTE EM SÃO PAULO</h2>
      </div>
      <div class="ee-page-faqs">
        {faqs.map((item) => (
          <article class="ee-page-faq">
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </article>
        ))}
      </div>
    </section>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</CityLayout>
