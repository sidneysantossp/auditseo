---
import '../../styles/institutional-trust-pages.css';
import CityLayout from '../../layouts/CityLayout.astro';

const focusAreas = [
  {
    title: 'Descoberta local com clareza',
    copy:
      'No Rio de Janeiro, a mensagem local precisa explicar serviço, contexto urbano e próximo passo sem depender de texto genérico.'
  },
  {
    title: 'Maps + página comercial',
    copy:
      'A cidade responde melhor quando perfil local, página comercial e contexto geográfico operam na mesma direção.'
  },
  {
    title: 'Escala com disciplina',
    copy:
      'Rio entra como praça forte da expansão nacional e precisa de uma base local clara antes de qualquer derivação adicional.'
  }
];

const faqs = [
  {
    question: 'Por que o Rio de Janeiro merece uma página local própria?',
    answer:
      'Porque é uma das principais praças urbanas e econômicas do país, com contexto local forte para descoberta orgânica, busca por proximidade e decisão comercial.'
  },
  {
    question: 'Essa página substitui páginas de serviço no Rio?',
    answer:
      'Não. Ela organiza o contexto geográfico. As páginas de serviço traduzem a oferta para a intenção comercial dentro da cidade.'
  },
  {
    question: 'Quais frentes costumam entrar primeiro no Rio?',
    answer:
      'SEO Local, Google Meu Negócio e páginas comerciais service-first costumam ser as entradas mais fortes nessa fase.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
};
---
<CityLayout
  title="AUDITSEO no Rio de Janeiro | SEO Local, IA e Estrutura Comercial"
  description="Página local da AUDITSEO para o Rio de Janeiro: SEO local, Google Maps, descoberta regional e estrutura comercial para empresas que querem ganhar visibilidade qualificada."
  canonicalPath="/cidades/rio-de-janeiro/"
  breadcrumbs={[
    { label: 'Home', path: '/' },
    { label: 'Cidades', path: '/cidades/' },
    { label: 'Rio de Janeiro', path: '/cidades/rio-de-janeiro/' }
  ]}
>
  <div class="ee-page">
    <nav class="ee-page-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>›</span>
      <a href="/cidades/">Cidades</a>
      <span>›</span>
      <span class="current">Rio de Janeiro</span>
    </nav>

    <section class="ee-page-hero">
      <div>
        <span class="ee-page-badge">Cobertura no Rio de Janeiro</span>
        <h1 class="ee-page-title">
          SEO E IA NO <span class="accent">RIO DE JANEIRO</span> COM FOCO EM DESCOBERTA LOCAL
        </h1>
        <p class="ee-page-subtitle">
          No Rio de Janeiro, a página local precisa equilibrar
          <strong> geografia</strong>, <strong>mensagem comercial</strong> e
          <strong> descoberta qualificada</strong>, sem virar uma cópia da capital paulista.
        </p>
        <div class="ee-page-highlights">
          <span class="ee-page-highlight">Busca Local</span>
          <span class="ee-page-highlight">Google Maps</span>
          <span class="ee-page-highlight">Páginas Comerciais</span>
          <span class="ee-page-highlight">Conversão Qualificada</span>
        </div>
      </div>

      <aside class="ee-page-hero-card">
        <h2>Entradas mais aderentes</h2>
        <p>
          Nesta praça, a combinação mais forte tende a passar por SEO Local, GBP e páginas comerciais
          que expliquem melhor o contexto da cidade.
        </p>
        <div class="ee-page-links">
          <a href="/servicos/seo-local-para-clinicas-medicas-em-rio-de-janeiro/">Ver SEO local para clínicas</a>
          <a href="/servicos/google-meu-negocio-para-clinicas-medicas-em-rio-de-janeiro/">Ver GBP para clínicas</a>
          <a href="/contato/">Solicitar diagnóstico</a>
        </div>
      </aside>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Prioridades</span>
        <h2 class="ee-page-section-title">O QUE COSTUMA PESAR MAIS NO RIO</h2>
      </div>
      <div class="ee-page-grid three">
        {focusAreas.map((item) => (
          <article class="ee-page-card">
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-cta">
      <div class="ee-page-cta-box">
        <span class="ee-page-section-badge">Próximo passo</span>
        <h2 class="ee-page-section-title">QUER TESTAR UMA ESTRUTURA LOCAL NO RIO DE JANEIRO?</h2>
        <p class="ee-page-cta-copy">
          Se a empresa depende da cidade para gerar demanda, o melhor início é um diagnóstico que
          conecte geografia, página comercial e descoberta local.
        </p>
        <div class="ee-page-cta-actions">
          <button class="ee-page-primary" type="button" data-open-cta-modal>Solicitar diagnóstico</button>
          <a class="ee-page-secondary" href="/servicos/seo-local/">Ver SEO Local</a>
        </div>
      </div>
    </section>

    <section class="ee-page-section ee-page-faq">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">FAQ</span>
        <h2 class="ee-page-section-title">DÚVIDAS COMUNS SOBRE A FRENTE NO RIO</h2>
      </div>
      <div class="ee-page-faqs">
        {faqs.map((item) => (
          <article class="ee-page-faq">
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </article>
        ))}
      </div>
    </section>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</CityLayout>
