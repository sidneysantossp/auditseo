---
import '../../styles/institutional-trust-pages.css';
import InstitutionalLayout from '../../layouts/InstitutionalLayout.astro';

const focusBlocks = [
  {
    title: 'Descoberta médica e contexto',
    copy:
      'Clínicas precisam ser entendidas por especialidade, unidade, sinais de confiança e proximidade. Sem contexto, a busca não fecha contato.'
  },
  {
    title: 'Estrutura de página e jornada',
    copy:
      'O paciente compara opções por especialidade, mapa, conveniência e clareza da página. O setor exige uma leitura comercial mais precisa.'
  },
  {
    title: 'Base para páginas comerciais',
    copy:
      'Este hub setorial existe para apoiar as páginas comerciais da AUDITSEO, e não para disputar a mesma intenção de contratação.'
  }
];

const journeyCards = [
  'Mapeamento de especialidades, sintomas e perguntas de decisão',
  'Conexão entre SEO local, páginas comerciais e Google Maps',
  'FAQs de confiança, atendimento e critérios de escolha',
  'Base setorial para escalar páginas por cidade sem doorway pages'
];

const faqs = [
  {
    question: 'Essa página é a principal URL comercial para clínicas médicas?',
    answer:
      'Não. Ela funciona como hub setorial de apoio. A principal URL comercial da vertical é a página de SEO para clínicas médicas.'
  },
  {
    question: 'Por que manter uma página setorial e uma página comercial separadas?',
    answer:
      'Porque a página setorial organiza contexto, linguagem e aplicação do mercado. A comercial precisa ficar mais concentrada em contratação e diagnóstico.'
  },
  {
    question: 'Quais serviços da AUDITSEO mais se conectam a esse contexto?',
    answer:
      'Principalmente a página comercial de SEO para clínicas médicas, SEO Local e Google Meu Negócio, dependendo da maturidade e do objetivo da clínica.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
};
---
<InstitutionalLayout
  title="AI Search para Clínicas Médicas | AUDITSEO"
  description="Hub setorial da AUDITSEO para clínicas médicas: AI search, descoberta local, contexto editorial e apoio às páginas comerciais da vertical."
  canonicalPath="/nichos/clinicas-medicas/"
  breadcrumbs={[
    { label: 'Home', path: '/' },
    { label: 'Nichos', path: '/nichos/' },
    { label: 'Clínicas Médicas', path: '/nichos/clinicas-medicas/' }
  ]}
>
  <div class="ee-page">
    <nav class="ee-page-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>›</span>
      <a href="/nichos/">Nichos</a>
      <span>›</span>
      <span class="current">Clínicas Médicas</span>
    </nav>

    <section class="ee-page-hero">
      <div>
        <span class="ee-page-badge">Saúde, Estrutura e AI Search</span>
        <h1 class="ee-page-title">
          AI SEARCH PARA <span class="accent">CLÍNICAS MÉDICAS</span> COM ESTRUTURA E CONTEXTO
        </h1>
        <p class="ee-page-subtitle">
          Esta página setorial existe para organizar o contexto de
          <strong> busca, descoberta e autoridade</strong> das clínicas médicas, apoiando as
          páginas comerciais da AUDITSEO sem disputar a intenção principal de contratação do
          serviço.
        </p>
        <div class="ee-page-highlights">
          <span class="ee-page-highlight">AI Search</span>
          <span class="ee-page-highlight">Google Maps</span>
          <span class="ee-page-highlight">Páginas de Especialidade</span>
          <span class="ee-page-highlight">E-E-A-T em Saúde</span>
        </div>
      </div>

      <aside class="ee-page-hero-card">
        <h2>Onde o hub setorial ajuda</h2>
        <p>
          Ele alinha linguagem, provas, FAQs e caminhos de descoberta para clínicas que depois
          precisam avançar para uma página comercial ou local mais específica.
        </p>
        <div class="ee-page-links">
          <a href="/servicos/seo-para-clinicas-medicas/">Ver página comercial</a>
          <a href="/servicos/seo-local/">Ver SEO Local</a>
          <a href="/servicos/google-meu-negocio/">Ver Google Meu Negócio</a>
        </div>
      </aside>
    </section>

    <section class="ee-page-stats" aria-label="Resumo da página setorial de clínicas médicas">
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">1</div>
        <div class="ee-page-stat-label">Hub de apoio</div>
        <p class="ee-page-stat-copy">A função aqui é organizar contexto, não capturar a query comercial principal.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">3</div>
        <div class="ee-page-stat-label">Camadas centrais</div>
        <p class="ee-page-stat-copy">Busca, descoberta local e confiança editorial.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">0</div>
        <div class="ee-page-stat-label">Espaço para ruído</div>
        <p class="ee-page-stat-copy">Sem contexto, a vertical não sustenta páginas comerciais melhores.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">100%</div>
        <div class="ee-page-stat-label">Dependência de contexto</div>
        <p class="ee-page-stat-copy">Em saúde, contexto e credibilidade pesam mais que volume puro.</p>
      </article>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Prioridades</span>
        <h2 class="ee-page-section-title">O QUE ESSE HUB ORGANIZA PARA CLÍNICAS MÉDICAS</h2>
      </div>
      <div class="ee-page-grid three">
        {focusBlocks.map((item) => (
          <article class="ee-page-card">
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Escopo</span>
        <h2 class="ee-page-section-title">COMO ESSE CONTEXTO APOIA A CAMADA COMERCIAL</h2>
      </div>
      <div class="ee-page-panels">
        <article class="ee-page-panel">
          <h3>Frentes de trabalho</h3>
          <ul class="ee-page-list">
            {journeyCards.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
        <article class="ee-page-panel">
          <h3>Próximo passo comercial</h3>
          <p>
            Se a clínica depende de descoberta por especialidade, busca local e sinais de
            confiança, a entrada mais segura agora é a página comercial da vertical ou um
            diagnóstico com foco em arquitetura e rastreabilidade.
          </p>
          <div class="ee-page-links">
            <a href="/servicos/seo-para-clinicas-medicas/">Abrir página comercial</a>
            <a href="/contato/">Solicitar diagnóstico</a>
          </div>
        </article>
      </div>
    </section>

    <section class="ee-page-section ee-page-faq">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">FAQ</span>
        <h2 class="ee-page-section-title">DÚVIDAS COMUNS DE CLÍNICAS MÉDICAS</h2>
      </div>
      <div class="ee-page-faqs">
        {faqs.map((item) => (
          <article class="ee-page-faq">
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </article>
        ))}
      </div>
    </section>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</InstitutionalLayout>
