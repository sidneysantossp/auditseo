---
import '../../styles/institutional-trust-pages.css';
import InstitutionalLayout from '../../layouts/InstitutionalLayout.astro';

const focusBlocks = [
  {
    title: 'Descoberta medica e contexto',
    copy:
      'Clinicas precisam ser entendidas por especialidade, unidade, sinais de confianca e proximidade. Sem contexto, a busca nao fecha contato.'
  },
  {
    title: 'Estrutura de pagina e jornada',
    copy:
      'O paciente compara opcoes por especialidade, mapa, conveniencia e clareza da pagina. O setor exige uma leitura comercial mais precisa.'
  },
  {
    title: 'Base para paginas comerciais',
    copy:
      'Este hub setorial existe para apoiar as paginas comerciais da AUDITSEO, e nao para disputar a mesma intencao de contratacao.'
  }
];

const journeyCards = [
  'Mapeamento de especialidades, sintomas e perguntas de decisao',
  'Conexao entre SEO local, paginas comerciais e Google Maps',
  'FAQs de confianca, atendimento e criterios de escolha',
  'Base setorial para escalar paginas por cidade sem doorway pages'
];

const faqs = [
  {
    question: 'Essa pagina e a principal URL comercial para clinicas medicas?',
    answer:
      'Nao. Ela funciona como hub setorial de apoio. A principal URL comercial da vertical e a pagina de SEO para clinicas medicas.'
  },
  {
    question: 'Por que manter uma pagina setorial e uma pagina comercial separadas?',
    answer:
      'Porque a pagina setorial organiza contexto, linguagem e aplicacao do mercado. A comercial precisa ficar mais concentrada em contratacao e diagnostico.'
  },
  {
    question: 'Quais servicos da AUDITSEO mais se conectam a esse contexto?',
    answer:
      'Principalmente a pagina comercial de SEO para clinicas medicas, SEO Local e Google Meu Negocio, dependendo da maturidade e do objetivo da clinica.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
};
---
<InstitutionalLayout
  title="AI Search para Clinicas Medicas | AUDITSEO"
  description="Hub setorial da AUDITSEO para clinicas medicas: AI search, descoberta local, contexto editorial e apoio as paginas comerciais da vertical."
  canonicalPath="/nichos/clinicas-medicas/"
  breadcrumbs={[
    { label: 'Home', path: '/' },
    { label: 'Nichos', path: '/nichos/' },
    { label: 'Clinicas Medicas', path: '/nichos/clinicas-medicas/' }
  ]}
>
  <div class="ee-page">
    <nav class="ee-page-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>›</span>
      <a href="/nichos/">Nichos</a>
      <span>›</span>
      <span class="current">Clinicas Medicas</span>
    </nav>

    <section class="ee-page-hero">
      <div>
        <span class="ee-page-badge">Saude, Estrutura e AI Search</span>
        <h1 class="ee-page-title">
          AI SEARCH PARA <span class="accent">CLINICAS MEDICAS</span> COM ESTRUTURA E CONTEXTO
        </h1>
        <p class="ee-page-subtitle">
          Esta pagina setorial existe para organizar o contexto de
          <strong> busca, descoberta e autoridade</strong> das clinicas medicas, apoiando as
          paginas comerciais da AUDITSEO sem disputar a intencao principal de contratacao do
          servico.
        </p>
        <div class="ee-page-highlights">
          <span class="ee-page-highlight">AI Search</span>
          <span class="ee-page-highlight">Google Maps</span>
          <span class="ee-page-highlight">Paginas de Especialidade</span>
          <span class="ee-page-highlight">E-E-A-T em Saude</span>
        </div>
      </div>

      <aside class="ee-page-hero-card">
        <h2>Onde o hub setorial ajuda</h2>
        <p>
          Ele alinha linguagem, provas, FAQs e caminhos de descoberta para clinicas que depois
          precisam avancar para uma pagina comercial ou local mais especifica.
        </p>
        <div class="ee-page-links">
          <a href="/servicos/seo-para-clinicas-medicas/">Ver pagina comercial</a>
          <a href="/servicos/seo-local/">Ver SEO Local</a>
          <a href="/servicos/google-meu-negocio/">Ver Google Meu Negocio</a>
        </div>
      </aside>
    </section>

    <section class="ee-page-stats" aria-label="Resumo da pagina setorial de clinicas medicas">
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">1</div>
        <div class="ee-page-stat-label">Hub de apoio</div>
        <p class="ee-page-stat-copy">A funcao aqui e organizar contexto, nao capturar a query comercial principal.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">3</div>
        <div class="ee-page-stat-label">Camadas centrais</div>
        <p class="ee-page-stat-copy">Busca, descoberta local e confianca editorial.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">0</div>
        <div class="ee-page-stat-label">Espaco para ruido</div>
        <p class="ee-page-stat-copy">Sem contexto, a vertical nao sustenta paginas comerciais melhores.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">100%</div>
        <div class="ee-page-stat-label">Dependencia de contexto</div>
        <p class="ee-page-stat-copy">Em saude, contexto e credibilidade pesam mais que volume puro.</p>
      </article>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Prioridades</span>
        <h2 class="ee-page-section-title">O QUE ESSE HUB ORGANIZA PARA CLINICAS MEDICAS</h2>
      </div>
      <div class="ee-page-grid three">
        {focusBlocks.map((item) => (
          <article class="ee-page-card">
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Escopo</span>
        <h2 class="ee-page-section-title">COMO ESSE CONTEXTO APOIA A CAMADA COMERCIAL</h2>
      </div>
      <div class="ee-page-panels">
        <article class="ee-page-panel">
          <h3>Frentes de trabalho</h3>
          <ul class="ee-page-list">
            {journeyCards.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
        <article class="ee-page-panel">
          <h3>Proximo passo comercial</h3>
          <p>
            Se a clinica depende de descoberta por especialidade, busca local e sinais de
            confianca, a entrada mais segura agora e a pagina comercial da vertical ou um
            diagnostico com foco em arquitetura e rastreabilidade.
          </p>
          <div class="ee-page-links">
            <a href="/servicos/seo-para-clinicas-medicas/">Abrir pagina comercial</a>
            <a href="/contato/">Solicitar diagnostico</a>
          </div>
        </article>
      </div>
    </section>

    <section class="ee-page-section ee-page-faq">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">FAQ</span>
        <h2 class="ee-page-section-title">DUVIDAS COMUNS DE CLINICAS MEDICAS</h2>
      </div>
      <div class="ee-page-faqs">
        {faqs.map((item) => (
          <article class="ee-page-faq">
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </article>
        ))}
      </div>
    </section>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</InstitutionalLayout>
