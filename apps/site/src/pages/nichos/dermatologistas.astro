---
import '../../styles/institutional-trust-pages.css';
import InstitutionalLayout from '../../layouts/InstitutionalLayout.astro';

const focusBlocks = [
  {
    title: 'Leitura por tratamento',
    copy:
      'Dermatologia concentra buscas por tratamentos, sintomas e diferencas de abordagem. O hub setorial organiza essa camada de linguagem e contexto.'
  },
  {
    title: 'Conexao com descoberta local',
    copy:
      'O mercado depende de mapa, proximidade, reputacao e clareza. A parte setorial ajuda a sustentar paginas comerciais mais focadas.'
  },
  {
    title: 'Apoio a vertical comercial',
    copy:
      'A funcao aqui nao e disputar a query comercial principal. E dar base semantica e editorial para a vertical de dermatologia.'
  }
];

const checklist = [
  'Mapeamento de tratamentos, sintomas e objeções relevantes',
  'Arquitetura entre pagina setorial, SEO local e Google Maps',
  'FAQs de contexto clinico e comercial',
  'Base para futuras derivacoes por cidade e especialidade'
];

const faqs = [
  {
    question: 'Essa pagina e a URL comercial principal de dermatologia?',
    answer:
      'Nao. Ela funciona como hub setorial de apoio. A URL comercial principal da vertical e a pagina de SEO para dermatologistas.'
  },
  {
    question: 'Por que separar o hub setorial da pagina comercial?',
    answer:
      'Porque o hub organiza contexto, linguagem e aplicacao da vertical. A pagina comercial precisa ficar mais concentrada em contratacao, diagnostico e decisao.'
  },
  {
    question: 'Quais servicos da AUDITSEO mais se conectam a esse nicho?',
    answer:
      'Principalmente a pagina comercial de SEO para dermatologistas, SEO Local e Google Meu Negocio, dependendo do tipo de demanda da clinica ou especialista.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
};
---
<InstitutionalLayout
  title="AI Search para Dermatologistas | AUDITSEO"
  description="Hub setorial da AUDITSEO para dermatologistas: AI search, descoberta local, paginas por tratamento e contexto editorial para apoiar a vertical comercial."
  canonicalPath="/nichos/dermatologistas/"
  breadcrumbs={[
    { label: 'Home', path: '/' },
    { label: 'Nichos', path: '/nichos/' },
    { label: 'Dermatologistas', path: '/nichos/dermatologistas/' }
  ]}
>
  <div class="ee-page">
    <nav class="ee-page-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>›</span>
      <a href="/nichos/">Nichos</a>
      <span>›</span>
      <span class="current">Dermatologistas</span>
    </nav>

    <section class="ee-page-hero">
      <div>
        <span class="ee-page-badge">Saude, Tratamentos e AI Search</span>
        <h1 class="ee-page-title">
          AI SEARCH PARA <span class="accent">DERMATOLOGISTAS</span> COM CONTEXTO CLINICO
        </h1>
        <p class="ee-page-subtitle">
          Esta pagina organiza a leitura setorial da dermatologia para
          <strong> descoberta</strong>, <strong>tratamentos</strong> e
          <strong> confianca</strong>, ajudando a sustentar as paginas comerciais da vertical sem
          disputar a query principal de servico.
        </p>
        <div class="ee-page-highlights">
          <span class="ee-page-highlight">Tratamentos</span>
          <span class="ee-page-highlight">Google Maps</span>
          <span class="ee-page-highlight">FAQs Medicas</span>
          <span class="ee-page-highlight">Confianca Editorial</span>
        </div>
      </div>

      <aside class="ee-page-hero-card">
        <h2>Onde esse hub setorial ajuda</h2>
        <p>
          Ele organiza linguagem, prova e contexto de descoberta para que a pagina comercial da
          vertical consiga vender melhor sem perder especificidade clinica.
        </p>
        <div class="ee-page-links">
          <a href="/servicos/seo-para-dermatologistas/">Ver pagina comercial</a>
          <a href="/servicos/seo-local/">Ver SEO Local</a>
          <a href="/servicos/google-meu-negocio/">Ver Google Meu Negocio</a>
        </div>
      </aside>
    </section>

    <section class="ee-page-stats" aria-label="Resumo da pagina setorial de dermatologistas">
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">1</div>
        <div class="ee-page-stat-label">Hub de apoio</div>
        <p class="ee-page-stat-copy">A funcao aqui e dar base setorial, nao capturar a principal query comercial.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">4</div>
        <div class="ee-page-stat-label">Camadas relevantes</div>
        <p class="ee-page-stat-copy">Tratamentos, mapa, confianca e contexto de consulta.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">0</div>
        <div class="ee-page-stat-label">Espaco para genericidade</div>
        <p class="ee-page-stat-copy">Texto generico enfraquece a vertical e a pagina comercial.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">100%</div>
        <div class="ee-page-stat-label">Dependencia de clareza</div>
        <p class="ee-page-stat-copy">A dermatologia depende de explicacao, contexto e proximo passo claro.</p>
      </article>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Prioridades</span>
        <h2 class="ee-page-section-title">O QUE ESSE HUB ORGANIZA PARA DERMATOLOGIA</h2>
      </div>
      <div class="ee-page-grid three">
        {focusBlocks.map((item) => (
          <article class="ee-page-card">
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Escopo</span>
        <h2 class="ee-page-section-title">COMO ESSE CONTEXTO APOIA A CAMADA COMERCIAL</h2>
      </div>
      <div class="ee-page-panels">
        <article class="ee-page-panel">
          <h3>Frentes de trabalho</h3>
          <ul class="ee-page-list">
            {checklist.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
        <article class="ee-page-panel">
          <h3>Proximo passo comercial</h3>
          <p>
            Quando a clinica depende de descoberta por tratamento, reputacao e buscas locais, a
            melhor entrada agora e a pagina comercial da vertical ou um diagnostico orientado a
            arquitetura comercial.
          </p>
          <div class="ee-page-links">
            <a href="/servicos/seo-para-dermatologistas/">Abrir pagina comercial</a>
            <a href="/contato/">Solicitar diagnostico</a>
          </div>
        </article>
      </div>
    </section>

    <section class="ee-page-section ee-page-faq">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">FAQ</span>
        <h2 class="ee-page-section-title">DUVIDAS COMUNS DE DERMATOLOGISTAS</h2>
      </div>
      <div class="ee-page-faqs">
        {faqs.map((item) => (
          <article class="ee-page-faq">
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </article>
        ))}
      </div>
    </section>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</InstitutionalLayout>
