---
import '../../styles/institutional-trust-pages.css';
import InstitutionalLayout from '../../layouts/InstitutionalLayout.astro';

const focusBlocks = [
  {
    title: 'Tratamentos e intencao clara',
    copy:
      'Dermatologia concentra buscas por tratamentos, sintomas, tecnologias e resultados. A pagina precisa responder isso com clareza comercial.'
  },
  {
    title: 'Descoberta local e reputacao',
    copy:
      'Clinicas e especialistas dependem de unidade, bairro, cidade, agenda e consistencia com Google Business Profile para converter busca em contato.'
  },
  {
    title: 'Confianca e linguagem medica',
    copy:
      'O conteudo precisa equilibrar precisao, elegibilidade comercial e prova sem cair em exagero promocional ou texto generico.'
  }
];

const checklist = [
  'Mapeamento por tratamento, sintomas e objecoes do paciente',
  'Arquitetura local para unidade, contato e agenda',
  'FAQs para duvidas de consulta, procedimento e preparo',
  'Ligacao entre pagina comercial, GBP e conteudo citavel'
];

const faqs = [
  {
    question: 'Dermatologistas precisam de pagina por tratamento?',
    answer:
      'Nem sempre. A prioridade e publicar paginas onde exista demanda real, intencao comercial clara e capacidade de diferenciar abordagem, preparo e contexto.'
  },
  {
    question: 'Essa pagina substitui SEO local?',
    answer:
      'Nao. Ela complementa o trabalho local. Dermatologia depende tanto de contexto setorial quanto de sinais geograficos e reputacionais.'
  },
  {
    question: 'Quais servicos da AUDITSEO se conectam mais a esse nicho?',
    answer:
      'Principalmente SEO Local, Google Meu Negocio e AI Overview Optimization, dependendo do tipo de demanda da clinica ou especialista.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
};
---
<InstitutionalLayout
  title="SEO para Dermatologistas | AUDITSEO"
  description="Pagina setorial da AUDITSEO para dermatologistas: descoberta local, paginas por tratamento, confianca medica e arquitetura pronta para busca tradicional e AI search."
  canonicalPath="/nichos/dermatologistas/"
  breadcrumbs={[
    { label: 'Home', path: '/' },
    { label: 'Nichos', path: '/nichos/' },
    { label: 'Dermatologistas', path: '/nichos/dermatologistas/' }
  ]}
>
  <div class="ee-page">
    <nav class="ee-page-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>›</span>
      <a href="/nichos/">Nichos</a>
      <span>›</span>
      <span class="current">Dermatologistas</span>
    </nav>

    <section class="ee-page-hero">
      <div>
        <span class="ee-page-badge">Saude, Tratamentos e Descoberta Local</span>
        <h1 class="ee-page-title">
          SEO PARA <span class="accent">DERMATOLOGISTAS</span> COM CONTEXTO CLINICO E COMERCIAL
        </h1>
        <p class="ee-page-subtitle">
          Dermatologistas precisam de paginas que unam <strong>tratamentos</strong>,
          <strong> descoberta local</strong>, <strong>criterio medico</strong> e
          <strong> conversao sem friccao</strong>. A AUDITSEO trata esse nicho como estrutura,
          prova e mensagem, nao como volume disperso.
        </p>
        <div class="ee-page-highlights">
          <span class="ee-page-highlight">Tratamentos</span>
          <span class="ee-page-highlight">Google Maps</span>
          <span class="ee-page-highlight">FAQs Medicas</span>
          <span class="ee-page-highlight">Confianca Editorial</span>
        </div>
      </div>

      <aside class="ee-page-hero-card">
        <h2>Onde esse nicho normalmente perde demanda</h2>
        <p>
          Em paginas vagas, sem prova, sem arquitetura local e sem clareza suficiente para o
          paciente entender o proximo passo.
        </p>
        <div class="ee-page-links">
          <a href="/servicos/seo-local/">Ver SEO Local</a>
          <a href="/servicos/google-meu-negocio/">Ver Google Meu Negocio</a>
          <a href="/servicos/ai-overview-optimization/">Ver AI Overview Optimization</a>
        </div>
      </aside>
    </section>

    <section class="ee-page-stats" aria-label="Resumo da pagina setorial de dermatologistas">
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">4</div>
        <div class="ee-page-stat-label">Entregas principais</div>
        <p class="ee-page-stat-copy">Tratamentos, local, FAQs e provas de confianca.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">1</div>
        <div class="ee-page-stat-label">Objetivo central</div>
        <p class="ee-page-stat-copy">Transformar busca em agendamento com mais previsibilidade.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">0</div>
        <div class="ee-page-stat-label">Espaco para genericidade</div>
        <p class="ee-page-stat-copy">Texto generico enfraquece citacao, confianca e conversao.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">100%</div>
        <div class="ee-page-stat-label">Dependencia de contexto</div>
        <p class="ee-page-stat-copy">Sem contexto, a pagina nao explica o tratamento nem a clinica.</p>
      </article>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Prioridades</span>
        <h2 class="ee-page-section-title">O QUE A AUDITSEO PRIORIZA PARA DERMATOLOGIA</h2>
      </div>
      <div class="ee-page-grid three">
        {focusBlocks.map((item) => (
          <article class="ee-page-card">
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Escopo</span>
        <h2 class="ee-page-section-title">ENTREGAS MAIS COMUNS PARA DERMATOLOGISTAS</h2>
      </div>
      <div class="ee-page-grid two">
        <article class="ee-page-card">
          <h3>Frentes de trabalho</h3>
          <ul class="ee-page-checklist">
            {checklist.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
        <article class="ee-page-card">
          <h3>Proximo passo comercial</h3>
          <p>
            Quando a clinica depende de descoberta por tratamento, reputacao e buscas locais, o
            melhor ponto de entrada costuma ser um diagnostico orientado a arquitetura comercial.
          </p>
          <div class="ee-page-links">
            <a href="/contato/">Solicitar diagnostico</a>
            <a href="/agencia-de-seo/">Entender a agencia</a>
          </div>
        </article>
      </div>
    </section>

    <section class="ee-page-section ee-page-faq">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">FAQ</span>
        <h2 class="ee-page-section-title">DUVIDAS COMUNS DE DERMATOLOGISTAS</h2>
      </div>
      <div class="ee-page-faq-list">
        {faqs.map((item) => (
          <article class="ee-page-faq-item">
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </article>
        ))}
      </div>
    </section>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</InstitutionalLayout>
