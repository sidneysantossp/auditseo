---
import '../../styles/institutional-trust-pages.css';
import InstitutionalLayout from '../../layouts/InstitutionalLayout.astro';

const focusBlocks = [
  {
    title: 'Leitura por tratamento',
    copy:
      'Dermatologia concentra buscas por tratamentos, sintomas e diferenças de abordagem. O hub setorial organiza essa camada de linguagem e contexto.'
  },
  {
    title: 'Conexão com descoberta local',
    copy:
      'O mercado depende de mapa, proximidade, reputação e clareza. A parte setorial ajuda a sustentar páginas comerciais mais focadas.'
  },
  {
    title: 'Apoio a vertical comercial',
    copy:
      'A função aqui não é disputar a query comercial principal. É dar base semântica e editorial para a vertical de dermatologia.'
  }
];

const checklist = [
  'Mapeamento de tratamentos, sintomas e objeções relevantes',
  'Arquitetura entre página setorial, SEO local e Google Maps',
  'FAQs de contexto clínico e comercial',
  'Base para futuras derivações por cidade e especialidade'
];

const faqs = [
  {
    question: 'Essa página é a URL comercial principal de dermatologia?',
    answer:
      'Não. Ela funciona como hub setorial de apoio. A URL comercial principal da vertical é a página de SEO para dermatologistas.'
  },
  {
    question: 'Por que separar o hub setorial da página comercial?',
    answer:
      'Porque o hub organiza contexto, linguagem e aplicação da vertical. A página comercial precisa ficar mais concentrada em contratação, diagnóstico e decisão.'
  },
  {
    question: 'Quais serviços da AUDITSEO mais se conectam a esse nicho?',
    answer:
      'Principalmente a página comercial de SEO para dermatologistas, SEO Local e Google Meu Negócio, dependendo do tipo de demanda da clínica ou especialista.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
};
---
<InstitutionalLayout
  title="AI Search para Dermatologistas | AUDITSEO"
  description="Hub setorial da AUDITSEO para dermatologistas: AI search, descoberta local, páginas por tratamento e contexto editorial para apoiar a vertical comercial."
  canonicalPath="/nichos/dermatologistas/"
  breadcrumbs={[
    { label: 'Home', path: '/' },
    { label: 'Nichos', path: '/nichos/' },
    { label: 'Dermatologistas', path: '/nichos/dermatologistas/' }
  ]}
>
  <div class="ee-page">
    <nav class="ee-page-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>›</span>
      <a href="/nichos/">Nichos</a>
      <span>›</span>
      <span class="current">Dermatologistas</span>
    </nav>

    <section class="ee-page-hero">
      <div>
        <span class="ee-page-badge">Saúde, Tratamentos e AI Search</span>
        <h1 class="ee-page-title">
          AI SEARCH PARA <span class="accent">DERMATOLOGISTAS</span> COM CONTEXTO CLÍNICO
        </h1>
        <p class="ee-page-subtitle">
          Esta página organiza a leitura setorial da dermatologia para
          <strong> descoberta</strong>, <strong>tratamentos</strong> e
          <strong> confiança</strong>, ajudando a sustentar as páginas comerciais da vertical sem
          disputar a query principal de serviço.
        </p>
        <div class="ee-page-highlights">
          <span class="ee-page-highlight">Tratamentos</span>
          <span class="ee-page-highlight">Google Maps</span>
          <span class="ee-page-highlight">FAQs Médicas</span>
          <span class="ee-page-highlight">Confiança Editorial</span>
        </div>
      </div>

      <aside class="ee-page-hero-card">
        <h2>Onde esse hub setorial ajuda</h2>
        <p>
          Ele organiza linguagem, prova e contexto de descoberta para que a página comercial da
          vertical consiga vender melhor sem perder especificidade clínica.
        </p>
        <div class="ee-page-links">
          <a href="/servicos/seo-para-dermatologistas/">Ver página comercial</a>
          <a href="/servicos/seo-local/">Ver SEO Local</a>
          <a href="/servicos/google-meu-negocio/">Ver Google Meu Negócio</a>
        </div>
      </aside>
    </section>

    <section class="ee-page-stats" aria-label="Resumo da página setorial de dermatologistas">
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">1</div>
        <div class="ee-page-stat-label">Hub de apoio</div>
        <p class="ee-page-stat-copy">A função aqui é dar base setorial, não capturar a principal query comercial.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">4</div>
        <div class="ee-page-stat-label">Camadas relevantes</div>
        <p class="ee-page-stat-copy">Tratamentos, mapa, confiança e contexto de consulta.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">0</div>
        <div class="ee-page-stat-label">Espaço para genericidade</div>
        <p class="ee-page-stat-copy">Texto genérico enfraquece a vertical e a página comercial.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">100%</div>
        <div class="ee-page-stat-label">Dependência de clareza</div>
        <p class="ee-page-stat-copy">A dermatologia depende de explicação, contexto e próximo passo claro.</p>
      </article>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Prioridades</span>
        <h2 class="ee-page-section-title">O QUE ESSE HUB ORGANIZA PARA DERMATOLOGIA</h2>
      </div>
      <div class="ee-page-grid three">
        {focusBlocks.map((item) => (
          <article class="ee-page-card">
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Escopo</span>
        <h2 class="ee-page-section-title">COMO ESSE CONTEXTO APOIA A CAMADA COMERCIAL</h2>
      </div>
      <div class="ee-page-panels">
        <article class="ee-page-panel">
          <h3>Frentes de trabalho</h3>
          <ul class="ee-page-list">
            {checklist.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
        <article class="ee-page-panel">
          <h3>Próximo passo comercial</h3>
          <p>
            Quando a clínica depende de descoberta por tratamento, reputação e buscas locais, a
            melhor entrada agora é a página comercial da vertical ou um diagnóstico orientado a
            arquitetura comercial.
          </p>
          <div class="ee-page-links">
            <a href="/servicos/seo-para-dermatologistas/">Abrir página comercial</a>
            <a href="/contato/">Solicitar diagnóstico</a>
          </div>
        </article>
      </div>
    </section>

    <section class="ee-page-section ee-page-faq">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">FAQ</span>
        <h2 class="ee-page-section-title">DÚVIDAS COMUNS DE DERMATOLOGISTAS</h2>
      </div>
      <div class="ee-page-faqs">
        {faqs.map((item) => (
          <article class="ee-page-faq">
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </article>
        ))}
      </div>
    </section>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</InstitutionalLayout>
