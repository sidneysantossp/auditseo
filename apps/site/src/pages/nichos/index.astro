---
import '../../styles/institutional-trust-pages.css';
import InstitutionalLayout from '../../layouts/InstitutionalLayout.astro';

const nicheCards = [
  {
    title: 'Clínicas Médicas',
    copy:
      'Estrutura comercial e editorial para captar demanda qualificada em especialidades, convênios, tratamentos e descoberta local.',
    href: '/nichos/clinicas-medicas/'
  },
  {
    title: 'Dermatologistas',
    copy:
      'Página setorial para dermatologia com foco em descoberta local, confiança médica, tratamentos e clareza de serviço.',
    href: '/nichos/dermatologistas/'
  },
  {
    title: 'Energia Solar',
    copy:
      'Arquitetura comercial e editorial para demanda B2B em integradores, projetos, usinas e captação de leads qualificados.',
    href: '/nichos/energia-solar/'
  },
  {
    title: 'Escritórios de Advocacia',
    copy:
      'Página setorial pensada para marketing jurídico informativo, autoridade topical e jornada de contato dentro das regras da OAB.',
    href: '/nichos/escritorios-advocacia/'
  }
];

const faqs = [
  {
    question: 'Qual o papel de uma página de nicho na arquitetura da AUDITSEO?',
    answer:
      'A página de nicho traduz a metodologia e os serviços da AUDITSEO para um contexto setorial específico, com linguagem, provas e objeções do segmento.'
  },
  {
    question: 'Toda página de nicho precisa de um serviço próprio?',
    answer:
      'Não. O ideal é conectar o nicho aos serviços principais da casa, evitando canibalização e mantendo uma arquitetura comercial coerente.'
  },
  {
    question: 'Essas páginas são diferentes de landing pages locais?',
    answer:
      'Sim. Nicho organiza contexto vertical. Landing local combina nicho, intenção comercial e geografia quando há sinal real para isso.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
};
---
<InstitutionalLayout
  title="Nichos Atendidos pela AUDITSEO"
  description="Veja como a AUDITSEO adapta SEO, IA e arquitetura de páginas para nichos específicos, com foco comercial, rastreabilidade e E-E-A-T."
  canonicalPath="/nichos/"
  breadcrumbs={[
    { label: 'Home', path: '/' },
    { label: 'Nichos', path: '/nichos/' }
  ]}
>
  <div class="ee-page">
    <nav class="ee-page-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>›</span>
      <span class="current">Nichos</span>
    </nav>

    <section class="ee-page-hero">
      <div>
        <span class="ee-page-badge">Clusters Setoriais</span>
        <h1 class="ee-page-title">
          NICHOS COM <span class="accent">MENSAGEM</span>, PROVA E INTENÇÃO COMERCIAL
        </h1>
        <p class="ee-page-subtitle">
          As páginas de nicho da AUDITSEO não existem para inflar URL. Elas existem para traduzir a
          mesma estrutura de serviço para mercados com regras, linguagem, objeções e sinais de
          autoridade próprios.
        </p>
        <div class="ee-page-highlights">
          <span class="ee-page-highlight">SEO Setorial</span>
          <span class="ee-page-highlight">Mensagem por Segmento</span>
          <span class="ee-page-highlight">Linkagem Comercial</span>
          <span class="ee-page-highlight">Sem Doorway Pages</span>
        </div>
      </div>

      <aside class="ee-page-hero-card">
        <h2>Como os nichos se conectam ao site</h2>
        <p>
          Cada página setorial se ancora nos serviços principais, no bloco institucional e no blog,
          sem criar estruturas paralelas nem competir por intenção com a Home.
        </p>
        <div class="ee-page-links">
          <a href="/servicos/">Ver serviços</a>
          <a href="/metodologia/">Ver metodologia</a>
          <a href="/blog/">Ver blog</a>
        </div>
      </aside>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Páginas disponíveis</span>
        <h2 class="ee-page-section-title">NICHOS JÁ MATERIALIZADOS NA NOVA ARQUITETURA</h2>
      </div>
      <div class="ee-page-grid two">
        {nicheCards.map((item) => (
          <article class="ee-page-card">
            <span class="ee-page-card-eyebrow">Nicho</span>
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
            <div class="ee-page-links">
              <a href={item.href}>Abrir página</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Critério</span>
        <h2 class="ee-page-section-title">QUANDO UM NOVO NICHO MERECE EXISTIR</h2>
      </div>
      <div class="ee-page-grid three">
        <article class="ee-page-card">
          <h3>Demanda real</h3>
          <p>Tem que existir busca, conversa comercial e necessidade de linguagem própria.</p>
        </article>
        <article class="ee-page-card">
          <h3>Adaptação de prova</h3>
          <p>O nicho precisa de argumentos, FAQs e exemplos que não cabem em uma página genérica.</p>
        </article>
        <article class="ee-page-card">
          <h3>Conexão com serviço</h3>
          <p>Sem ponte clara para um serviço principal, a URL vira ruído. Aqui isso não entra.</p>
        </article>
      </div>
    </section>

    <section class="ee-page-section ee-page-faq">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">FAQ</span>
        <h2 class="ee-page-section-title">DÚVIDAS COMUNS SOBRE PÁGINAS DE NICHO</h2>
      </div>
      <div class="ee-page-faq-list">
        {faqs.map((item) => (
          <article class="ee-page-faq-item">
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </article>
        ))}
      </div>
    </section>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</InstitutionalLayout>
