---
import '../../styles/institutional-trust-pages.css';
import InstitutionalLayout from '../../layouts/InstitutionalLayout.astro';

const focusBlocks = [
  {
    title: 'Marketing jurídico informativo',
    copy:
      'O conteúdo precisa ser útil e preciso, sem tom promocional inadequado nem promessas que criem risco regulatório.'
  },
  {
    title: 'Autoridade topical por área',
    copy:
      'Escritórios ganham mais quando organizam áreas de atuação, perguntas recorrentes e páginas com contexto jurídico claro.'
  },
  {
    title: 'Busca qualificada e contato',
    copy:
      'A jornada comercial precisa ligar tema, área do direito, cidade e formulário de contato com baixa fricção.'
  }
];

const checklist = [
  'Arquitetura por área de atuação e intenção de busca',
  'Conteúdo informativo dentro das regras da OAB',
  'Páginas comerciais para contato e captação passiva',
  'Reforço de autoridade editorial e sinalização institucional'
];

const faqs = [
  {
    question: 'SEO para advogados é compatível com as regras da OAB?',
    answer:
      'Sim, quando a estratégia privilegia informação, descoberta orgânica e clareza de serviço, sem promessas indevidas ou captação agressiva.'
  },
  {
    question: 'O escritório precisa ter uma página para cada área do direito?',
    answer:
      'Nem sempre. O desenho depende da profundidade da atuação e da existência de demanda real. O importante é evitar páginas vazias ou repetidas.'
  },
  {
    question: 'Quais serviços da AUDITSEO se conectam a esse nicho?',
    answer:
      'Principalmente consultoria SEO, auditoria SEO e página institucional/comercial orientada para áreas de atuação e descoberta local.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
};
---
<InstitutionalLayout
  title="SEO para Escritórios de Advocacia | AUDITSEO"
  description="Página setorial da AUDITSEO para escritórios de advocacia: SEO informativo, estrutura comercial, descoberta local e autoridade editorial dentro das regras do marketing jurídico."
  canonicalPath="/nichos/escritorios-advocacia/"
  breadcrumbs={[
    { label: 'Home', path: '/' },
    { label: 'Nichos', path: '/nichos/' },
    { label: 'Escritorios de Advocacia', path: '/nichos/escritorios-advocacia/' }
  ]}
>
  <div class="ee-page">
    <nav class="ee-page-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>›</span>
      <a href="/nichos/">Nichos</a>
      <span>›</span>
      <span class="current">Escritórios de Advocacia</span>
    </nav>

    <section class="ee-page-hero">
      <div>
        <span class="ee-page-badge">Marketing Jurídico Estruturado</span>
        <h1 class="ee-page-title">
          SEO PARA <span class="accent">ESCRITÓRIOS DE ADVOCACIA</span> COM CONTEXTO E CRITÉRIO
        </h1>
        <p class="ee-page-subtitle">
          Escritórios não precisam de excesso de volume. Precisam de
          <strong> autoridade editorial</strong>, <strong>páginas por área</strong>,
          <strong> descoberta qualificada</strong> e uma camada institucional que transmita
          critério técnico e jurídico com sobriedade.
        </p>
        <div class="ee-page-highlights">
          <span class="ee-page-highlight">Marketing Jurídico</span>
          <span class="ee-page-highlight">Áreas de Atuação</span>
          <span class="ee-page-highlight">SEO Informativo</span>
          <span class="ee-page-highlight">Contato Qualificado</span>
        </div>
      </div>

      <aside class="ee-page-hero-card">
        <h2>Onde esse nicho costuma travar</h2>
        <p>
          Geralmente em páginas genéricas, falta de organização por área do direito e textos que
          não ajudam o usuário a entender quando deve falar com o escritório.
        </p>
        <div class="ee-page-links">
          <a href="/servicos/consultoria-seo/">Ver consultoria SEO</a>
          <a href="/servicos/auditoria-seo/">Ver auditoria SEO</a>
          <a href="/contato/">Solicitar diagnóstico</a>
        </div>
      </aside>
    </section>

    <section class="ee-page-stats" aria-label="Resumo da página setorial de advocacia">
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">1</div>
        <div class="ee-page-stat-label">Tom correto</div>
        <p class="ee-page-stat-copy">Informativo, claro e comercial sem ultrapassar o limite.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">3</div>
        <div class="ee-page-stat-label">Bases da estrutura</div>
        <p class="ee-page-stat-copy">Área, contexto, confiança institucional.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">0</div>
        <div class="ee-page-stat-label">Espaço para exagero</div>
        <p class="ee-page-stat-copy">Promessa indevida enfraquece marca e risco regulatório.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">100%</div>
        <div class="ee-page-stat-label">Dependência de clareza</div>
        <p class="ee-page-stat-copy">No jurídico, a mensagem certa vale mais que volume disperso.</p>
      </article>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Pontos críticos</span>
        <h2 class="ee-page-section-title">O QUE A AUDITSEO PRIORIZA NESSE SEGMENTO</h2>
      </div>
      <div class="ee-page-grid three">
        {focusBlocks.map((item) => (
          <article class="ee-page-card">
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Escopo</span>
        <h2 class="ee-page-section-title">ENTREGAS MAIS COMUNS PARA ESCRITÓRIOS</h2>
      </div>
      <div class="ee-page-grid two">
        <article class="ee-page-card">
          <h3>Frentes de trabalho</h3>
          <ul class="ee-page-checklist">
            {checklist.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
        <article class="ee-page-card">
          <h3>Encaminhamento comercial</h3>
          <p>
            Quando o escritório já tem demanda, mas não consegue transformar busca em contato
            qualificado, a prioridade costuma ser ajustar arquitetura comercial, hierarquia e
            confiança institucional.
          </p>
          <div class="ee-page-links">
            <a href="/agencia-de-seo/">Entender a agência</a>
            <a href="/sobre/">Conhecer a AUDITSEO</a>
          </div>
        </article>
      </div>
    </section>

    <section class="ee-page-section ee-page-faq">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">FAQ</span>
        <h2 class="ee-page-section-title">DÚVIDAS COMUNS DE ESCRITÓRIOS DE ADVOCACIA</h2>
      </div>
      <div class="ee-page-faq-list">
        {faqs.map((item) => (
          <article class="ee-page-faq-item">
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </article>
        ))}
      </div>
    </section>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</InstitutionalLayout>
