---
import '../../styles/services-hub-parity.css';
import '../../styles/institutional-trust-pages.css';
import AgencySeoLocalCluster from '../../components/AgencySeoLocalCluster.astro';
import LegacyContentEnhancements from '../../components/LegacyContentEnhancements.astro';
import ServiceFirstSectorLinks from '../../components/ServiceFirstSectorLinks.astro';
import ServicesHubLegacyContent from '../../components/ServicesHubLegacyContent.astro';
import ServiceHubLayout from '../../layouts/ServiceHubLayout.astro';
---
<ServiceHubLayout
  title="Servicos de SEO AI-First"
  description="Servicos especializados em Search Intelligence AI: otimizacao para AI Overviews, presenca em ChatGPT e SEO Local."
  canonicalPath="/servicos/"
  imagePath="/images/agencia-de-seo.png"
  breadcrumbs={[
    { label: 'Home', path: '/' },
    { label: 'Servicos', path: '/servicos/' }
  ]}
>
  <ServicesHubLegacyContent />
  <AgencySeoLocalCluster
    eyebrow="Praca comercial ativa"
    title="SERVICOS CANONICOS JA ALIMENTAM O CLUSTER DE BARUERI E ALPHAVILLE"
    subtitle="A frente local nao depende so de SEO Local. Ela conecta agencia, consultoria, auditoria e artigos BOFU para capturar busca de contratacao no eixo empresarial de Barueri e Alphaville."
  />
  <ServiceFirstSectorLinks />
  <LegacyContentEnhancements />
</ServiceHubLayout>
