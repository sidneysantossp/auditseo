---
import '../../styles/consultoria-seo-parity.css';
import AgencySeoLocalCluster from '../../components/AgencySeoLocalCluster.astro';
import ConsultoriaSeoLegacyContent from '../../components/ConsultoriaSeoLegacyContent.astro';
import LegacyContentEnhancements from '../../components/LegacyContentEnhancements.astro';
import ServiceDetailLayout from '../../layouts/ServiceDetailLayout.astro';
---
<ServiceDetailLayout
  title="Consultoria SEO para Empresas | AUDITSEO"
  description="Consultoria SEO especializada com estrategia personalizada, acompanhamento continuo e orientacao pratica para crescimento organico, arquitetura e governanca de execucao, com aplicacao local ativa em Barueri e Alphaville."
  canonicalPath="/servicos/consultoria-seo/"
  imagePath="/images/seo.jpeg"
  pageType="Service"
  breadcrumbs={[
    { label: 'Home', path: '/' },
    { label: 'Servicos', path: '/servicos/' },
    { label: 'Consultoria SEO', path: '/servicos/consultoria-seo/' }
  ]}
>
  <ConsultoriaSeoLegacyContent />
  <AgencySeoLocalCluster
    eyebrow="Aplicacao local"
    title="CONSULTORIA CANONICA JA SUSTENTA BARUERI E ALPHAVILLE"
    subtitle="A pagina canonica de consultoria continua ampla, mas a aplicacao local ja esta pronta para captar quem procura consultoria SEO, consultor SEO ou especialista em SEO no eixo empresarial de Barueri e Alphaville, sem competir com a pagina money local de agencia."
  />
  <LegacyContentEnhancements />
</ServiceDetailLayout>
