---
import '../../styles/auditoria-seo-parity.css';
import AgencySeoLocalCluster from '../../components/AgencySeoLocalCluster.astro';
import AuditoriaSeoLegacyContent from '../../components/AuditoriaSeoLegacyContent.astro';
import LegacyContentEnhancements from '../../components/LegacyContentEnhancements.astro';
import ServiceDetailLayout from '../../layouts/ServiceDetailLayout.astro';
---
<ServiceDetailLayout
  title="Auditoria SEO | Base Tecnica, AI Overviews e Arquitetura | AUDITSEO"
  description="Auditoria SEO profissional para diagnosticar tecnica, arquitetura, citabilidade e gargalos que travam indexacao, AI Overviews, performance e crescimento organico."
  canonicalPath="/servicos/auditoria-seo/"
  imagePath="/images/coreweb-vitals.jpeg"
  pageType="Service"
  breadcrumbs={[
    { label: 'Home', path: '/' },
    { label: 'Servicos', path: '/servicos/' },
    { label: 'Auditoria SEO', path: '/servicos/auditoria-seo/' }
  ]}
>
  <AuditoriaSeoLegacyContent />
  <AgencySeoLocalCluster
    eyebrow="Diagnostico estrategico"
    title="AUDITORIA PRECISA PUXAR DIAGNOSTICO TECNICO E AI OVERVIEWS SEM VIRAR PAGINA GENERICA"
    subtitle="A auditoria continua sendo a entrada tecnica ampla do servico, mas agora tambem precisa absorver a demanda de diagnostico para AI Overviews, SEO generativo e reestruturacao antes da consultoria continua ou da expansao local."
    signals={[
      'Auditoria SEO',
      'Diagnostico tecnico',
      'AI Overviews',
      'SEO generativo',
      'Barueri e Alphaville'
    ]}
    links={[
      {
        title: 'AI Overview Optimization',
        copy: 'Mostra quando a especializacao em AI Overviews entra depois que a base tecnica e editorial ja consegue sustentar citabilidade.',
        path: '/servicos/ai-overview-optimization/'
      },
      {
        title: 'Consultoria SEO',
        copy: 'Passo seguinte quando o diagnostico ja separou o backlog e a operacao precisa de governanca continua.',
        path: '/servicos/consultoria-seo/'
      },
      {
        title: 'Auditoria SEO em Barueri',
        copy: 'Aplicacao local do diagnostico para a primeira praca empresarial aberta na Grande Sao Paulo.',
        path: '/servicos/auditoria-seo-em-barueri/'
      },
      {
        title: 'Agencia de SEO',
        copy: 'Hub comercial amplo para quem ainda entra por empresa ou agencia de SEO e precisa depois decidir o modelo correto.',
        path: '/agencia-de-seo/'
      }
    ]}
  />
  <LegacyContentEnhancements />
</ServiceDetailLayout>
