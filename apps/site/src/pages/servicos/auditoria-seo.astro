---
import '../../styles/auditoria-seo-parity.css';
import AgencySeoLocalCluster from '../../components/AgencySeoLocalCluster.astro';
import AuditoriaSeoLegacyContent from '../../components/AuditoriaSeoLegacyContent.astro';
import LegacyContentEnhancements from '../../components/LegacyContentEnhancements.astro';
import ServiceDetailLayout from '../../layouts/ServiceDetailLayout.astro';
---
<ServiceDetailLayout
  title="Auditoria SEO"
  description="Auditoria SEO profissional com analise tecnica, on-page e estrutural para identificar os problemas que travam indexacao, performance, relevancia e crescimento organico."
  canonicalPath="/servicos/auditoria-seo/"
  imagePath="/images/coreweb-vitals.jpeg"
  pageType="Service"
  breadcrumbs={[
    { label: 'Home', path: '/' },
    { label: 'Servicos', path: '/servicos/' },
    { label: 'Auditoria SEO', path: '/servicos/auditoria-seo/' }
  ]}
>
  <AuditoriaSeoLegacyContent />
  <AgencySeoLocalCluster
    eyebrow="Aplicacao local"
    title="AUDITORIA CANONICA JA TEM PORTA LOCAL EM BARUERI E ALPHAVILLE"
    subtitle="A auditoria continua sendo a entrada técnica ampla do serviço, mas a camada local da praça já organiza a intenção de diagnóstico para empresas que pesquisam SEO em Barueri e Alphaville."
  />
  <LegacyContentEnhancements />
</ServiceDetailLayout>
