---
import '../styles/institutional-trust-pages.css';
import LegalLayout from '../layouts/LegalLayout.astro';
import { siteMetadata } from '../data/site';

const principles = [
  {
    title: 'Uso licito e responsavel',
    copy:
      'O site deve ser usado para consulta, contato, avaliacao de servicos e interacao legitima com o conteudo da AUDITSEO.'
  },
  {
    title: 'Conteudo com finalidade informativa e comercial',
    copy:
      'As paginas explicam servicos, metodologia, visao editorial e materiais do site. Elas nao substituem aconselhamento juridico, contabil ou regulatorio individualizado.'
  },
  {
    title: 'Protecao da estrutura intelectual',
    copy:
      'Texto, layout, elementos de marca, materiais proprietarios e organizacao da informacao pertencem a AUDITSEO ou a seus respectivos titulares.'
  },
  {
    title: 'Atualizacao continua',
    copy:
      'O site pode mudar sem aviso previo para refletir novas paginas, ajustes tecnicos, mudancas de produto e evolucao da operacao.'
  }
];

const usagePanels = [
  {
    title: 'Uso permitido',
    items: [
      'Ler, compartilhar e citar o conteudo com contexto adequado',
      'Entrar em contato para briefing, diagnostico, proposta ou parceria',
      'Usar as paginas como referencia de arquitetura, SEO e estrategia',
      'Navegar nas rotas publicas dentro da finalidade normal do site'
    ]
  },
  {
    title: 'Uso nao permitido',
    items: [
      'Tentar explorar vulnerabilidades, automacoes abusivas ou indisponibilidade do site',
      'Copiar integralmente materiais proprietarios para republicacao como se fossem proprios',
      'Usar formularios ou canais oficiais para spam, fraude ou coleta indevida',
      'Apresentar o conteudo da AUDITSEO como garantia de resultado sem contexto tecnico'
    ]
  }
];

const contractPanels = [
  {
    title: 'Limites de responsabilidade',
    items: [
      'A navegacao no site nao cria automaticamente contrato de prestacao de servico',
      'Qualquer escopo comercial depende de proposta, alinhamento e aceite especifico',
      'Resultados de SEO, IA e crescimento organico dependem de contexto, execucao e concorrencia',
      'O site pode conter links para materiais externos de contexto, sem controle editorial integral sobre esses ambientes'
    ]
  },
  {
    title: 'Relacao com formularios e contato',
    items: [
      'Enviar um formulario nao garante aceite comercial, prazo ou contratacao',
      'A AUDITSEO pode responder, recusar ou redirecionar demandas fora do escopo',
      'O usuario deve enviar informacoes verdadeiras e sob seu proprio controle',
      'Canais como e-mail e WhatsApp devem ser usados de boa-fe e com finalidade legitima'
    ]
  }
];

const faqs = [
  {
    question: 'Ler o site cria uma relacao contratual com a AUDITSEO?',
    answer:
      'Nao. A navegacao no site tem finalidade informativa e comercial, mas nao substitui proposta, aceite, contrato ou definicao formal de escopo.'
  },
  {
    question: 'Posso reproduzir o conteudo da AUDITSEO em outro site?',
    answer:
      'Trechos curtos com citacao adequada podem ser referenciados, mas a reproducao integral, a copia estrutural ou o reaproveitamento de materiais proprietarios sem autorizacao nao sao permitidos.'
  },
  {
    question: 'Os servicos e promessas do site valem para qualquer negocio?',
    answer:
      'Nao. Cada negocio tem contexto tecnico, concorrencial e operacional proprio. O site explica oferta e metodologia, mas qualquer expectativa precisa ser validada no diagnostico.'
  },
  {
    question: 'A AUDITSEO pode alterar estes termos?',
    answer:
      'Sim. Os termos podem ser atualizados para refletir mudancas de produto, operacao, arquitetura do site ou exigencias legais.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
};
---
<LegalLayout
  title="Termos de Uso da AUDITSEO"
  description="Leia os termos de uso do site da AUDITSEO, incluindo finalidade do conteudo, limites de responsabilidade, propriedade intelectual e uso correto dos canais oficiais."
  canonicalPath="/termos-de-uso/"
  noindex={true}
  breadcrumbs={[
    { label: 'Home', path: '/' },
    { label: 'Termos de Uso', path: '/termos-de-uso/' }
  ]}
>
  <div class="ee-page">
    <nav class="ee-page-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>›</span>
      <span class="current">Termos de Uso</span>
    </nav>

    <section class="ee-page-hero">
      <div>
        <span class="ee-page-badge">Base de uso do site</span>
        <h1 class="ee-page-title">
          TERMOS DE <span class="accent">USO</span> DA AUDITSEO
        </h1>
        <p class="ee-page-subtitle">
          Estes termos explicam a finalidade do site, o que pode ou nao pode ser feito com o
          conteudo publicado, como funcionam os <strong>canais de contato</strong>, quais sao os
          <strong>limites de responsabilidade</strong> da AUDITSEO e como a estrutura publica pode
          ser atualizada ao longo do tempo.
        </p>
        <div class="ee-page-highlights">
          <span class="ee-page-highlight">Uso Licito</span>
          <span class="ee-page-highlight">Conteudo Informativo</span>
          <span class="ee-page-highlight">Propriedade Intelectual</span>
          <span class="ee-page-highlight">Sem Contrato Automatico</span>
        </div>
      </div>
      <aside class="ee-page-hero-card">
        <h2>Para que estes termos existem</h2>
        <p>Para alinhar expectativa, proteger a operacao do site e dar clareza sobre o uso da base publica.</p>
        <p>
          Eles convivem com a politica de privacidade e com as paginas institucionais que explicam
          metodologia, autoria e criterios de publicacao.
        </p>
        <div class="ee-page-links">
          <a href="/politica-de-privacidade/">Privacidade</a>
          <a href="/metodologia/">Metodologia</a>
          <a href="/contato/">Contato</a>
        </div>
      </aside>
    </section>

    <section class="ee-page-stats" aria-label="Resumo dos termos de uso">
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">2</div>
        <div class="ee-page-stat-label">Blocos centrais</div>
        <p class="ee-page-stat-copy">Uso permitido e limites operacionais da base publica.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">0</div>
        <div class="ee-page-stat-label">Contrato automatico</div>
        <p class="ee-page-stat-copy">Contato pelo site nao substitui proposta, aceite ou escopo.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">1</div>
        <div class="ee-page-stat-label">Titular da marca</div>
        <p class="ee-page-stat-copy">A marca e os materiais do site pertencem a AUDITSEO.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">1</div>
        <div class="ee-page-stat-label">Canal oficial</div>
        <p class="ee-page-stat-copy">Duvidas formais podem ser enviadas para {siteMetadata.contact.email}.</p>
      </article>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Principios</span>
        <h2 class="ee-page-section-title">COMO O SITE DEVE SER INTERPRETADO</h2>
      </div>
      <div class="ee-page-grid four">
        {principles.map((item) => (
          <article class="ee-page-card">
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Uso</span>
        <h2 class="ee-page-section-title">O QUE PODE E O QUE NAO PODE SER FEITO</h2>
      </div>
      <div class="ee-page-panels">
        {usagePanels.map((panel) => (
          <article class="ee-page-panel">
            <h3>{panel.title}</h3>
            <ul class="ee-page-list">
              {panel.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Responsabilidade</span>
        <h2 class="ee-page-section-title">CONTRATACAO, LIMITES E CANAIS OFICIAIS</h2>
      </div>
      <div class="ee-page-panels">
        {contractPanels.map((panel) => (
          <article class="ee-page-panel">
            <h3>{panel.title}</h3>
            <ul class="ee-page-list">
              {panel.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">FAQ</span>
        <h2 class="ee-page-section-title">DUVIDAS COMUNS SOBRE O USO DO SITE</h2>
      </div>
      <div class="ee-page-faqs">
        {faqs.map((item) => (
          <article class="ee-page-faq">
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-cta">
      <div class="ee-page-cta-box">
        <span class="ee-page-section-badge">Canal oficial</span>
        <h2 class="ee-page-section-title">PRECISA ESCLARECER ALGUM PONTO DE USO OU CONTRATACAO?</h2>
        <p class="ee-page-cta-copy">
          Use o e-mail oficial para registrar duvidas sobre os termos, sobre o uso do conteudo ou
          sobre a forma correta de iniciar um contato comercial.
        </p>
        <div class="ee-page-cta-actions">
          <a class="ee-page-primary" href={`mailto:${siteMetadata.contact.email}`}>Enviar e-mail</a>
          <a class="ee-page-secondary" href="/contato/">Ir para contato</a>
        </div>
      </div>
    </section>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</LegalLayout>
