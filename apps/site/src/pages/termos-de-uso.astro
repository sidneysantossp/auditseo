---
import '../styles/institutional-trust-pages.css';
import LegalLayout from '../layouts/LegalLayout.astro';
import { siteMetadata } from '../data/site';
import { normalizeEditorialValue } from '../lib/editorial-text';

const principles = normalizeEditorialValue([
  {
    title: 'Uso lícito e responsável',
    copy:
      'O site deve ser usado para consulta, contato, avaliação de serviços e interação legítima com o conteúdo da AUDITSEO.'
  },
  {
    title: 'Conteúdo com finalidade informativa e comercial',
    copy:
      'As páginas explicam serviços, metodologia, visão editorial e materiais do site. Elas não substituem aconselhamento jurídico, contábil ou regulatório individualizado.'
  },
  {
    title: 'Proteção da estrutura intelectual',
    copy:
      'Texto, layout, elementos de marca, materiais proprietários e organização da informação pertencem à AUDITSEO ou a seus respectivos titulares.'
  },
  {
    title: 'Atualização contínua',
    copy:
      'O site pode mudar sem aviso prévio para refletir novas páginas, ajustes técnicos, mudanças de produto e evolução da operação.'
  }
]);

const usagePanels = normalizeEditorialValue([
  {
    title: 'Uso permitido',
    items: [
      'Ler, compartilhar e citar o conteúdo com contexto adequado',
      'Entrar em contato para briefing, diagnóstico, proposta ou parceria',
      'Usar as páginas como referência de arquitetura, SEO e estratégia',
      'Navegar nas rotas públicas dentro da finalidade normal do site'
    ]
  },
  {
    title: 'Uso não permitido',
    items: [
      'Tentar explorar vulnerabilidades, automações abusivas ou indisponibilidade do site',
      'Copiar integralmente materiais proprietários para republicação como se fossem próprios',
      'Usar formulários ou canais oficiais para spam, fraude ou coleta indevida',
      'Apresentar o conteúdo da AUDITSEO como garantia de resultado sem contexto técnico'
    ]
  }
]);

const contractPanels = normalizeEditorialValue([
  {
    title: 'Limites de responsabilidade',
    items: [
      'A navegação no site não cria automaticamente contrato de prestação de serviço',
      'Qualquer escopo comercial depende de proposta, alinhamento e aceite específico',
      'Resultados de SEO, IA e crescimento orgânico dependem de contexto, execução e concorrência',
      'O site pode conter links para materiais externos de contexto, sem controle editorial integral sobre esses ambientes'
    ]
  },
  {
    title: 'Relação com formulários e contato',
    items: [
      'Enviar um formulário não garante aceite comercial, prazo ou contratação',
      'A AUDITSEO pode responder, recusar ou redirecionar demandas fora do escopo',
      'O usuário deve enviar informações verdadeiras e sob seu próprio controle',
      'Canais como e-mail e WhatsApp devem ser usados de boa-fé e com finalidade legítima'
    ]
  }
]);

const faqs = normalizeEditorialValue([
  {
    question: 'Ler o site cria uma relação contratual com a AUDITSEO?',
    answer:
      'Não. A navegação no site tem finalidade informativa e comercial, mas não substitui proposta, aceite, contrato ou definição formal de escopo.'
  },
  {
    question: 'Posso reproduzir o conteúdo da AUDITSEO em outro site?',
    answer:
      'Trechos curtos com citação adequada podem ser referenciados, mas a reprodução integral, a cópia estrutural ou o reaproveitamento de materiais proprietários sem autorização não são permitidos.'
  },
  {
    question: 'Os serviços e promessas do site valem para qualquer negócio?',
    answer:
      'Não. Cada negócio tem contexto técnico, concorrencial e operacional próprio. O site explica oferta e metodologia, mas qualquer expectativa precisa ser validada no diagnóstico.'
  },
  {
    question: 'A AUDITSEO pode alterar estes termos?',
    answer:
      'Sim. Os termos podem ser atualizados para refletir mudanças de produto, operação, arquitetura do site ou exigências legais.'
  }
]);

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
};
---
<LegalLayout
  title="Termos de Uso da AUDITSEO"
  description="Leia os termos de uso do site da AUDITSEO, incluindo finalidade do conteúdo, limites de responsabilidade, propriedade intelectual e uso correto dos canais oficiais."
  canonicalPath="/termos-de-uso/"
  noindex={true}
  breadcrumbs={[
    { label: 'Home', path: '/' },
    { label: 'Termos de Uso', path: '/termos-de-uso/' }
  ]}
>
  <div class="ee-page">
    <nav class="ee-page-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>›</span>
      <span class="current">Termos de Uso</span>
    </nav>

    <section class="ee-page-hero">
      <div>
        <span class="ee-page-badge">Base de uso do site</span>
        <h1 class="ee-page-title">
          TERMOS DE <span class="accent">USO</span> DA AUDITSEO
        </h1>
        <p class="ee-page-subtitle">
          Estes termos explicam a finalidade do site, o que pode ou não pode ser feito com o
          conteúdo publicado, como funcionam os <strong>canais de contato</strong>, quais são os
          <strong>limites de responsabilidade</strong> da AUDITSEO e como a estrutura pública pode
          ser atualizada ao longo do tempo.
        </p>
        <div class="ee-page-highlights">
          <span class="ee-page-highlight">Uso Lícito</span>
          <span class="ee-page-highlight">Conteúdo Informativo</span>
          <span class="ee-page-highlight">Propriedade Intelectual</span>
          <span class="ee-page-highlight">Sem Contrato Automático</span>
        </div>
      </div>
      <aside class="ee-page-hero-card">
        <h2>Para que estes termos existem</h2>
        <p>Para alinhar expectativa, proteger a operação do site e dar clareza sobre o uso da base pública.</p>
        <p>
          Eles convivem com a política de privacidade e com as páginas institucionais que explicam
          metodologia, autoria e critérios de publicação.
        </p>
        <div class="ee-page-links">
          <a href="/politica-de-privacidade/">Privacidade</a>
          <a href="/metodologia/">Metodologia</a>
          <a href="/contato/">Contato</a>
        </div>
      </aside>
    </section>

    <section class="ee-page-stats" aria-label="Resumo dos termos de uso">
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">2</div>
        <div class="ee-page-stat-label">Blocos centrais</div>
        <p class="ee-page-stat-copy">Uso permitido e limites operacionais da base pública.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">0</div>
        <div class="ee-page-stat-label">Contrato automático</div>
        <p class="ee-page-stat-copy">Contato pelo site não substitui proposta, aceite ou escopo.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">1</div>
        <div class="ee-page-stat-label">Titular da marca</div>
        <p class="ee-page-stat-copy">A marca e os materiais do site pertencem à AUDITSEO.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">1</div>
        <div class="ee-page-stat-label">Canal oficial</div>
        <p class="ee-page-stat-copy">Dúvidas formais podem ser enviadas para {siteMetadata.contact.email}.</p>
      </article>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Princípios</span>
        <h2 class="ee-page-section-title">COMO O SITE DEVE SER INTERPRETADO</h2>
      </div>
      <div class="ee-page-grid four">
        {principles.map((item) => (
          <article class="ee-page-card">
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Uso</span>
        <h2 class="ee-page-section-title">O QUE PODE E O QUE NÃO PODE SER FEITO</h2>
      </div>
      <div class="ee-page-panels">
        {usagePanels.map((panel) => (
          <article class="ee-page-panel">
            <h3>{panel.title}</h3>
            <ul class="ee-page-list">
              {panel.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Responsabilidade</span>
        <h2 class="ee-page-section-title">CONTRATAÇÃO, LIMITES E CANAIS OFICIAIS</h2>
      </div>
      <div class="ee-page-panels">
        {contractPanels.map((panel) => (
          <article class="ee-page-panel">
            <h3>{panel.title}</h3>
            <ul class="ee-page-list">
              {panel.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">FAQ</span>
        <h2 class="ee-page-section-title">DÚVIDAS COMUNS SOBRE O USO DO SITE</h2>
      </div>
      <div class="ee-page-faqs">
        {faqs.map((item) => (
          <article class="ee-page-faq">
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-cta">
      <div class="ee-page-cta-box">
        <span class="ee-page-section-badge">Canal oficial</span>
        <h2 class="ee-page-section-title">PRECISA ESCLARECER ALGUM PONTO DE USO OU CONTRATAÇÃO?</h2>
        <p class="ee-page-cta-copy">
          Use o e-mail oficial para registrar dúvidas sobre os termos, sobre o uso do conteúdo ou
          sobre a forma correta de iniciar um contato comercial.
        </p>
        <div class="ee-page-cta-actions">
          <a class="ee-page-primary" href={`mailto:${siteMetadata.contact.email}`}>Enviar e-mail</a>
          <a class="ee-page-secondary" href="/contato/">Ir para contato</a>
        </div>
      </div>
    </section>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</LegalLayout>
