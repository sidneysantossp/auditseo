---
import '../../styles/institutional-trust-pages.css';
import ResourceHubSchemas from '../../components/ResourceHubSchemas.astro';
import ToolsHubEnhancements from '../../components/ToolsHubEnhancements.astro';
import InstitutionalLayout from '../../layouts/InstitutionalLayout.astro';
import { getFreeTools } from '../../lib/content-collections';

const freeTools = await getFreeTools();

const usagePanels = [
  {
    title: 'Como a AUDITSEO pensa ferramentas gratuitas',
    items: [
      'Ferramenta precisa resolver uma tarefa real de producao.',
      'Resultado deve ser simples de interpretar por marketing, conteudo e dev.',
      'Pagina da ferramenta precisa ter contexto editorial e ligacao com o restante do cluster.',
      'Sempre que possivel, o processamento fica no navegador para reduzir dependencia de backend.'
    ]
  },
  {
    title: 'Como o hub se conecta ao restante do site',
    items: [
      'Ferramentas reforcam paginas de servico com prova de metodo.',
      'Artigos do blog explicam o criterio tecnico por tras de cada utilitario.',
      'Cada recurso gratuito ajuda a qualificar o usuario antes do contato comercial.',
      'A arquitetura evita separar educacao, diagnostico e conversao em ilhas.'
    ]
  }
];

const faqs = [
  {
    question: 'As ferramentas da AUDITSEO exigem login?',
    answer:
      'Nao nesta primeira camada. A direcao da arquitetura e privilegiar uso imediato e processamento local sempre que possivel.'
  },
  {
    question: 'Essas ferramentas substituem auditoria profissional?',
    answer:
      'Nao. Elas ajudam a diagnosticar, validar e acelerar tarefas pontuais. A leitura estrategica continua dependendo de contexto e prioridade de negocio.'
  },
  {
    question: 'Cada ferramenta ganha pagina propria?',
    answer:
      'Sim. O hub organiza descoberta. Ferramentas ativas ganham rota propria, schema especifico e conexao com servicos e artigos.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
};
---
<InstitutionalLayout
  title="Ferramentas SEO Gratuitas da AUDITSEO"
  description="Hub de ferramentas gratuitas da AUDITSEO para diagnostico, snippet preview, schema FAQ e checklist operacional de AI SEO."
  canonicalPath="/ferramentas/"
  breadcrumbs={[
    { label: 'Home', path: '/' },
    { label: 'Ferramentas', path: '/ferramentas/' }
  ]}
>
  <Fragment slot="head">
    <ResourceHubSchemas
      canonicalPath="/ferramentas/"
      title="Ferramentas AUDITSEO"
      description="Hub de ferramentas gratuitas da AUDITSEO com utilitarios para snippet, schema FAQ e checklist operacional de AI SEO."
      items={freeTools.map((tool) => ({
        title: tool.title,
        path: `/ferramentas/${tool.slug}/`,
        description: tool.description
      }))}
      itemType="SoftwareApplication"
    />
  </Fragment>

  <div class="ee-page">
    <nav class="ee-page-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>›</span>
      <span class="current">Ferramentas</span>
    </nav>

    <section class="ee-page-hero">
      <div>
        <span class="ee-page-badge">Recursos gratuitos</span>
        <h1 class="ee-page-title">
          FERRAMENTAS <span class="accent">SEO</span> PARA TESTAR E DECIDIR MAIS RAPIDO
        </h1>
        <p class="ee-page-subtitle">
          Este hub concentra utilitarios gratuitos da AUDITSEO para revisar partes criticas da
          operacao organica. A regra e simples: cada ferramenta precisa ser <strong>pratica</strong>,
          <strong>leve</strong> e <strong>conectada</strong> ao restante da arquitetura do site.
        </p>
        <div class="ee-page-highlights">
          <span class="ee-page-highlight">Sem login</span>
          <span class="ee-page-highlight">Uso imediato</span>
          <span class="ee-page-highlight">SEO + IA</span>
          <span class="ee-page-highlight">Ligado aos servicos</span>
        </div>
      </div>
      <aside class="ee-page-hero-card">
        <h2>Primeira camada do hub</h2>
        <p>As ferramentas foram publicadas como rotas proprias para nao depender de bloco unico na home do hub.</p>
        <p>O objetivo e combinar utilitario real, contexto editorial e ligacao com servicos e artigos do cluster.</p>
        <div class="ee-page-links">
          <a href="/servicos/auditoria-seo/">Auditoria SEO</a>
          <a href="/servicos/consultoria-seo/">Consultoria SEO</a>
          <a href="/blog/">Blog</a>
        </div>
      </aside>
    </section>

    <section class="ee-page-stats" aria-label="Resumo do hub de ferramentas">
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">{freeTools.length}</div>
        <div class="ee-page-stat-label">Ferramentas ativas</div>
        <p class="ee-page-stat-copy">Cada uma com pagina propria, contexto editorial e schema de software.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">3</div>
        <div class="ee-page-stat-label">Categorias iniciais</div>
        <p class="ee-page-stat-copy">Snippet, schema e diagnostico operacional.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">0</div>
        <div class="ee-page-stat-label">Dependencia externa</div>
        <p class="ee-page-stat-copy">A camada inicial funciona direto no navegador.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">1</div>
        <div class="ee-page-stat-label">Objetivo do hub</div>
        <p class="ee-page-stat-copy">Reduzir atrito entre teste rapido, QA e decisao tecnica.</p>
      </article>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Ferramentas publicadas</span>
        <h2 class="ee-page-section-title">UTILITARIOS REAIS, COM ROTA E CONTEXTO PROPRIOS</h2>
      </div>
      <div class="ee-resource-grid three">
        {freeTools.map((tool) => (
          <article class="ee-resource-card">
            <div class="ee-resource-card-head">
              <span class="ee-page-section-badge">{tool.badge}</span>
              <span class="ee-resource-status">{tool.statusLabel}</span>
            </div>
            <h3>{tool.title}</h3>
            <p>{tool.description}</p>
            <div class="ee-resource-card-meta">
              <span>{tool.categoryLabel}</span>
              <span>{tool.outputLabel}</span>
            </div>
            <div class="ee-page-links">
              <a href={`/ferramentas/${tool.slug}/`}>Abrir ferramenta</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Preview rapido</span>
        <h2 class="ee-page-section-title">SIMULADOR DE TITLE E META DESCRIPTION</h2>
        <p class="ee-page-section-subtitle">
          O hub mantem um preview rapido para revisar snippet sem sair da pagina. A versao completa
          da ferramenta fica na rota propria.
        </p>
      </div>

      <div class="ee-tool-shell">
        <article class="ee-tool-panel">
          <div class="ee-tool-head">
            <h3>Entradas</h3>
            <button id="snippet-reset" type="button" class="ee-page-secondary ee-tool-reset">Restaurar exemplo</button>
          </div>
          <div class="ee-tool-fields">
            <label class="ee-tool-field">
              <span>Title tag</span>
              <input id="snippet-title" type="text" maxlength="90" />
              <small>Recomendacao pratica: ate 60 caracteres.</small>
            </label>
            <label class="ee-tool-field">
              <span>Meta description</span>
              <textarea id="snippet-description" rows="5" maxlength="220"></textarea>
              <small>Faixa comum: ate 155 caracteres para manter boa legibilidade.</small>
            </label>
            <label class="ee-tool-field">
              <span>URL</span>
              <input id="snippet-url" type="url" />
              <small>Use uma URL curta, clara e coerente com o cluster.</small>
            </label>
          </div>
          <div class="ee-tool-counters">
            <div class="ee-tool-counter-card">
              <span class="label">Title</span>
              <strong id="snippet-title-counter">0/60</strong>
            </div>
            <div class="ee-tool-counter-card">
              <span class="label">Description</span>
              <strong id="snippet-description-counter">0/155</strong>
            </div>
          </div>
        </article>

        <article class="ee-tool-panel">
          <div class="ee-tool-head">
            <h3>Preview</h3>
            <span class="ee-tool-hint">Leitura aproximada do snippet organico</span>
          </div>
          <div class="ee-tool-preview">
            <div class="ee-tool-preview-url" id="snippet-preview-url"></div>
            <div class="ee-tool-preview-title" id="snippet-preview-title"></div>
            <div class="ee-tool-preview-description" id="snippet-preview-description"></div>
          </div>
          <div class="ee-tool-notes">
            <p>Use o preview para alinhar promessa, palavra-chave principal e intencao da pagina.</p>
            <p>Se precisar de mais contexto, entre na ferramenta completa para revisar com apoio editorial.</p>
          </div>
          <div class="ee-page-links">
            <a href="/ferramentas/preview-title-meta/">Abrir ferramenta completa</a>
          </div>
        </article>
      </div>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-panels">
        {usagePanels.map((panel) => (
          <article class="ee-page-panel">
            <h3>{panel.title}</h3>
            <ul class="ee-page-list">
              {panel.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">FAQ</span>
        <h2 class="ee-page-section-title">DUVIDAS COMUNS SOBRE O HUB DE FERRAMENTAS</h2>
      </div>
      <div class="ee-page-faqs">
        {faqs.map((item) => (
          <article class="ee-page-faq">
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-cta">
      <div class="ee-page-cta-box">
        <span class="ee-page-section-badge">Diagnostico</span>
        <h2 class="ee-page-section-title">QUER TRANSFORMAR TESTE RAPIDO EM PLANO DE ACAO?</h2>
        <p class="ee-page-cta-copy">
          Use as ferramentas para validar hipoteses, e chame a AUDITSEO quando precisar conectar esses sinais a arquitetura, backlog tecnico e paginas comerciais.
        </p>
        <div class="ee-page-cta-actions">
          <button type="button" class="ee-page-primary" data-open-cta-modal>Solicitar diagnostico</button>
          <a href="/servicos/auditoria-seo/" class="ee-page-secondary">Ver auditoria SEO</a>
        </div>
      </div>
    </section>
  </div>

  <ToolsHubEnhancements />
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</InstitutionalLayout>
