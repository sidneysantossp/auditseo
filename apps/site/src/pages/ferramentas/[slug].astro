---
import '../../styles/institutional-trust-pages.css';
import ToolPageHead from '../../components/ToolPageHead.astro';
import ToolsHubEnhancements from '../../components/ToolsHubEnhancements.astro';
import AiSeoChecklistTool from '../../components/tools/AiSeoChecklistTool.astro';
import FaqSchemaGeneratorTool from '../../components/tools/FaqSchemaGeneratorTool.astro';
import SnippetPreviewTool from '../../components/tools/SnippetPreviewTool.astro';
import InstitutionalLayout from '../../layouts/InstitutionalLayout.astro';
import { getFreeTools, getFreeToolBySlug } from '../../lib/content-collections';

export async function getStaticPaths() {
  const freeTools = await getFreeTools();
  return freeTools.map((tool) => ({ params: { slug: tool.slug } }));
}

const slug = Astro.params.slug ?? '';
const tool = await getFreeToolBySlug(slug);

if (!tool) {
  throw new Error(`Ferramenta nao encontrada: ${slug}`);
}
---
<InstitutionalLayout
  title={tool.seoTitle}
  description={tool.description}
  canonicalPath={`/ferramentas/${tool.slug}/`}
  breadcrumbs={[
    { label: 'Home', path: '/' },
    { label: 'Ferramentas', path: '/ferramentas/' },
    { label: tool.title, path: `/ferramentas/${tool.slug}/` }
  ]}
>
  <Fragment slot="head">
    <ToolPageHead tool={tool} />
  </Fragment>

  <div class="ee-page">
    <nav class="ee-page-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>›</span>
      <a href="/ferramentas/">Ferramentas</a>
      <span>›</span>
      <span class="current">{tool.title}</span>
    </nav>

    <section class="ee-page-hero">
      <div>
        <span class="ee-page-badge">{tool.badge}</span>
        <h1 class="ee-page-title">{tool.title}</h1>
        <p class="ee-page-subtitle">{tool.heroSubtitle}</p>
        <div class="ee-page-highlights">
          <span class="ee-page-highlight">{tool.statusLabel}</span>
          <span class="ee-page-highlight">{tool.categoryLabel}</span>
          <span class="ee-page-highlight">{tool.outputLabel}</span>
          <span class="ee-page-highlight">Browser only</span>
        </div>
      </div>
      <aside class="ee-page-hero-card">
        <h2>O que esta ferramenta entrega</h2>
        <ul class="ee-page-list">
          {tool.summaryPoints.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </aside>
    </section>

    <section class="ee-page-stats" aria-label={`Resumo da ferramenta ${tool.title}`}>
      {tool.metrics.map((metric) => (
        <article class="ee-page-stat">
          <div class="ee-page-stat-value">{metric.value}</div>
          <div class="ee-page-stat-label">{metric.label}</div>
          <p class="ee-page-stat-copy">{metric.copy}</p>
        </article>
      ))}
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Ferramenta ativa</span>
        <h2 class="ee-page-section-title">USE O UTILITARIO DIRETO NESTA PAGINA</h2>
      </div>
      {tool.kind === 'snippet-preview' && <SnippetPreviewTool />}
      {tool.kind === 'faq-schema-generator' && <FaqSchemaGeneratorTool />}
      {tool.kind === 'ai-seo-checklist' && <AiSeoChecklistTool />}
    </section>

    <section class="ee-page-section">
      <div class="ee-page-grid three">
        {tool.overviewCards.map((card) => (
          <article class="ee-page-card">
            <h3>{card.title}</h3>
            <p>{card.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-panels">
        <article class="ee-page-panel">
          <h3>Casos de uso</h3>
          <ul class="ee-page-list">
            {tool.useCases.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
        <article class="ee-page-panel">
          <h3>Como usar</h3>
          <ul class="ee-page-list">
            {tool.howItWorks.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
      </div>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-panels">
        <article class="ee-page-panel">
          <h3>Servicos relacionados</h3>
          <ul class="ee-page-list">
            {tool.serviceLinks.map((item) => (
              <li><a class="ee-page-inline-link" href={item.path}>{item.label}</a></li>
            ))}
          </ul>
        </article>
        <article class="ee-page-panel">
          <h3>Leituras recomendadas</h3>
          <ul class="ee-page-list">
            {tool.articleLinks.map((item) => (
              <li><a class="ee-page-inline-link" href={item.path}>{item.label}</a></li>
            ))}
          </ul>
        </article>
      </div>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">FAQ</span>
        <h2 class="ee-page-section-title">DUVIDAS COMUNS SOBRE ESTA FERRAMENTA</h2>
      </div>
      <div class="ee-page-faqs">
        {tool.faqs.map((item) => (
          <article class="ee-page-faq">
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-cta">
      <div class="ee-page-cta-box">
        <span class="ee-page-section-badge">Proximo passo</span>
        <h2 class="ee-page-section-title">QUER LEVAR O DIAGNOSTICO PARA UMA EXECUCAO COMPLETA?</h2>
        <p class="ee-page-cta-copy">
          A ferramenta ajuda a acelerar leitura e QA. Quando voce precisar ligar isso a backlog tecnico, cluster e conversao, a AUDITSEO entra no plano mais profundo.
        </p>
        <div class="ee-page-cta-actions">
          <button type="button" class="ee-page-primary" data-open-cta-modal>Solicitar diagnostico</button>
          <a href="/servicos/consultoria-seo/" class="ee-page-secondary">Ver consultoria SEO</a>
        </div>
      </div>
    </section>
  </div>

  {tool.kind === 'snippet-preview' && <ToolsHubEnhancements />}
</InstitutionalLayout>
