---
import '../../styles/institutional-trust-pages.css';
import CaseStudyHead from '../../components/CaseStudyHead.astro';
import InstitutionalLayout from '../../layouts/InstitutionalLayout.astro';
import { normalizeEditorialValue } from '../../lib/editorial-text';
import { getCaseStudies, getCaseStudyBySlug } from '../../lib/content-collections';

export async function getStaticPaths() {
  const caseStudies = await getCaseStudies();
  return caseStudies.map((caseStudy) => ({ params: { slug: caseStudy.slug } }));
}

const slug = Astro.params.slug ?? '';
const caseStudy = await getCaseStudyBySlug(slug);

if (!caseStudy) {
  throw new Error(`Case não encontrado: ${slug}`);
}

const visibleCaseStudy = normalizeEditorialValue(caseStudy);
---
<InstitutionalLayout
  title={visibleCaseStudy.seoTitle}
  description={visibleCaseStudy.description}
  canonicalPath={`/cases/${visibleCaseStudy.slug}/`}
  breadcrumbs={[
    { label: 'Home', path: '/' },
    { label: 'Cases', path: '/cases/' },
    { label: visibleCaseStudy.title, path: `/cases/${visibleCaseStudy.slug}/` }
  ]}
>
  <Fragment slot="head">
    <CaseStudyHead caseStudy={visibleCaseStudy} />
  </Fragment>

  <div class="ee-page">
    <nav class="ee-page-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>›</span>
      <a href="/cases/">Cases</a>
      <span>›</span>
      <span class="current">{visibleCaseStudy.title}</span>
    </nav>

    <section class="ee-page-hero">
      <div>
        <span class="ee-page-badge">{visibleCaseStudy.badge}</span>
        <h1 class="ee-page-title">{visibleCaseStudy.title}</h1>
        <p class="ee-page-subtitle">{visibleCaseStudy.heroSubtitle}</p>
        <div class="ee-page-highlights">
          <span class="ee-page-highlight">{visibleCaseStudy.statusLabel}</span>
          <span class="ee-page-highlight">{visibleCaseStudy.typeLabel}</span>
          <span class="ee-page-highlight">{visibleCaseStudy.scopeLabel}</span>
          <span class="ee-page-highlight">{visibleCaseStudy.durationLabel}</span>
        </div>
      </div>
      <aside class="ee-page-hero-card">
        <h2>Leitura executiva</h2>
        <p>{visibleCaseStudy.evidenceNote}</p>
        <ul class="ee-page-list">
          {visibleCaseStudy.summaryPoints.map((point) => (
            <li>{point}</li>
          ))}
        </ul>
      </aside>
    </section>

    <section class="ee-page-stats" aria-label={`Resumo do case ${visibleCaseStudy.title}`}>
      {visibleCaseStudy.metrics.map((metric) => (
        <article class="ee-page-stat">
          <div class="ee-page-stat-value">{metric.value}</div>
          <div class="ee-page-stat-label">{metric.label}</div>
          <p class="ee-page-stat-copy">{metric.copy}</p>
        </article>
      ))}
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Contexto</span>
        <h2 class="ee-page-section-title">COMO O CASO FOI DELIMITADO</h2>
      </div>
      <div class="ee-page-grid three">
        {caseStudy.overviewCards.map((card) => (
          <article class="ee-page-card">
            <h3>{card.title}</h3>
            <p>{card.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-panels">
        <article class="ee-page-panel">
          <h3>Gargalos encontrados</h3>
          <ul class="ee-page-list">
            {visibleCaseStudy.challengePoints.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
        <article class="ee-page-panel">
          <h3>Intervenções executadas</h3>
          <ul class="ee-page-list">
            {visibleCaseStudy.interventionSteps.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
      </div>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Impacto</span>
        <h2 class="ee-page-section-title">O QUE ESTE CASE PASSOU A PROVAR</h2>
      </div>
      <div class="ee-page-grid three">
        {visibleCaseStudy.outcomes.map((item) => (
          <article class="ee-page-card">
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-panels">
        <article class="ee-page-panel">
          <h3>Lições do caso</h3>
          <ul class="ee-page-list">
            {visibleCaseStudy.lessons.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
        <article class="ee-page-panel">
          <h3>Rotas relacionadas</h3>
          <ul class="ee-page-list">
            {visibleCaseStudy.serviceLinks.map((item) => (
              <li><a class="ee-page-inline-link" href={item.path}>{item.label}</a></li>
            ))}
            {visibleCaseStudy.articleLinks.map((item) => (
              <li><a class="ee-page-inline-link" href={item.path}>{item.label}</a></li>
            ))}
          </ul>
        </article>
      </div>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">FAQ</span>
        <h2 class="ee-page-section-title">DÚVIDAS COMUNS SOBRE ESTE CASE</h2>
      </div>
      <div class="ee-page-faqs">
        {visibleCaseStudy.faqs.map((item) => (
          <article class="ee-page-faq">
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-cta">
      <div class="ee-page-cta-box">
        <span class="ee-page-section-badge">Aplicação</span>
        <h2 class="ee-page-section-title">QUER LEVAR ESTE RACIOCÍNIO PARA O SEU SITE?</h2>
        <p class="ee-page-cta-copy">
          A AUDITSEO usa esse mesmo tipo de leitura para transformar problema técnico, editorial e comercial em backlog claro e página mais competitiva.
        </p>
        <div class="ee-page-cta-actions">
          <button type="button" class="ee-page-primary" data-open-cta-modal>Solicitar diagnóstico</button>
          <a href="/servicos/consultoria-seo/" class="ee-page-secondary">Ver consultoria SEO</a>
        </div>
      </div>
    </section>
  </div>
</InstitutionalLayout>
