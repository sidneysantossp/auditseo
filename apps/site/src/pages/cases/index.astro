---
import '../../styles/institutional-trust-pages.css';
import ResourceHubSchemas from '../../components/ResourceHubSchemas.astro';
import InstitutionalLayout from '../../layouts/InstitutionalLayout.astro';
import { getCaseStudies } from '../../lib/content-collections';

const caseStudies = await getCaseStudies();

const evidenceBlocks = [
  {
    title: 'Arquitetura e rastreabilidade',
    copy:
      'Os cases mostram como shell, templates, links internos, canonicals e sitemaps passam a operar como sistema, não como remendo.'
  },
  {
    title: 'Conteúdo e clusters',
    copy:
      'Cada case explica como páginas editoriais, comerciais, locais e setoriais deixam de competir e passam a reforçar a mesma entidade.'
  },
  {
    title: 'Prova sem vaidade',
    copy:
      'A AUDITSEO trata case como documento de critério: problema, intervenção, impacto observável e aprendizado reaproveitável.'
  },
  {
    title: 'Transferência de método',
    copy:
      'Um bom case não acaba no resultado; ele vira regra de execução para o backlog, o blog e as páginas do cluster.'
  }
];

const documentationSteps = [
  {
    title: 'Problema',
    copy: 'O case parte do gargalo real do projeto, não da lista de entregas.'
  },
  {
    title: 'Contexto',
    copy: 'Antes de agir, o caso mostra a base técnica, editorial e comercial da URL.'
  },
  {
    title: 'Intervenção',
    copy: 'A página registra o que foi alterado em arquitetura, copy, schema e ligação interna.'
  },
  {
    title: 'Prova',
    copy: 'O impacto precisa aparecer em sinais observáveis, não em narrativa vaga.'
  },
  {
    title: 'Limite',
    copy: 'Toda prova séria deixa claro o que o case cobre e o que ele não cobre.'
  },
  {
    title: 'Aprendizado',
    copy: 'O fechamento do case precisa gerar critério reutilizável para outros projetos.'
  }
];

const faqs = [
  {
    question: 'Todos os cases da AUDITSEO mostram analytics completos?',
    answer:
      'Não. Alguns são públicos e auditáveis, outros são anonimizados. Em ambos os casos, a prioridade é explicar o método com honestidade.'
  },
  {
    question: 'A AUDITSEO usa o próprio site como case?',
    answer:
      'Sim. O próprio site funciona como laboratório auditável para arquitetura, blog, sitemap, llms e expansão de clusters.'
  },
  {
    question: 'Case aqui significa apenas aumento de tráfego?',
    answer:
      'Não. Um case pode provar arquitetura, descoberta local, citabilidade, governança editorial, qualificação comercial ou redução de retrabalho.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
};
---
<InstitutionalLayout
  title="Cases e Resultados da AUDITSEO"
  description="Hub de cases da AUDITSEO com provas de arquitetura, SEO técnico, blog, SEO local e organização de clusters sem depender de vanity metrics."
  canonicalPath="/cases/"
  breadcrumbs={[
    { label: 'Home', path: '/' },
    { label: 'Cases', path: '/cases/' }
  ]}
>
  <Fragment slot="head">
    <ResourceHubSchemas
      canonicalPath="/cases/"
      title="Cases AUDITSEO"
      description="Hub de cases da AUDITSEO com páginas públicas e anonimizadas sobre arquitetura, SEO técnico, blog e SEO local."
      items={caseStudies.map((caseStudy) => ({
        title: caseStudy.title,
        path: `/cases/${caseStudy.slug}/`,
        description: caseStudy.description
      }))}
      itemType="Article"
    />
  </Fragment>

  <div class="ee-page">
    <nav class="ee-page-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>›</span>
      <span class="current">Cases</span>
    </nav>

    <section class="ee-page-hero">
      <div>
        <span class="ee-page-badge">Prova e aprendizado</span>
        <h1 class="ee-page-title">
          CASES QUE <span class="accent">EXPLICAM</span> O MÉTODO
        </h1>
        <p class="ee-page-subtitle">
          Este hub organiza os cases da AUDITSEO como documentos de prova: <strong>contexto</strong>,
          <strong>intervenção</strong>, <strong>impacto</strong> e <strong>aprendizado</strong>.
          O objetivo não é publicar vaidade. É mostrar critério reutilizável para arquitetura,
          SEO, IA, descoberta local e governança editorial.
        </p>
        <div class="ee-page-highlights">
          <span class="ee-page-highlight">Cases internos</span>
          <span class="ee-page-highlight">Casos anonimizados</span>
          <span class="ee-page-highlight">Método reaproveitável</span>
          <span class="ee-page-highlight">Sem vanity metrics</span>
        </div>
      </div>
      <aside class="ee-page-hero-card">
        <h2>Como ler este hub</h2>
        <p>
          Cada case foi escrito para explicar porque a intervenção aconteceu, quais sinais foram
          atacados e que tipo de aprendizado essa prova gera para outros projetos.
        </p>
        <p>
          Quando o contexto é interno, a prova é auditável no próprio domínio. Quando o contexto é
          anonimizado, a página privilegia método e ordem de execução.
        </p>
        <div class="ee-page-links">
          <a href="/metodologia/">Metodologia</a>
          <a href="/servicos/">Serviços</a>
          <a href="/blog/">Blog</a>
        </div>
      </aside>
    </section>

    <section class="ee-page-stats" aria-label="Resumo do hub de cases">
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">{caseStudies.length}</div>
        <div class="ee-page-stat-label">Cases ativos</div>
        <p class="ee-page-stat-copy">Páginas reais organizadas por slug e conectadas ao resto da arquitetura.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">2</div>
        <div class="ee-page-stat-label">Modelos de prova</div>
        <p class="ee-page-stat-copy">Público auditável e anonimizado orientado a método.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">6</div>
        <div class="ee-page-stat-label">Etapas de leitura</div>
        <p class="ee-page-stat-copy">Da origem do problema ao aprendizado reutilizável.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">1</div>
        <div class="ee-page-stat-label">Objetivo central</div>
        <p class="ee-page-stat-copy">Transformar resultado em critério de execução reaproveitável.</p>
      </article>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Cases publicados</span>
        <h2 class="ee-page-section-title">ROTAS REAIS DE PROVA E APRENDIZADO</h2>
      </div>
      <div class="ee-resource-grid three">
        {caseStudies.map((caseStudy) => (
          <article class="ee-resource-card">
            <div class="ee-resource-card-head">
              <span class="ee-page-section-badge">{caseStudy.badge}</span>
              <span class="ee-resource-status">{caseStudy.statusLabel}</span>
            </div>
            <h3>{caseStudy.title}</h3>
            <p>{caseStudy.description}</p>
            <div class="ee-resource-card-meta">
              <span>{caseStudy.typeLabel}</span>
              <span>{caseStudy.scopeLabel}</span>
            </div>
            <div class="ee-page-links">
              <a href={`/cases/${caseStudy.slug}/`}>Abrir case</a>
            </div>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Leitura</span>
        <h2 class="ee-page-section-title">QUE TIPO DE PROVA A AUDITSEO CONSIDERA VÁLIDA</h2>
      </div>
      <div class="ee-page-grid four">
        {evidenceBlocks.map((item) => (
          <article class="ee-page-card">
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Processo</span>
        <h2 class="ee-page-section-title">AS 6 ETAPAS PARA PUBLICAR UM CASE COM CREDIBILIDADE</h2>
      </div>
      <div class="ee-page-process">
        {documentationSteps.map((step, index) => (
          <article class="ee-page-step">
            <div class="ee-page-step-number">{String(index + 1).padStart(2, '0')}</div>
            <h3>{step.title}</h3>
            <p>{step.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">FAQ</span>
        <h2 class="ee-page-section-title">DÚVIDAS SOBRE PUBLICAÇÃO E CONFIABILIDADE</h2>
      </div>
      <div class="ee-page-faqs">
        {faqs.map((item) => (
          <article class="ee-page-faq">
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-cta">
      <div class="ee-page-cta-box">
        <span class="ee-page-section-badge">Prova comercial</span>
        <h2 class="ee-page-section-title">QUER ESTRUTURAR UM CASE OU UM DIAGNÓSTICO PUBLICÁVEL?</h2>
        <p class="ee-page-cta-copy">
          Se você precisa transformar resultado técnico em narrativa comercial sem perder rigor, a
          AUDITSEO pode organizar o framework de prova, leitura de impacto e documentação.
        </p>
        <div class="ee-page-cta-actions">
          <button type="button" class="ee-page-primary" data-open-cta-modal>Solicitar diagnóstico</button>
          <a href="/contato/" class="ee-page-secondary">Falar com a AUDITSEO</a>
        </div>
      </div>
    </section>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</InstitutionalLayout>
