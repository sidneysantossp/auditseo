---
import AgencySeoLocalCluster from '../components/AgencySeoLocalCluster.astro';
import HomeEnhancements from '../components/HomeEnhancements.astro';
import HomeLegacyContent from '../components/HomeLegacyContent.astro';
import HomeLayout from '../layouts/HomeLayout.astro';
---
<HomeLayout
  title="Agencia de SEO AI-First para Empresas | AUDITSEO"
  description="AUDITSEO e a agencia de SEO AI-first para empresas, com operacao nacional e primeira frente local em Barueri e Alphaville para buscas de agencia, empresa, consultoria e especialista em SEO."
  canonicalPath="/"
  imagePath="/images/agencia-de-seo.png"
  breadcrumbs={[{ label: 'Home', path: '/' }]}
>
  <HomeLegacyContent />
  <AgencySeoLocalCluster
    eyebrow="Praca local prioritaria"
    title="BARUERI E ALPHAVILLE SAO A PRIMEIRA FRENTE LOCAL DA AUDITSEO"
    subtitle="A operacao nacional continua ampla, mas a primeira malha local ja esta montada para captar buscas de agencia, empresa, consultoria, consultor e especialista em SEO no eixo empresarial de Barueri e Alphaville, com Barueri sustentando a ancora estrutural da URL e Alphaville reforcando a densidade comercial da praca."
  />
  <HomeEnhancements />
</HomeLayout>
