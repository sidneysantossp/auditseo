---
import '../styles/institutional-trust-pages.css';
import InstitutionalLayout from '../layouts/InstitutionalLayout.astro';

const principles = [
  {
    title: 'Diagnóstico antes de opinião',
    copy:
      'Toda recomendação nasce de auditoria técnica, análise de SERP, leitura de entidade, arquitetura e sinais reais do negócio. Sem isso, qualquer plano vira achismo.'
  },
  {
    title: 'Prioridade por impacto',
    copy:
      'Não executamos listas infinitas. Priorizamos o que muda indexação, cobertura, citabilidade, conversão e distribuição de autoridade.'
  },
  {
    title: 'SEO para Google e IA',
    copy:
      'A metodologia considera busca tradicional, AI Overviews, LLMs e superfícies de descoberta. O objetivo é deixar a marca encontrável, compreensível e citável.'
  },
  {
    title: 'Medição ligada a negócio',
    copy:
      'Ranking isolado não basta. A leitura inclui visibilidade, cobertura tópica, leads, pipeline comercial e ganhos de eficiência no conteúdo.'
  }
];

const processSteps = [
  {
    title: 'Diagnóstico',
    copy:
      'Mapeamento de arquitetura, rastreabilidade, indexação, SERP, concorrência, demanda e sinais de confiança.'
  },
  {
    title: 'Arquitetura',
    copy:
      'Desenho de hubs, clusters, taxonomia, templates, dados estruturados e fluxos de linkagem interna.'
  },
  {
    title: 'Prioridade',
    copy:
      'Roadmap por impacto, dependência técnica, custo de execução e oportunidade de ganho orgânico.'
  },
  {
    title: 'Implementação',
    copy:
      'Ajustes técnicos, otimização on-page, melhoria de UX, estrutura semântica e integração com analytics.'
  },
  {
    title: 'Conteúdo',
    copy:
      'Briefings, produção orientada a entidade, EEAT, FAQ, links internos e reforço de páginas comerciais.'
  },
  {
    title: 'Iteração',
    copy:
      'Monitoramento, revisão de resultados, novos experimentos e atualização do plano conforme o mercado muda.'
  }
];

const operatingPanels = [
  {
    title: 'O que entra no plano operacional',
    items: [
      'Hipóteses e oportunidades priorizadas',
      'Backlog técnico com dependência e impacto',
      'Plano de conteúdo e clusterização',
      'Estrutura de medição e eventos críticos',
      'Rotina de revisão com aprendizado documentado'
    ]
  },
  {
    title: 'Como a metodologia conecta o site',
    items: [
      'Artigos suportam páginas de serviço e páginas de nicho',
      'Páginas institucionais reforçam sinais de confiança',
      'Templates comerciais herdam a mesma semântica',
      'Dados estruturados e canonicals saem da mesma base',
      'Cada URL entra com papel claro no cluster'
    ]
  }
];

const faqs = [
  {
    question: 'A metodologia serve só para SEO tradicional?',
    answer:
      'Não. Ela foi desenhada para SEO tradicional, AI Overviews, busca generativa e citações em LLMs. O framework precisa responder ao ecossistema atual, não ao Google de anos atrás.'
  },
  {
    question: 'Vocês executam ou apenas recomendam?',
    answer:
      'A metodologia suporta os dois modelos. Em alguns projetos a AUDITSEO define estratégia e backlog; em outros participa da implementação técnica, editorial e de medição.'
  },
  {
    question: 'Como a prioridade é definida?',
    answer:
      'Por impacto no negócio, risco técnico, dependência entre tarefas, janela de oportunidade e potencial de ganho orgânico. O crítico vem antes do cosmético.'
  },
  {
    question: 'Qual é o papel do conteúdo dentro da metodologia?',
    answer:
      'Conteúdo não entra isolado. Ele é conectado à arquitetura, entidades, links internos, página comercial e critérios de citação para IA.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
};
---
<InstitutionalLayout
  title="Metodologia de SEO e IA da AUDITSEO"
  description="Entenda a metodologia da AUDITSEO para diagnóstico, arquitetura, execução e medição de SEO, AI Overviews, LLMs e busca generativa."
  canonicalPath="/metodologia/"
  imagePath="/og-default.svg"
  breadcrumbs={[
    { label: 'Home', path: '/' },
    { label: 'Metodologia', path: '/metodologia/' }
  ]}
>
  <div class="ee-page">
    <nav class="ee-page-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>›</span>
      <span class="current">Metodologia</span>
    </nav>

    <section class="ee-page-hero">
      <div>
        <span class="ee-page-badge">Framework Operacional</span>
        <h1 class="ee-page-title">
          METODOLOGIA <span class="accent">SEO + IA</span> PARA CRESCER COM ESTRUTURA
        </h1>
        <p class="ee-page-subtitle">
          A metodologia da AUDITSEO combina <strong>diagnóstico técnico</strong>,
          <strong>arquitetura de conteúdo</strong>, <strong>priorização por impacto</strong> e
          <strong>medição contínua</strong>. O objetivo não é produzir mais tarefas. É construir
          um sistema capaz de aumentar cobertura orgânica, fortalecer páginas comerciais e elevar a
          chance da marca aparecer em buscas clássicas e superfícies de IA.
        </p>
        <div class="ee-page-highlights">
          <span class="ee-page-highlight">SEO Técnico</span>
          <span class="ee-page-highlight">Clusters e Entidades</span>
          <span class="ee-page-highlight">AI Overviews</span>
          <span class="ee-page-highlight">Medição e Iteração</span>
        </div>
      </div>
      <aside class="ee-page-hero-card">
        <h2>O que guia o framework</h2>
        <p>Sem diagnóstico, o projeto vira lista de tarefas. Sem prioridade, o backlog trava.</p>
        <p>
          A metodologia organiza cada entrega para que a Home, os serviços, o blog e as páginas de
          nicho operem como um sistema único de crescimento.
        </p>
        <div class="ee-page-links">
          <a href="/servicos/">Ver serviços</a>
          <a href="/blog/">Ver blog</a>
          <a href="/fontes-e-metodos/">Fontes e métodos</a>
        </div>
      </aside>
    </section>

    <section class="ee-page-stats" aria-label="Resumo da metodologia">
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">6</div>
        <div class="ee-page-stat-label">Etapas centrais</div>
        <p class="ee-page-stat-copy">Do diagnóstico inicial à iteração baseada em dados.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">3</div>
        <div class="ee-page-stat-label">Frentes integradas</div>
        <p class="ee-page-stat-copy">Técnico, conteúdo e distribuição de autoridade.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">1</div>
        <div class="ee-page-stat-label">Backlog unificado</div>
        <p class="ee-page-stat-copy">Priorização clara para time interno, parceiro ou squad misto.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">0</div>
        <div class="ee-page-stat-label">Espaço para vaidade</div>
        <p class="ee-page-stat-copy">Toda recomendação precisa justificar impacto real.</p>
      </article>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Princípios</span>
        <h2 class="ee-page-section-title">COMO A AUDITSEO PENSA CADA PROJETO</h2>
        <p class="ee-page-section-subtitle">
          O framework foi desenhado para reduzir improviso, dar previsibilidade e transformar SEO em
          uma operação com critério técnico.
        </p>
      </div>
      <div class="ee-page-grid four">
        {principles.map((item) => (
          <article class="ee-page-card">
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Execução</span>
        <h2 class="ee-page-section-title">AS 6 ETAPAS DO FRAMEWORK</h2>
        <p class="ee-page-section-subtitle">
          A ordem importa. Quando a base é quebrada, conteúdo e campanhas só ampliam o problema.
        </p>
      </div>
      <div class="ee-page-process">
        {processSteps.map((step, index) => (
          <article class="ee-page-step">
            <div class="ee-page-step-number">{String(index + 1).padStart(2, '0')}</div>
            <h3>{step.title}</h3>
            <p>{step.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Operação</span>
        <h2 class="ee-page-section-title">O QUE A METODOLOGIA ENTREGA NA PRÁTICA</h2>
      </div>
      <div class="ee-page-panels">
        {operatingPanels.map((panel) => (
          <article class="ee-page-panel">
            <h3>{panel.title}</h3>
            <ul class="ee-page-list">
              {panel.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">FAQ</span>
        <h2 class="ee-page-section-title">DÚVIDAS COMUNS SOBRE O FRAMEWORK</h2>
      </div>
      <div class="ee-page-faqs">
        {faqs.map((item) => (
          <article class="ee-page-faq">
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-cta">
      <div class="ee-page-cta-box">
        <span class="ee-page-section-badge">Próximo Passo</span>
        <h2 class="ee-page-section-title">QUER APLICAR ESSA METODOLOGIA NO SEU SITE?</h2>
        <p class="ee-page-cta-copy">
          Se a estrutura atual do seu projeto não sustenta crescimento orgânico, o caminho certo é
          organizar diagnóstico, arquitetura, conteúdo e medição sob o mesmo plano.
        </p>
        <div class="ee-page-cta-actions">
          <button type="button" class="ee-page-primary" data-open-cta-modal>
            Solicitar Diagnóstico
          </button>
          <a href="/servicos/ai-overview-optimization/" class="ee-page-secondary">
            Ver serviço de AI Overview
          </a>
        </div>
      </div>
    </section>
  </div>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
</InstitutionalLayout>
