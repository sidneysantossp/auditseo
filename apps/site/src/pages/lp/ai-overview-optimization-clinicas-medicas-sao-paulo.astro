---
import '../../styles/institutional-trust-pages.css';
import LandingLayout from '../../layouts/LandingLayout.astro';

const proofPoints = [
  'Estrutura da página comercial pronta para citação e resposta sintética',
  'Recorte de nicho e cidade para reduzir ruído de mensagem',
  'Conexão entre IA, descoberta local e autoridade da clínica',
  'Blocos de FAQ, prova e CTA pensados para conversão'
];

const fitBlocks = [
  {
    title: 'Clínicas que dependem de descoberta orgânica',
    copy:
      'Quando a captação depende de pacientes pesquisando sintomas, especialidades e tratamentos, a estrutura da página ganha peso real.'
  },
  {
    title: 'Operação em São Paulo',
    copy:
      'Em um mercado mais competitivo, a clareza do recorte local ajuda a reduzir genericidade e melhora a leitura comercial.'
  },
  {
    title: 'Busca por visibilidade em IA',
    copy:
      'Se a clínica quer aumentar a chance de ser entendida e citada nas respostas do Google, a página precisa nascer para isso.'
  }
];

const faqs = [
  {
    question: 'Essa landing page substitui a Home da AUDITSEO?',
    answer:
      'Não. Ela existe para uma combinação comercial específica: serviço, nicho e cidade. A Home continua sendo a porta principal institucional.'
  },
  {
    question: 'Essa combinação faz sentido para qualquer clínica?',
    answer:
      'Não. Ela faz sentido quando existe busca local relevante, serviços bem definidos e necessidade real de reforçar presença em AI Overviews.'
  },
  {
    question: 'Qual o próximo passo se essa landing refletir meu caso?',
    answer:
      'Solicitar um diagnóstico para validar estrutura, oferta, página atual e potencial de citação e descoberta no seu contexto.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
};
---
<LandingLayout
  title="AI Overview Optimization para Clínicas Médicas em São Paulo | AUDITSEO"
  description="Landing page da AUDITSEO para clínicas médicas em São Paulo que precisam melhorar descoberta orgânica, estrutura comercial e chance de citação em AI Overviews."
  canonicalPath="/lp/ai-overview-optimization-clinicas-medicas-sao-paulo/"
  pageType="Service"
  breadcrumbs={[
    { label: 'Home', path: '/' },
    { label: 'Cidades', path: '/cidades/' },
    { label: 'São Paulo', path: '/cidades/sao-paulo/' },
    {
      label: 'AI Overview Optimization para Clínicas Médicas',
      path: '/lp/ai-overview-optimization-clinicas-medicas-sao-paulo/'
    }
  ]}
>
  <div class="ee-page">
    <nav class="ee-page-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>›</span>
      <a href="/cidades/">Cidades</a>
      <span>›</span>
      <a href="/cidades/sao-paulo/">São Paulo</a>
      <span>›</span>
      <span class="current">AI Overview Optimization para Clínicas Médicas</span>
    </nav>

    <section class="ee-page-hero">
      <div>
        <span class="ee-page-badge">Landing de Alta Conversão</span>
        <h1 class="ee-page-title">
          AI OVERVIEW OPTIMIZATION PARA <span class="accent">CLÍNICAS MÉDICAS</span> EM SÃO PAULO
        </h1>
        <p class="ee-page-subtitle">
          Esta landing combina <strong>serviço</strong>, <strong>nicho</strong> e
          <strong> cidade</strong> para uma situação comercial específica: clínicas em São Paulo
          que precisam melhorar descoberta orgânica, clareza comercial e potencial de citação nas
          respostas de IA do Google.
        </p>
        <div class="ee-page-highlights">
          <span class="ee-page-highlight">Serviço + Nicho + Cidade</span>
          <span class="ee-page-highlight">Alta Conversão</span>
          <span class="ee-page-highlight">AI Overviews</span>
          <span class="ee-page-highlight">Clínicas em São Paulo</span>
        </div>
      </div>

      <aside class="ee-page-hero-card">
        <h2>Quando essa landing faz sentido</h2>
        <p>
          Quando a clínica precisa competir por atenção qualificada em busca orgânica e quer uma
          página desenhada para descoberta, citação e contato.
        </p>
        <div class="ee-page-links">
          <a href="/servicos/ai-overview-optimization/">Ver serviço principal</a>
          <a href="/nichos/clinicas-medicas/">Ver nicho</a>
          <a href="/cidades/sao-paulo/">Ver cidade</a>
        </div>
      </aside>
    </section>

    <section class="ee-page-stats" aria-label="Resumo da landing page">
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">3</div>
        <div class="ee-page-stat-label">Camadas combinadas</div>
        <p class="ee-page-stat-copy">Serviço, nicho e cidade na mesma leitura comercial.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">1</div>
        <div class="ee-page-stat-label">Objetivo principal</div>
        <p class="ee-page-stat-copy">Transformar descoberta em diagnóstico qualificado.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">0</div>
        <div class="ee-page-stat-label">Espaço para genericidade</div>
        <p class="ee-page-stat-copy">A página existe para ser específica e útil, não ampla demais.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">100%</div>
        <div class="ee-page-stat-label">Dependência de contexto</div>
        <p class="ee-page-stat-copy">Aqui o contexto comercial pesa mais que volume cru.</p>
      </article>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Aderência</span>
        <h2 class="ee-page-section-title">QUE TIPO DE CLÍNICA MAIS SE BENEFICIA</h2>
      </div>
      <div class="ee-page-grid three">
        {fitBlocks.map((item) => (
          <article class="ee-page-card">
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Entregas</span>
        <h2 class="ee-page-section-title">O QUE ESSA COMBINAÇÃO PRECISA ENTREGAR</h2>
      </div>
      <div class="ee-page-panels">
        <article class="ee-page-panel">
          <h3>Pontos que a landing precisa sustentar</h3>
          <ul class="ee-page-list">
            {proofPoints.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
        <article class="ee-page-panel">
          <h3>CTA comercial</h3>
          <p>
            Se esse contexto reflete sua operação, o próximo passo é validar se a estrutura atual da
            clínica sustenta descoberta local e resposta sintética do Google.
          </p>
          <div class="ee-page-cta-actions">
            <button class="ee-page-primary" type="button" data-open-cta-modal>Solicitar diagnóstico</button>
            <a class="ee-page-secondary" href="/contato/">Falar com a AUDITSEO</a>
          </div>
        </article>
      </div>
    </section>

    <section class="ee-page-section ee-page-faq">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">FAQ</span>
        <h2 class="ee-page-section-title">DÚVIDAS COMUNS SOBRE ESTA LANDING</h2>
      </div>
      <div class="ee-page-faqs">
        {faqs.map((item) => (
          <article class="ee-page-faq">
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </article>
        ))}
      </div>
    </section>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</LandingLayout>
