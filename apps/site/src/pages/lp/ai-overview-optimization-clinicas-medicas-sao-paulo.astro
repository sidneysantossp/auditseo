---
import '../../styles/institutional-trust-pages.css';
import LandingLayout from '../../layouts/LandingLayout.astro';

const proofPoints = [
  'Estrutura da pagina comercial pronta para citacao e resposta sintetica',
  'Recorte de nicho e cidade para reduzir ruido de mensagem',
  'Conexao entre IA, descoberta local e autoridade da clinica',
  'Blocos de FAQ, prova e CTA pensados para conversao'
];

const fitBlocks = [
  {
    title: 'Clinicas que dependem de descoberta organica',
    copy:
      'Quando a captacao depende de pacientes pesquisando sintomas, especialidades e tratamentos, a estrutura da pagina ganha peso real.'
  },
  {
    title: 'Operacao em Sao Paulo',
    copy:
      'Em um mercado mais competitivo, a clareza do recorte local ajuda a reduzir genericidade e melhora a leitura comercial.'
  },
  {
    title: 'Busca por visibilidade em IA',
    copy:
      'Se a clinica quer aumentar a chance de ser entendida e citada nas respostas do Google, a pagina precisa nascer para isso.'
  }
];

const faqs = [
  {
    question: 'Essa landing page substitui a Home da AUDITSEO?',
    answer:
      'Nao. Ela existe para uma combinacao comercial especifica: servico, nicho e cidade. A Home continua sendo a porta principal institucional.'
  },
  {
    question: 'Essa combinacao faz sentido para qualquer clinica?',
    answer:
      'Nao. Ela faz sentido quando existe busca local relevante, servicos bem definidos e necessidade real de reforcar presenca em AI Overviews.'
  },
  {
    question: 'Qual o proximo passo se essa landing refletir meu caso?',
    answer:
      'Solicitar um diagnostico para validar estrutura, oferta, pagina atual e potencial de citacao e descoberta no seu contexto.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
};
---
<LandingLayout
  title="AI Overview Optimization para Clinicas Medicas em Sao Paulo | AUDITSEO"
  description="Landing page da AUDITSEO para clinicas medicas em Sao Paulo que precisam melhorar descoberta organica, estrutura comercial e chance de citacao em AI Overviews."
  canonicalPath="/lp/ai-overview-optimization-clinicas-medicas-sao-paulo/"
  pageType="Service"
  breadcrumbs={[
    { label: 'Home', path: '/' },
    { label: 'Cidades', path: '/cidades/' },
    { label: 'Sao Paulo', path: '/cidades/sao-paulo/' },
    {
      label: 'AI Overview Optimization para Clinicas Medicas',
      path: '/lp/ai-overview-optimization-clinicas-medicas-sao-paulo/'
    }
  ]}
>
  <div class="ee-page">
    <nav class="ee-page-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>›</span>
      <a href="/cidades/">Cidades</a>
      <span>›</span>
      <a href="/cidades/sao-paulo/">Sao Paulo</a>
      <span>›</span>
      <span class="current">AI Overview Optimization para Clinicas Medicas</span>
    </nav>

    <section class="ee-page-hero">
      <div>
        <span class="ee-page-badge">Landing de Alta Conversao</span>
        <h1 class="ee-page-title">
          AI OVERVIEW OPTIMIZATION PARA <span class="accent">CLINICAS MEDICAS</span> EM SAO PAULO
        </h1>
        <p class="ee-page-subtitle">
          Esta landing combina <strong>servico</strong>, <strong>nicho</strong> e
          <strong> cidade</strong> para uma situacao comercial especifica: clinicas em Sao Paulo
          que precisam melhorar descoberta organica, clareza comercial e potencial de citacao nas
          respostas de IA do Google.
        </p>
        <div class="ee-page-highlights">
          <span class="ee-page-highlight">Servico + Nicho + Cidade</span>
          <span class="ee-page-highlight">Alta Conversao</span>
          <span class="ee-page-highlight">AI Overviews</span>
          <span class="ee-page-highlight">Clinicas em Sao Paulo</span>
        </div>
      </div>

      <aside class="ee-page-hero-card">
        <h2>Quando essa landing faz sentido</h2>
        <p>
          Quando a clinica precisa competir por atencao qualificada em busca organica e quer uma
          pagina desenhada para descoberta, citacao e contato.
        </p>
        <div class="ee-page-links">
          <a href="/servicos/ai-overview-optimization/">Ver servico principal</a>
          <a href="/nichos/clinicas-medicas/">Ver nicho</a>
          <a href="/cidades/sao-paulo/">Ver cidade</a>
        </div>
      </aside>
    </section>

    <section class="ee-page-stats" aria-label="Resumo da landing page">
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">3</div>
        <div class="ee-page-stat-label">Camadas combinadas</div>
        <p class="ee-page-stat-copy">Servico, nicho e cidade na mesma leitura comercial.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">1</div>
        <div class="ee-page-stat-label">Objetivo principal</div>
        <p class="ee-page-stat-copy">Transformar descoberta em diagnostico qualificado.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">0</div>
        <div class="ee-page-stat-label">Espaco para genericidade</div>
        <p class="ee-page-stat-copy">A pagina existe para ser especifica e util, nao ampla demais.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">100%</div>
        <div class="ee-page-stat-label">Dependencia de contexto</div>
        <p class="ee-page-stat-copy">Aqui o contexto comercial pesa mais que volume cru.</p>
      </article>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Aderencia</span>
        <h2 class="ee-page-section-title">QUE TIPO DE CLINICA MAIS SE BENEFICIA</h2>
      </div>
      <div class="ee-page-grid three">
        {fitBlocks.map((item) => (
          <article class="ee-page-card">
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Entregas</span>
        <h2 class="ee-page-section-title">O QUE ESSA COMBINACAO PRECISA ENTREGAR</h2>
      </div>
      <div class="ee-page-panels">
        <article class="ee-page-panel">
          <h3>Pontos que a landing precisa sustentar</h3>
          <ul class="ee-page-list">
            {proofPoints.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
        <article class="ee-page-panel">
          <h3>CTA comercial</h3>
          <p>
            Se esse contexto reflete sua operacao, o proximo passo e validar se a estrutura atual da
            clinica sustenta descoberta local e resposta sintetica do Google.
          </p>
          <div class="ee-page-cta-actions">
            <button class="ee-page-primary" type="button" data-open-cta-modal>Solicitar diagnostico</button>
            <a class="ee-page-secondary" href="/contato/">Falar com a AUDITSEO</a>
          </div>
        </article>
      </div>
    </section>

    <section class="ee-page-section ee-page-faq">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">FAQ</span>
        <h2 class="ee-page-section-title">DUVIDAS COMUNS SOBRE ESTA LANDING</h2>
      </div>
      <div class="ee-page-faqs">
        {faqs.map((item) => (
          <article class="ee-page-faq">
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </article>
        ))}
      </div>
    </section>
  </div>

  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
</LandingLayout>
