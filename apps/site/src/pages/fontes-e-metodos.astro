---
import '../styles/institutional-trust-pages.css';
import InstitutionalLayout from '../layouts/InstitutionalLayout.astro';

const evidenceLayers = [
  {
    title: 'Fonte primaria primeiro',
    copy:
      'Documentacao oficial, help centers, comunicados de produto, APIs e guias publicados pela plataforma responsavel pelo recurso.'
  },
  {
    title: 'Experimento proprio em seguida',
    copy:
      'Testes internos, comparacoes de SERP, logs de rastreamento, auditorias e observacao direta do comportamento das paginas.'
  },
  {
    title: 'Fonte secundaria com contexto',
    copy:
      'Usamos analises externas apenas quando ajudam a interpretar o mercado, nunca como substituto da fonte oficial.'
  },
  {
    title: 'Data e escopo sempre claros',
    copy:
      'Toda afirmacao sensivel precisa de contexto: quando foi observada, em que ambiente e com qual limite de confianca.'
  }
];

const validationPanels = [
  {
    title: 'O que aceitamos como base de recomendacao',
    items: [
      'Google Search Central e documentacao oficial do Search Console',
      'Guias oficiais de Google Business Profile quando o tema e local',
      'Documentacao de plataforma quando falamos de crawlers e integracoes',
      'Dados observados em auditoria tecnica e revisados no projeto',
      'Mudancas de SERP ou comportamento confirmadas em ambiente real'
    ]
  },
  {
    title: 'O que evitamos publicar como verdade',
    items: [
      'Estatistica sem fonte ou sem metodologia explicada',
      'Claim absoluto baseado em observacao isolada',
      'Regra universal para nichos e sites com contextos distintos',
      'Promessa de ranking ou prazo sem dependencia tecnica mapeada',
      'Recomendacao copiada de terceiros sem teste ou confrontacao'
    ]
  }
];

const sourceAreas = [
  {
    title: 'Busca e indexacao',
    copy:
      'Usamos documentacao oficial para crawling, indexacao, canonical, sitemaps, robots e rich results.'
  },
  {
    title: 'Busca local',
    copy:
      'Quando o tema envolve mapa, perfis locais e reputacao, a referencia precisa vir de help centers e diretrizes oficiais do produto.'
  },
  {
    title: 'AI e superfícies generativas',
    copy:
      'Priorizamos informacoes publicadas pela propria plataforma ou sinais observados diretamente nas SERPs e interfaces.'
  },
  {
    title: 'Analytics e medicao',
    copy:
      'Recomendacoes precisam bater com a instrumentacao usada no site, nao apenas com teoria editorial.'
  }
];

const faqs = [
  {
    question: 'A AUDITSEO usa estudos de mercado de terceiros?',
    answer:
      'Sim, quando agregam contexto. Mas eles entram como apoio interpretativo, nunca como fonte primaria para recomendacoes tecnicas sensiveis.'
  },
  {
    question: 'Toda estatistica publicada precisa de fonte?',
    answer:
      'Sim. Se a origem ou a metodologia nao forem claras, o dado nao deve virar claim editorial nem argumento comercial.'
  },
  {
    question: 'Como voces lidam com mudancas rapidas no Google?',
    answer:
      'Atualizamos o conteudo quando a documentacao oficial muda, quando a SERP muda de forma consistente ou quando nossos testes indicam um novo padrao.'
  },
  {
    question: 'Fontes internas contam como evidencia?',
    answer:
      'Contam, desde que o contexto seja conhecido, a observacao seja repetivel e a conclusao nao extrapole o escopo do que foi testado.'
  }
];

const faqSchema = {
  '@context': 'https://schema.org',
  '@type': 'FAQPage',
  mainEntity: faqs.map((item) => ({
    '@type': 'Question',
    name: item.question,
    acceptedAnswer: {
      '@type': 'Answer',
      text: item.answer
    }
  }))
};
---
<InstitutionalLayout
  title="Fontes e Metodos da AUDITSEO"
  description="Veja como a AUDITSEO valida fontes, estatisticas, documentacao oficial e experimentos proprios para construir recomendacoes tecnicas confiaveis."
  canonicalPath="/fontes-e-metodos/"
  breadcrumbs={[
    { label: 'Home', path: '/' },
    { label: 'Fontes e Metodos', path: '/fontes-e-metodos/' }
  ]}
>
  <div class="ee-page">
    <nav class="ee-page-breadcrumbs" aria-label="Breadcrumb">
      <a href="/">Home</a>
      <span>›</span>
      <span class="current">Fontes e Metodos</span>
    </nav>

    <section class="ee-page-hero">
      <div>
        <span class="ee-page-badge">Validacao Editorial</span>
        <h1 class="ee-page-title">
          FONTES <span class="accent">PRIMARIAS</span> E METODO DE PROVA
        </h1>
        <p class="ee-page-subtitle">
          Para um site de SEO ser referencia, ele nao pode publicar recomendacao com base em
          intuicao, numero solto ou copia de mercado. Nesta pagina, a AUDITSEO explica como trata
          <strong>documentacao oficial</strong>, <strong>experimentos proprios</strong>,
          <strong>fontes secundarias</strong> e <strong>claims sensiveis</strong> antes de levar
          qualquer conclusao para artigos, paginas de servico e materiais institucionais.
        </p>
        <div class="ee-page-highlights">
          <span class="ee-page-highlight">Google Primeiro</span>
          <span class="ee-page-highlight">Contexto de Data</span>
          <span class="ee-page-highlight">SERP Observada</span>
          <span class="ee-page-highlight">Claim com Evidencia</span>
        </div>
      </div>
      <aside class="ee-page-hero-card">
        <h2>Regra principal</h2>
        <p>Fonte primaria sempre vence interpretacao de mercado quando existe conflito.</p>
        <p>
          A funcao da pagina e reduzir dependencia de referencia inconsistente e tornar cada
          recomendacao mais rastreavel para usuarios, bots e equipes tecnicas.
        </p>
        <div class="ee-page-links">
          <a href="/politica-editorial/">Politica editorial</a>
          <a href="/metodologia/">Metodologia</a>
          <a href="/blog/">Artigos</a>
        </div>
      </aside>
    </section>

    <section class="ee-page-stats" aria-label="Resumo das fontes e metodos">
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">1</div>
        <div class="ee-page-stat-label">Prioridade central</div>
        <p class="ee-page-stat-copy">Fonte oficial antes de interpretacao externa.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">4</div>
        <div class="ee-page-stat-label">Camadas de evidencia</div>
        <p class="ee-page-stat-copy">Fonte, teste, contexto e limite de escopo.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">100%</div>
        <div class="ee-page-stat-label">Claims revisados</div>
        <p class="ee-page-stat-copy">Dado sem origem clara nao entra como argumento.</p>
      </article>
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">0</div>
        <div class="ee-page-stat-label">Tolerancia a rumor</div>
        <p class="ee-page-stat-copy">Hipoteses podem existir, mas nao viram promessa editorial.</p>
      </article>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Hierarquia</span>
        <h2 class="ee-page-section-title">COMO A EVIDENCIA E ORGANIZADA</h2>
      </div>
      <div class="ee-page-grid four">
        {evidenceLayers.map((item) => (
          <article class="ee-page-card">
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Criterio</span>
        <h2 class="ee-page-section-title">O QUE SUSTENTA UMA RECOMENDACAO PUBLICA</h2>
      </div>
      <div class="ee-page-panels">
        {validationPanels.map((panel) => (
          <article class="ee-page-panel">
            <h3>{panel.title}</h3>
            <ul class="ee-page-list">
              {panel.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Cobertura</span>
        <h2 class="ee-page-section-title">AREAS EM QUE O METODO E APLICADO</h2>
      </div>
      <div class="ee-page-grid four">
        {sourceAreas.map((item) => (
          <article class="ee-page-card">
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">FAQ</span>
        <h2 class="ee-page-section-title">DUVIDAS SOBRE FONTES E VALIDACAO</h2>
      </div>
      <div class="ee-page-faqs">
        {faqs.map((item) => (
          <article class="ee-page-faq">
            <h3>{item.question}</h3>
            <p>{item.answer}</p>
          </article>
        ))}
      </div>
    </section>

    <section class="ee-page-cta">
      <div class="ee-page-cta-box">
        <span class="ee-page-section-badge">Transparencia</span>
        <h2 class="ee-page-section-title">QUER AUDITAR AS BASES DO SEU CONTEUDO?</h2>
        <p class="ee-page-cta-copy">
          Se seu site depende de claims fracos, estatisticas vagas ou recomendacoes sem fonte, o
          risco nao e so tecnico. E reputacional.
        </p>
        <div class="ee-page-cta-actions">
          <button type="button" class="ee-page-primary" data-open-cta-modal>
            Solicitar Diagnostico
          </button>
          <a href="/politica-editorial/" class="ee-page-secondary">Ver politica editorial</a>
        </div>
      </div>
    </section>
  </div>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(faqSchema)}></script>
</InstitutionalLayout>
