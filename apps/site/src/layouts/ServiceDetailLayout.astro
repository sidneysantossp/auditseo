---
import BaseLayout from './BaseLayout.astro';
import ServiceCanonicalResources from '../components/ServiceCanonicalResources.astro';
import { serviceCanonicalResourceLinks } from '../data/service-canonical-resource-links';
import ServiceCanonicalTrustSignals from '../components/ServiceCanonicalTrustSignals.astro';
import { serviceCanonicalTrustSignals } from '../data/service-canonical-trust-signals';

const props = Astro.props;
const canonicalPath = (props.canonicalPath ?? Astro.url.pathname) as string;
const resourceGroup = serviceCanonicalResourceLinks[canonicalPath];
const trustGroup = serviceCanonicalTrustSignals[canonicalPath];
---
<BaseLayout {...props}>
  <slot />
  {resourceGroup && <ServiceCanonicalResources group={resourceGroup} />}
  {trustGroup && <ServiceCanonicalTrustSignals group={trustGroup} />}
</BaseLayout>
