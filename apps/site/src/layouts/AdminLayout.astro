---
import SeoHead from '../components/SeoHead.astro';
import AdminTopbar from '../components/admin/AdminTopbar.astro';
import AdminCrmModals from '../components/admin/AdminCrmModals.astro';
import AdminShellScripts from '../components/admin/AdminShellScripts.astro';
import { siteMetadata } from '../data/site';
import '../styles/tokens.css';
import '../styles/admin.css';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
}

const { title, description, eyebrow } = Astro.props as Props;
const currentPath = Astro.url.pathname;
const crmSummaryEndpoint = (() => {
  const captureEndpoint = siteMetadata.forms.crmCaptureEndpoint?.trim();

  if (captureEndpoint) {
    return captureEndpoint.replace(/\/lead-capture\/?$/, '/crm-summary');
  }

  return 'https://auditseo-cms-api.vercel.app/api/public/crm-summary';
})();

const adminConfig = {
  apiBase: null,
  crmSummaryEndpoint
};
---
<!doctype html>
<html lang="pt-BR" dir="ltr">
  <head>
    <SeoHead title={title} description={description} canonicalPath={currentPath} noindex />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bebas+Neue&family=Crimson+Pro:wght@300;400;600;700&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
  </head>
  <body class="admin-body">
    <div class="admin-app">
      <AdminTopbar currentPath={currentPath} />

      <main class="admin-content">
        <section class="admin-page-head">
          <div class="admin-page-head__row">
            <div class="admin-page-head__eyebrow">{eyebrow}</div>
            <span class="admin-page-head__badge">Governança editorial</span>
          </div>
          <h1 class="admin-page-head__title">{title}</h1>
          <p class="admin-page-head__description">{description}</p>
        </section>

        <slot />
      </main>
    </div>

    <AdminCrmModals />
    <AdminShellScripts />
    <script is:inline define:vars={{ adminConfig }}>
      window.__AUDITSEO_ADMIN_CONFIG__ = adminConfig;
    </script>
    <script is:inline type="module" src="/admin-client.js"></script>
    <script is:inline type="module" src="/admin-crm.js"></script>
  </body>
</html>
