---
import SeoHead from '../components/SeoHead.astro';
import AdminSidebar from '../components/admin/AdminSidebar.astro';
import AdminTopbar from '../components/admin/AdminTopbar.astro';
import AdminShellScripts from '../components/admin/AdminShellScripts.astro';
import AdminAuthGate from '../components/admin/AdminAuthGate.astro';
import '../styles/tokens.css';
import '../styles/admin.css';

interface Props {
  title: string;
  description: string;
  eyebrow: string;
}

const { title, description, eyebrow } = Astro.props as Props;
const currentPath = Astro.url.pathname;
---
<!doctype html>
<html lang="pt-BR" dir="ltr">
  <head>
    <SeoHead title={title} description={description} canonicalPath={currentPath} noindex />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&family=JetBrains+Mono:wght@400;500;600;700&display=swap"
      rel="stylesheet"
    />
    <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js"></script>
  </head>
  <body class="admin-body">
    <div class="admin-app">
      <button class="admin-mobile-toggle" type="button" data-admin-toggle aria-label="Abrir menu administrativo">
        Menu
      </button>

      <AdminSidebar currentPath={currentPath} />

      <div class="admin-main">
        <AdminTopbar eyebrow={eyebrow} title={title} description={description} />

        <main class="admin-content">
          <slot />
        </main>
      </div>
    </div>

    <AdminAuthGate />
    <AdminShellScripts />
    <script is:inline type="module" src="/admin-client.js"></script>
  </body>
</html>
