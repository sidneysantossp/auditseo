---
import type { ServiceCanonicalOperationalProof as ServiceCanonicalOperationalProofData } from '../data/service-canonical-operational-proof';

interface Props {
  group: ServiceCanonicalOperationalProofData;
}

const { group } = Astro.props as Props;
---
<section class="service-canonical-proof">
  <div class="container-shell">
    <div class="service-canonical-proof__head">
      <span class="section-eyebrow">{group.eyebrow}</span>
      <h2 class="service-canonical-proof__title">{group.title}</h2>
      <p class="service-canonical-proof__copy">{group.copy}</p>
    </div>

    <div class="service-canonical-proof__grid">
      {group.cards.map((card) => (
        <article class="service-canonical-proof__card">
          <span class="service-canonical-proof__label">{card.label}</span>
          <h3>{card.title}</h3>
          <p>{card.copy}</p>
          <ul>
            {card.items.map((item) => (
              <li>{item}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>

    <div class="service-canonical-proof__signals">
      {group.signals.map((signal) => (
        <span>{signal}</span>
      ))}
    </div>
  </div>
</section>

<style>
  .service-canonical-proof {
    padding: 0 0 6rem;
  }

  .service-canonical-proof__head {
    max-width: 58rem;
    margin-bottom: 2rem;
  }

  .service-canonical-proof__title {
    margin: 1rem 0;
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(2.8rem, 6vw, 4.9rem);
    line-height: 0.95;
    letter-spacing: 0.03em;
    color: var(--text-light);
  }

  .service-canonical-proof__copy {
    max-width: 46rem;
    color: var(--text-muted);
    font-size: 1.08rem;
  }

  .service-canonical-proof__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-bottom: 1rem;
  }

  .service-canonical-proof__card {
    padding: 1.9rem;
    border: 1px solid var(--border-soft);
    background: rgba(14, 14, 16, 0.92);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.2);
  }

  .service-canonical-proof__label {
    display: inline-flex;
    margin-bottom: 0.85rem;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--accent-gold);
  }

  .service-canonical-proof__card h3 {
    margin: 0 0 0.85rem;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2rem;
    line-height: 0.98;
    letter-spacing: 0.03em;
    color: var(--text-light);
  }

  .service-canonical-proof__card p {
    margin: 0 0 1rem;
    color: var(--text-muted);
  }

  .service-canonical-proof__card ul {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 0.7rem;
  }

  .service-canonical-proof__card li {
    position: relative;
    padding-left: 1rem;
    color: var(--text-soft);
  }

  .service-canonical-proof__card li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.52rem;
    width: 0.38rem;
    height: 0.38rem;
    border-radius: 999px;
    background: var(--accent-strong);
  }

  .service-canonical-proof__signals {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .service-canonical-proof__signals span {
    min-height: 2.5rem;
    padding: 0 1rem;
    display: inline-flex;
    align-items: center;
    border: 1px solid var(--border-soft);
    background: rgba(16, 16, 18, 0.85);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--accent-gold);
  }

  @media (max-width: 960px) {
    .service-canonical-proof__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
