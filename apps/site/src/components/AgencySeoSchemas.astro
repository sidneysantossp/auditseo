---
import { siteMetadata } from '../data/site';

const canonicalPath = '/agencia-de-seo/';
const canonicalUrl = new URL(canonicalPath, siteMetadata.siteUrl).toString();

const faqItems = [
  {
    name: 'Quanto custa contratar uma agencia de SEO?',
    text: 'O investimento varia de R$ 2.000 a R$ 15.000 por mes, dependendo do escopo e competitividade. Na AUDITSEO, projetos comecam a partir de R$ 3.000 por mes.'
  },
  {
    name: 'Quanto tempo demora para ver resultados?',
    text: 'Primeiros resultados costumam aparecer entre 3 e 6 meses, com crescimento mais consistente entre 6 e 12 meses.'
  },
  {
    name: 'O que uma agencia de SEO faz?',
    text: 'Auditoria tecnica, pesquisa de palavras-chave, otimizacao on-page, conteudo estrategico, link building etico e monitoramento continuo de rankings, trafego e conversoes.'
  },
  {
    name: 'Qual a diferenca da AUDITSEO?',
    text: 'A AUDITSEO prepara a marca para Google, AI Overviews, LLMs e busca por voz, com uma metodologia AI-First atualizada para a nova busca.'
  },
  {
    name: 'SEO vale mais que Google Ads?',
    text: 'As duas estrategias se complementam. Ads acelera resultados imediatos; SEO constroi crescimento organico sustentavel com acumulacao de autoridade.'
  },
  {
    name: 'O que e AI SEO?',
    text: 'AI SEO e a evolucao do SEO para aumentar a chance da marca aparecer em AI Overviews, LLMs e experiencias de busca generativa.'
  }
];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'ProfessionalService',
      '@id': `${canonicalUrl}#localbusiness`,
      name: siteMetadata.legalName,
      url: canonicalUrl,
      description:
        'Agencia de SEO em Sao Paulo especializada em Search Intelligence AI, AI Overviews, SEO Local e presenca em LLMs.',
      telephone: siteMetadata.contact.phone,
      email: siteMetadata.contact.email,
      address: {
        '@type': 'PostalAddress',
        streetAddress: siteMetadata.address.street,
        addressLocality: siteMetadata.address.city,
        addressRegion: siteMetadata.address.state,
        postalCode: siteMetadata.address.zip,
        addressCountry: 'BR'
      },
      areaServed: {
        '@type': 'Country',
        name: 'Brasil'
      }
    },
    {
      '@type': 'Service',
      '@id': `${canonicalUrl}#service`,
      name: 'Consultoria SEO AI-First',
      serviceType: 'SEO Consulting',
      provider: {
        '@id': `${canonicalUrl}#localbusiness`
      },
      areaServed: {
        '@type': 'Country',
        name: 'Brasil'
      },
      description:
        'Consultoria SEO especializada em SEO tecnico, AI Overviews, LLMs, SEO Local e busca generativa.'
    },
    {
      '@type': 'FAQPage',
      '@id': `${canonicalUrl}#faq`,
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.name,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.text
        }
      }))
    }
  ]
};
---
<script is:inline type="application/ld+json" set:html={JSON.stringify(schema)}></script>
