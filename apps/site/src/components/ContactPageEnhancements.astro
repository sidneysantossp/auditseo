---
import { siteMetadata } from '../data/site';
---
<script is:inline define:vars={{ contactEndpoint: siteMetadata.forms.diagnosticEndpoint }}>
  (() => {
    const form = document.getElementById('contact-page-form');
    const success = document.getElementById('contact-form-success');
    const submitButton = document.getElementById('contact-form-submit');
    const submitText = submitButton?.querySelector('[data-submit-text]');
    const submitLoading = submitButton?.querySelector('[data-submit-loading]');

    if (!(form instanceof HTMLFormElement) || !success || !(submitButton instanceof HTMLButtonElement)) {
      return;
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();

      if (!form.reportValidity()) return;

      submitButton.disabled = true;
      if (submitText instanceof HTMLElement) submitText.hidden = true;
      if (submitLoading instanceof HTMLElement) submitLoading.hidden = false;

      const payload = Object.fromEntries(new FormData(form).entries());
      const context = window.auditseoAttribution?.getContext?.() ?? null;
      payload._subject = 'Novo contato pelo site - AUDITSEO';
      payload._captcha = 'false';
      payload.Pagina_Atual = context?.pagePath ?? window.location.pathname;
      payload.URL_Atual = context?.pageUrl ?? window.location.href;
      payload.Titulo_Pagina = context?.pageTitle ?? document.title;
      payload.Primeira_Pagina_Sessao = context?.firstLandingUrl ?? window.location.href;
      payload.Referrer = context?.referrer ?? (document.referrer || 'direto');

      if (context?.utm) {
        Object.entries(context.utm).forEach(([key, value]) => {
          payload[key.toUpperCase()] = value;
        });
      }

      try {
        const response = await fetch(contactEndpoint, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json'
          },
          body: JSON.stringify(payload)
        });

        if (!response.ok) {
          throw new Error('Falha ao enviar o formulario de contato.');
        }

        try {
          await window.auditseoLeadCapture?.send?.({
            captureType: 'contact-form',
            channel: 'form',
            name: payload.Nome,
            email: payload.Email,
            company: payload.Empresa,
            site: payload.Site,
            message: payload.Mensagem
          });
        } catch (captureError) {
          console.error('Contact lead capture error', captureError);
        }

        form.reset();
        form.hidden = true;
        success.hidden = false;
      } catch (error) {
        console.error(error);
        window.alert('Nao foi possivel enviar agora. Tente novamente em instantes.');
        submitButton.disabled = false;
        if (submitText instanceof HTMLElement) submitText.hidden = false;
        if (submitLoading instanceof HTMLElement) submitLoading.hidden = true;
      }
    });
  })();
</script>
