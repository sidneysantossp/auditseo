---
import type { ServiceCanonicalDecisionLayer as ServiceCanonicalDecisionLayerData } from '../data/service-canonical-decision-layer';

interface Props {
  layer: ServiceCanonicalDecisionLayerData;
}

const { layer } = Astro.props as Props;
---
<section class="service-canonical-decision">
  <div class="container-shell">
    <div class="service-canonical-decision__head">
      <span class="section-eyebrow">{layer.eyebrow}</span>
      <h2 class="service-canonical-decision__title">{layer.title}</h2>
      <p class="service-canonical-decision__copy">{layer.copy}</p>
    </div>

    <div class="service-canonical-decision__grid">
      {layer.objections.map((item) => (
        <article class="service-canonical-decision__card">
          <h3>{item.title}</h3>
          <p>{item.copy}</p>
        </article>
      ))}
    </div>

    <div class="service-canonical-decision__cta">
      <span class="section-eyebrow">{layer.ctaEyebrow}</span>
      <h3>{layer.ctaTitle}</h3>
      <p>{layer.ctaCopy}</p>
      <div class="service-canonical-decision__cta-grid">
        {layer.ctaCards.map((card) => (
          <article class="service-canonical-decision__cta-card">
            <h4>{card.title}</h4>
            <ul>
              {card.items.map((item) => (
                <li>{item}</li>
              ))}
            </ul>
          </article>
        ))}
      </div>
      <div class="service-canonical-decision__actions">
        <button type="button" data-open-cta-modal>Solicitar diagnóstico</button>
        <a href={layer.secondaryPath}>{layer.secondaryLabel}</a>
      </div>
    </div>
  </div>
</section>

<style>
  .service-canonical-decision {
    padding: 0 0 6rem;
  }

  .service-canonical-decision__head {
    max-width: 56rem;
    margin-bottom: 2rem;
  }

  .service-canonical-decision__title {
    margin: 1rem 0;
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(2.8rem, 6vw, 4.9rem);
    line-height: 0.95;
    letter-spacing: 0.03em;
    color: var(--text-light);
  }

  .service-canonical-decision__copy {
    max-width: 44rem;
    color: var(--text-muted);
    font-size: 1.08rem;
  }

  .service-canonical-decision__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .service-canonical-decision__card,
  .service-canonical-decision__cta {
    padding: 2rem;
    border: 1px solid var(--border-soft);
    background: rgba(14, 14, 16, 0.92);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.2);
  }

  .service-canonical-decision__card h3,
  .service-canonical-decision__cta h3 {
    margin: 0 0 0.85rem;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2rem;
    line-height: 0.98;
    letter-spacing: 0.03em;
    color: var(--text-light);
  }

  .service-canonical-decision__card p,
  .service-canonical-decision__cta p {
    margin: 0;
    color: var(--text-muted);
  }

  .service-canonical-decision__actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.85rem;
    margin-top: 1.25rem;
  }

  .service-canonical-decision__cta-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
    margin-top: 1.5rem;
  }

  .service-canonical-decision__cta-card {
    padding: 1.5rem;
    border: 1px solid var(--border-soft);
    background: rgba(10, 10, 12, 0.75);
  }

  .service-canonical-decision__cta-card h4 {
    margin: 0 0 0.85rem;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.7rem;
    line-height: 0.98;
    letter-spacing: 0.03em;
    color: var(--text-light);
  }

  .service-canonical-decision__cta-card ul {
    margin: 0;
    padding-left: 1.1rem;
    color: var(--text-muted);
  }

  .service-canonical-decision__cta-card li + li {
    margin-top: 0.85rem;
  }

  .service-canonical-decision__actions button,
  .service-canonical-decision__actions a {
    min-height: 3.4rem;
    padding: 0 1.4rem;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    border: 1px solid transparent;
    text-decoration: none;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.78rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    cursor: pointer;
  }

  .service-canonical-decision__actions button {
    background: var(--gradient-fire);
    color: #050505;
  }

  .service-canonical-decision__actions a {
    border-color: var(--border-soft);
    color: var(--text-light);
    background: transparent;
  }

  @media (max-width: 960px) {
    .service-canonical-decision__grid,
    .service-canonical-decision__cta-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
