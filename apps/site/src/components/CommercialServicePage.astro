function getIntentOrderedLinks() {
  const deduped = new Map<string, (typeof page.relatedLinks)[number]>();

  for (const item of page.relatedLinks) {
    if (!deduped.has(item.path)) {
      deduped.set(item.path, item);
    }
  }

  return [...deduped.values()].sort((left, right) => getLinkScore(right) - getLinkScore(left));
}

function getLinkScore(link: (typeof page.relatedLinks)[number]) {
  const text = `${link.label} ${link.reason} ${link.path}`.toLowerCase();
  let score = 0;

  if (page.brief.pageType === 'sectoral-anchor') {
    if (/quanto-custa|em-quanto-tempo|vale-a-pena|como-funciona|agencia|consultoria|auditoria/.test(text)) score += 7;
    if (/apoio bofu/.test(text)) score += 6;
    if (/setorial-mãe|setorial mae|serviço canônico|servico canonico/.test(text)) score += 5;
    if (/contexto geográfico principal|contexto geografico principal/.test(text)) score += 3;
    if (text.includes('/blog/')) score += 2;
  } else if (page.brief.pageType === 'regional-bridge') {
    if (/apoio bofu/.test(text)) score += 7;
    if (/contexto geográfico principal|contexto geografico principal/.test(text)) score += 6;
    if (/setorial-mãe|setorial mae|serviço canônico|servico canonico/.test(text)) score += 5;
    if (/complemento local|ponte regional/.test(text)) score += 4;
  } else {
    if (/apoio bofu local/.test(text)) score += 8;
    if (/complemento local/.test(text)) score += 7;
    if (/contexto geográfico principal|contexto geografico principal/.test(text)) score += 6;
    if (/setorial-mãe|setorial mae/.test(text)) score += 5;
    if (/serviço canônico|servico canonico/.test(text)) score += 4;
    if (text.includes(page.areaServedName.toLowerCase())) score += 3;
  }

  if (link.path.startsWith('/blog/')) score += 1;
  if (link.path.startsWith('/servicos/')) score += 1;

  return score;
}

