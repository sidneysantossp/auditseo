---
import '../styles/institutional-trust-pages.css';
import '../styles/commercial-service-pages.css';
import type { ServiceFirstCommercialPage } from '../data/service-first-commercial-pages';
import { serviceFirstLocalOperationalProof } from '../data/service-first-local-operational-proof';

interface Props {
  page: ServiceFirstCommercialPage;
}

const { page } = Astro.props as Props;
const displayTitle = page.displayTitle ?? page.brief.pageTitle;
const coreOffer = page.coreOffer ?? page.brief.coreOffer;
const painPoints = page.painPoints ?? page.brief.painPoints;
const ctaPrimaryLabel = page.ctaPrimaryLabel ?? page.brief.ctaPrimary;
const objectionItems = page.faqItems.slice(0, 3);
const isLocalCommercialPage = page.brief.pageType === 'local-commercial';
const verticalContext = getVerticalContext();
const cityContext = getCityContext();
const localCityLink =
  page.relatedLinks.find((item) => item.label === page.areaServedName || item.reason.includes('Contexto geográfico principal')) ?? null;
const localBofuLink = page.relatedLinks.find((item) => item.reason.includes('Apoio BOFU local')) ?? null;
const localComplementLink = page.relatedLinks.find((item) => item.reason.includes('Complemento local')) ?? null;
const localSectorLink = page.relatedLinks.find((item) => item.reason.includes('setorial-mãe') || item.reason.includes('setorial mae')) ?? null;
const operationalProofOverride = serviceFirstLocalOperationalProof[page.slug] ?? null;
const institutionalProofLinks = [
  {
    label: 'Metodologia',
    title: `Como a AUDITSEO estrutura ${displayTitle.toLowerCase()}`,
    copy: 'Mostra a lógica comercial, técnica e de priorização usada para esta frente.',
    path: '/metodologia/'
  },
  {
    label: 'Fontes e métodos',
    title: 'Como validamos fontes, critério e raciocínio',
    copy: 'Explica como a camada editorial evita conteúdo genérico e deriva página a partir de contexto real.',
    path: '/fontes-e-metodos/'
  },
  {
    label: 'Autor',
    title: 'Quem responde pela camada estratégica',
    copy: 'Conecta a página à autoria, especialidade e responsabilidade editorial.',
    path: '/autores/sidney-santos/'
  },
  {
    label: 'Contato',
    title: 'Canal direto para diagnóstico comercial',
    copy: 'Se a operação já tem contexto suficiente, o próximo passo pode ser avançar para um diagnóstico.',
    path: '/contato/'
  }
];
const localProofCards = isLocalCommercialPage
  ? [
      {
        label: 'Praça',
        title: `${page.areaServedName} entra como mercado próprio`,
        copy: cityContext.marketRole,
        path: localCityLink?.path ?? null,
        linkLabel: localCityLink ? `Abrir ${page.areaServedName}` : null
      },
      {
        label: 'BOFU local',
        title: 'Existe apoio editorial específico para a cidade',
        copy: `A jornada local de ${verticalContext.marketLabel} não depende só da página comercial. Ela também é sustentada por conteúdo de decisão aderente à mesma praça.`,
        path: localBofuLink?.path ?? null,
        linkLabel: localBofuLink?.label ?? null
      },
      {
        label: 'Complemento',
        title: 'A página conversa com o ativo local complementar',
        copy: cityContext.complementRole,
        path: localComplementLink?.path ?? null,
        linkLabel: localComplementLink?.label ?? null
      },
      {
        label: 'Vertical',
        title: 'A praça continua ligada à tese setorial-mãe',
        copy: `A cidade não foi isolada da estratégia. Ela reforça a mesma tese de ${verticalContext.marketLabel}, preservando hierarquia e evitando canibalização.`,
        path: localSectorLink?.path ?? null,
        linkLabel: localSectorLink?.label ?? null
      }
    ]
  : [];
const operationalProofEyebrow = operationalProofOverride?.eyebrow ?? 'Prova operacional';
const operationalProofTitle = operationalProofOverride?.title ?? 'COMO ESSA FRENTE É CONDUZIDA NA PRÁTICA';
const operationalProofCopy =
  operationalProofOverride?.copy ??
  'Aqui a prova não depende de case público antigo. Ela aparece na forma como a AUDITSEO lê contexto, organiza ativos e transforma a página em decisão operacional.';
const operationalProofCards = operationalProofOverride?.cards ?? getOperationalProofCards();
const operationalSignals = operationalProofOverride?.signals ?? getOperationalSignals();
function getFitSignals() {
  if (page.brief.pageType === 'sectoral-anchor') {
    return [
      `Quando ${verticalContext.marketLabel} depende de busca orgânica e descoberta local para gerar novos contatos.`,
      'Quando o site ainda está institucional demais e não tem páginas suficientes para capturar intenção comercial.',
      `Quando ${verticalContext.supportSystem} precisam operar como o mesmo sistema.`
    ];
  }

  if (page.brief.pageType === 'regional-bridge') {
    return [
      'Quando a região já funciona como uma praça comercial reconhecível pela operação.',
      'Quando existem cidades prioritárias abaixo dessa camada ou plano real para abri-las.',
      'Quando a narrativa regional ajuda a reduzir dispersão entre várias páginas locais próximas.'
    ];
  }

  return [
    `Quando ${page.areaServedName} já participa da geração de demanda e a cidade influencia a decisão do cliente.`,
    `Quando a operação precisa alinhar ${verticalContext.localPrimaryAsset}, ativo local complementar e descoberta no Google.`,
    'Quando a meta é gerar contatos locais melhores sem depender exclusivamente de mídia paga.'
  ];
}

function getDeflectionSignals() {
  if (page.brief.pageType === 'sectoral-anchor') {
    return [
      'Se a dúvida principal ainda é preço, prazo ou modelo de contratação, a entrada correta pode ser um artigo BOFU e não a página setorial.',
      'Se o problema real é diagnóstico técnico, talvez auditoria SEO faça mais sentido do que abrir uma frente setorial imediatamente.',
      `Se a operação ainda não trata ${verticalContext.demandCore} como canal comercial, esta página pode entrar cedo demais.`
    ];
  }

  if (page.brief.pageType === 'regional-bridge') {
    return [
      'Se a operação ainda não validou cidades prioritárias, a camada regional pode entrar cedo demais.',
      'Se a região não tem proposta comercial distinta, a página tende a parecer apenas uma agregação geográfica.',
      'Se a dúvida principal é local e imediata, a entrada correta pode ser uma cidade específica e não a região.'
    ];
  }

  return [
    'Se a cidade ainda não participa da aquisição de clientes, abrir uma página local agora pode gerar ruído.',
    `Se a expectativa é resultado imediato sem alinhar ${verticalContext.localPrimaryAsset}, perfil local e contexto comercial, a página entra com premissa errada.`,
    'Se a dúvida principal ainda é setorial e não geográfica, a vertical-mãe pode ser a entrada melhor neste momento.'
  ];
}
const fitSignals = getFitSignals();
const deflectionSignals = getDeflectionSignals();
const decisionStartLinks = page.relatedLinks.slice(0, 3);

function getOperationalProofCards() {
  if (page.brief.pageType === 'sectoral-anchor') {
    return [
      {
        label: 'Leitura',
        title: 'O que entra na leitura da vertical',
        copy: `A página setorial de ${verticalContext.marketLabel} não nasce de volume. Ela nasce da combinação entre demanda, contexto comercial e arquitetura da oferta.`,
        items: [
          verticalContext.readingBullets[0],
          verticalContext.readingBullets[1],
          'Separação entre intenção setorial, intenção local e conteúdo de apoio.',
          `Leitura dos ativos que precisam existir para ${verticalContext.marketLabel} fechar negócio.`
        ]
      },
      {
        label: 'Estrutura',
        title: 'Quais ativos passam a andar juntos',
        copy: `A frente setorial só ganha força quando a página principal organiza ${verticalContext.supportSystem.toLowerCase()} dentro do mesmo sistema comercial.`,
        items: page.deliveryItems.slice(0, 3)
      },
      {
        label: 'Gestão',
        title: 'Como a decisão evolui depois da leitura',
        copy: `A operação deixa de tratar ${verticalContext.demandCore} como canal isolado e passa a priorizar com mais clareza o que realmente precisa entrar.`,
        items: [
          'Definição das próximas páginas locais ou comerciais derivadas.',
          'Uso de BOFU e FAQ para filtrar objeções antes do contato.',
          'Critério para expandir sem sobrepor página setorial e página local.'
        ]
      }
    ];
  }

  if (page.brief.pageType === 'regional-bridge') {
    return [
      {
        label: 'Região',
        title: 'Como a camada regional é validada',
        copy: 'A região só entra quando tem papel comercial próprio e quando ajuda a organizar cidades próximas sob uma mesma lógica.',
        items: [
          `Leitura de ${page.areaServedName} como mercado com dinâmica própria.`,
          'Separação entre página regional, páginas locais e vertical-mãe.',
          'Filtro para evitar que a região vire agregação geográfica sem função.'
        ]
      },
      {
        label: 'Ativos',
        title: 'O que precisa sustentar a ponte regional',
        copy: 'A camada regional só funciona quando deriva de ativos já coerentes e ajuda a organizar a expansão.',
        items: page.deliveryItems.slice(0, 3)
      },
      {
        label: 'Decisão',
        title: 'Como a expansão é mantida sob controle',
        copy: 'A utilidade da página regional está em reduzir dispersão, não em multiplicar variações de URL.',
        items: [
          'Clareza sobre quando abrir cidade específica e quando manter a região.',
          'Vínculo com a vertical principal e com os recursos BOFU corretos.',
          'Critério para priorizar as próximas praças sem canibalização.'
        ]
      }
    ];
  }

  return [
    {
      label: 'Praça',
      title: `Como ${page.areaServedName} entra nesta operação`,
      copy: `A página local só existe porque ${page.areaServedName} muda a decisão comercial, a descoberta orgânica e o tipo de ativo que precisa sustentar ${verticalContext.marketLabel}.`,
      items: [
        cityContext.localBullets[0],
        cityContext.localBullets[1],
        'Filtro para a cidade não virar apenas uma derivação da página principal.'
      ]
    },
    {
      label: 'Ativos',
      title: 'Quais peças precisam operar juntas',
      copy: `A página local precisa conversar com a vertical-mãe, ${verticalContext.localPrimaryAsset} e os recursos de decisão corretos.`,
      items: page.deliveryItems.slice(0, 3)
    },
    {
      label: 'Gestão',
      title: 'O que passa a ser acompanhado com critério',
      copy: `A decisão local melhora quando a operação entende o papel de ${page.areaServedName} e protege a coerência entre os ativos que sustentam ${verticalContext.marketLabel}.`,
      items: [
        'Consistência entre página local, ativo complementar e conteúdo BOFU.',
        cityContext.localBullets[2],
        'Próximos movimentos de expansão guiados pela mesma lógica comercial.'
      ]
    }
  ];
}

function getOperationalSignals() {
  if (page.brief.pageType === 'sectoral-anchor') {
    return ['Vertical-mãe', verticalContext.signal, 'BOFU comercial', 'Expansão controlada'];
  }

  if (page.brief.pageType === 'regional-bridge') {
    return ['Ponte regional', 'Praças derivadas', 'Hierarquia geográfica', 'Decisão de expansão'];
  }

  return [page.areaServedName, verticalContext.signal, 'Ativo local', 'BOFU aderente'];
}

function getVerticalContext() {
  const slug = page.slug;

  if (slug.includes('clinicas-medicas')) {
    return {
      marketLabel: 'clínicas médicas',
      demandCore: 'busca por especialidade, unidade e agendamento',
      supportSystem: 'SEO local, Google Maps e páginas por especialidade',
      localPrimaryAsset: 'página comercial da cidade',
      signal: 'Saúde privada',
      readingBullets: [
        'Mapeamento da demanda por especialidade, tratamento e unidade.',
        'Leitura da jornada entre descoberta local, confiança clínica e contato.'
      ]
    };
  }

  if (slug.includes('dermatologistas')) {
    return {
      marketLabel: 'dermatologia',
      demandCore: 'busca por tratamento, autoridade e proximidade',
      supportSystem: 'SEO local, páginas de tratamento e Google Maps',
      localPrimaryAsset: 'página local da especialidade',
      signal: 'Especialidade premium',
      readingBullets: [
        'Mapeamento da demanda por tratamento, procedimento e intenção estética ou clínica.',
        'Leitura da relação entre autoridade local, clareza de oferta e decisão rápida.'
      ]
    };
  }

  if (slug.includes('odontologia')) {
    return {
      marketLabel: 'odontologia',
      demandCore: 'busca por procedimento, proximidade e agendamento',
      supportSystem: 'SEO local, páginas de procedimento e Google Maps',
      localPrimaryAsset: 'página local da clínica odontológica',
      signal: 'Procedimentos locais',
      readingBullets: [
        'Mapeamento da demanda por procedimento, especialidade e urgência de contato.',
        'Leitura da jornada entre busca local, prova e facilidade de conversão.'
      ]
    };
  }

  if (slug.includes('escritorios-de-advocacia')) {
    return {
      marketLabel: 'escritórios de advocacia',
      demandCore: 'busca por área de atuação, confiança e contexto jurídico',
      supportSystem: 'páginas por área, autoridade local e conteúdo de decisão',
      localPrimaryAsset: 'página comercial da área jurídica na praça',
      signal: 'Serviço consultivo',
      readingBullets: [
        'Mapeamento da demanda por área de atuação, tipo de problema e contexto da busca.',
        'Leitura da relação entre confiança, clareza jurídica e qualificação do contato.'
      ]
    };
  }

  if (slug.includes('software-b2b')) {
    return {
      marketLabel: 'software B2B',
      demandCore: 'busca por categoria, solução, comparação e pipeline',
      supportSystem: 'páginas de solução, comparativos e conteúdo de decisão',
      localPrimaryAsset: 'página comercial da solução na praça',
      signal: 'Pipeline qualificado',
      readingBullets: [
        'Mapeamento da demanda por categoria, caso de uso e comparação entre soluções.',
        'Leitura da jornada entre descoberta orgânica, consideração e geração de pipeline.'
      ]
    };
  }

  if (slug.includes('energia-solar')) {
    return {
      marketLabel: 'energia solar',
      demandCore: 'busca por solução, economia, confiança e avaliação comercial',
      supportSystem: 'páginas de solução, prova comercial e conteúdo comparativo',
      localPrimaryAsset: 'página comercial da solução por praça',
      signal: 'Jornada consultiva',
      readingBullets: [
        'Mapeamento da demanda por solução, economia e estágio da jornada consultiva.',
        'Leitura da relação entre prova comercial, clareza de oferta e geração de demanda.'
      ]
    };
  }

  return {
    marketLabel: 'essa frente comercial',
    demandCore: 'busca orgânica qualificada',
    supportSystem: 'página comercial, ativos locais e conteúdo de apoio',
    localPrimaryAsset: 'página comercial principal',
    signal: 'Busca comercial',
    readingBullets: [
      'Mapeamento da demanda principal da vertical.',
      'Leitura da relação entre descoberta, consideração e contato.'
    ]
  };
}

function getCityContext() {
  const city = page.areaServedName;

  const base = {
    marketRole: `${city} entra aqui como contexto comercial real, com função própria dentro da arquitetura local da vertical.`,
    complementRole:
      'A operação local fica mais sólida quando página principal e ativo complementar sustentam a mesma intenção sem competir entre si.',
    localBullets: [
      `Leitura de ${city} como contexto real de aquisição.`,
      'Separação entre demanda geográfica, demanda setorial e dúvida de contratação.',
      'Critério para reforçar a praça sem inflar promessas ou páginas repetidas.'
    ]
  };

  if (city === 'São Paulo') {
    return {
      marketRole:
        'São Paulo entra como praça de alta competição e alta densidade de demanda, exigindo página local com mais precisão de oferta, prova e recorte comercial.',
      complementRole:
        'Na capital, a operação local fica mais sólida quando página principal e ativo complementar sustentam a mesma intenção sem competir entre si.',
      localBullets: [
        'Leitura de São Paulo como praça de competição orgânica mais intensa e demanda mais fragmentada.',
        'Separação entre busca por vertical, busca por bairro ou região e busca puramente local.',
        'Critério para reforçar a capital sem virar uma variação genérica da vertical-mãe.'
      ]
    };
  }

  if (city === 'Rio de Janeiro') {
    return {
      marketRole:
        'O Rio de Janeiro entra como praça em que contexto local, confiança e clareza de oferta pesam cedo na decisão comercial.',
      complementRole:
        'No Rio, a operação local fica mais forte quando página principal e ativo complementar sustentam a mesma intenção com contexto comercial claro.',
      localBullets: [
        'Leitura do Rio de Janeiro como praça em que contexto local influencia fortemente a triagem da demanda.',
        'Separação entre busca por especialidade, descoberta local e dúvidas de contratação.',
        'Critério para reforçar a cidade sem diluir o papel comercial da vertical.'
      ]
    };
  }

  if (city === 'Belo Horizonte') {
    return {
      marketRole:
        'Belo Horizonte entra como praça em que clareza de proposta, confiança e contexto geográfico ajudam a qualificar melhor a descoberta orgânica.',
      complementRole:
        'Em Belo Horizonte, a página principal ganha força quando o ativo complementar reforça a mesma leitura comercial da praça.',
      localBullets: [
        'Leitura de Belo Horizonte como praça em que contexto regional e proximidade ainda pesam cedo na decisão.',
        'Separação entre busca local, vertical comercial e conteúdo de decisão de apoio.',
        'Critério para reforçar a cidade sem inflar variações desnecessárias.'
      ]
    };
  }

  if (city === 'Curitiba') {
    return {
      marketRole:
        'Curitiba entra como praça em que disciplina de oferta, clareza e coerência entre ativos locais tende a pesar mais na qualidade do contato.',
      complementRole:
        'Em Curitiba, a operação local ganha força quando página principal e ativo complementar reforçam a mesma proposta de valor sem ruído.',
      localBullets: [
        'Leitura de Curitiba como praça que responde melhor a estrutura comercial coerente do que à copy genérica.',
        'Separação entre contexto da cidade, intenção setorial e conteúdo de apoio para decisão.',
        'Critério para expandir a praça mantendo clareza e hierarquia entre os ativos.'
      ]
    };
  }

  if (city === 'Brasília') {
    return {
      marketRole:
        'Brasília entra como praça em que busca qualificada e leitura institucional costumam ter peso maior na percepção de confiança da operação.',
      complementRole:
        'Em Brasília, a página principal fica mais sólida quando o ativo complementar reforça a mesma leitura institucional e comercial.',
      localBullets: [
        'Leitura de Brasília como praça em que clareza de posicionamento e confiança institucional pesam cedo.',
        'Separação entre busca local, busca por serviço e conteúdo que filtra objeção de contratação.',
        'Critério para reforçar a praça sem romper a coerência com a vertical-mãe.'
      ]
    };
  }

  if (city === 'Porto Alegre') {
    return {
      marketRole:
        'Porto Alegre entra como praça em que a consistência entre página, oferta e prova tende a influenciar mais a qualidade do contato.',
      complementRole:
        'Em Porto Alegre, a operação local fica mais sólida quando página principal e ativo complementar reforçam a mesma lógica de decisão.',
      localBullets: [
        'Leitura de Porto Alegre como praça em que contexto local e coerência de oferta ajudam a filtrar melhor a demanda.',
        'Separação entre busca por vertical, busca local e dúvida de contratação.',
        'Critério para reforçar a cidade sem multiplicar páginas frágeis.'
      ]
    };
  }

  if (city === 'Campinas') {
    return {
      marketRole:
        'Campinas entra como praça com densidade empresarial própria, exigindo página local que conecte vertical, cidade e prova comercial com mais precisão.',
      complementRole:
        'Em Campinas, a operação local ganha força quando ativo complementar e página principal sustentam a mesma intenção comercial.',
      localBullets: [
        'Leitura de Campinas como praça própria e não apenas derivação da capital.',
        'Separação entre busca local, busca regional e vertical setorial.',
        'Critério para expandir a praça mantendo uma hierarquia geográfica limpa.'
      ]
    };
  }

  if (city === 'São José dos Campos') {
    return {
      marketRole:
        'São José dos Campos entra como praça em que contexto local e filtro de intenção ajudam a tornar a busca mais qualificada e menos genérica.',
      complementRole:
        'Em São José dos Campos, a operação local ganha mais força quando a página principal conversa com o ativo complementar sem competir pela mesma função.',
      localBullets: [
        'Leitura de São José dos Campos como praça em que recorte local melhora a qualidade da descoberta.',
        'Separação entre demanda local, demanda setorial e conteúdo de apoio para decisão.',
        'Critério para expandir a cidade com páginas realmente justificadas.'
      ]
    };
  }

  if (city === 'Grande São Paulo') {
    return {
      marketRole:
        'Grande São Paulo entra como ponte regional válida quando ajuda a organizar várias praças próximas sob uma mesma lógica comercial.',
      complementRole:
        'Na Grande São Paulo, a operação regional fica mais forte quando ativo complementar e página principal deixam claro o papel da região frente às cidades.',
      localBullets: [
        'Leitura da Grande São Paulo como camada regional com função própria dentro da expansão.',
        'Separação entre papel da região, papel da capital e papel das cidades derivadas.',
        'Critério para sustentar a região sem transformar a página em agregação vazia.'
      ]
    };
  }

  return base;
}

const breadcrumbs = [
  { label: 'Home', path: '/' },
  { label: 'Serviços', path: '/servicos/' },
  { label: displayTitle, path: page.slug }
];
---
<div class="ee-page ee-commercial-page">
  <nav class="ee-page-breadcrumbs" aria-label="Breadcrumb">
    {breadcrumbs.map((item, index) => (
      <>
        {index > 0 && <span>›</span>}
        {index < breadcrumbs.length - 1 ? <a href={item.path}>{item.label}</a> : <span class="current">{item.label}</span>}
      </>
    ))}
  </nav>

  <section class="ee-page-hero">
    <div>
      <span class="ee-page-badge">{page.badge}</span>
      <h1 class="ee-page-title">
        {page.heroTitlePrefix}
        <span class="accent">{page.heroTitleAccent}</span>
        {page.heroTitleSuffix ? ` ${page.heroTitleSuffix}` : ''}
      </h1>
      <p class="ee-page-subtitle">{page.heroSubtitle}</p>
      <div class="ee-page-highlights">
        {page.highlights.map((item) => (
          <span class="ee-page-highlight">{item}</span>
        ))}
      </div>
    </div>

    <aside class="ee-page-hero-card">
      <h2>{page.heroCard.title}</h2>
      <p>{page.heroCard.copy}</p>
      <div class="ee-page-links">
        {page.heroCard.links.map((link) => (
          <a href={link.path}>{link.label}</a>
        ))}
      </div>
    </aside>
  </section>

  <section class="ee-page-stats" aria-label={`Resumo da página ${displayTitle}`}>
    {page.stats.map((stat) => (
      <article class="ee-page-stat">
        <div class="ee-page-stat-value">{stat.value}</div>
        <div class="ee-page-stat-label">{stat.label}</div>
        <p class="ee-page-stat-copy">{stat.copy}</p>
      </article>
    ))}
  </section>

  <section class="ee-page-section">
    <div class="ee-page-section-head">
      <span class="ee-page-section-badge">Mercado</span>
      <h2 class="ee-page-section-title">POR QUE ESSA BUSCA PRECISA DE UMA PÁGINA PRÓPRIA</h2>
    </div>
    <div class="ee-page-grid three">
      {page.marketCards.map((item) => (
        <article class="ee-page-card">
          <h3>{item.title}</h3>
          <p>{item.copy}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="ee-page-section">
    <div class="ee-page-section-head">
      <span class="ee-page-section-badge">Qualificação</span>
      <h2 class="ee-page-section-title">QUANDO ESTA PÁGINA É A ENTRADA CERTA</h2>
      <p class="ee-page-section-subtitle">
        Esta camada filtra expectativa errada antes do contato comercial e mostra quando a decisão deveria começar em outro ativo da arquitetura.
      </p>
    </div>
    <div class="ee-commercial-fit-grid">
      <article class="ee-page-panel">
        <h3>Faz sentido agora quando...</h3>
        <ul class="ee-page-list">
          {fitSignals.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </article>
      <article class="ee-page-panel">
        <h3>A entrada pode ser outra quando...</h3>
        <ul class="ee-page-list">
          {deflectionSignals.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </article>
      <article class="ee-page-panel">
        <h3>Se a dúvida estiver em outro ponto, comece aqui</h3>
        <ul class="ee-page-list">
          {decisionStartLinks.map((item) => (
            <li>
              <a class="ee-page-inline-link" href={item.path}>
                {item.label}
              </a>
              <div class="ee-commercial-link-reason">{item.reason}</div>
            </li>
          ))}
        </ul>
      </article>
    </div>
  </section>

  <section class="ee-page-section">
    <div class="ee-page-section-head">
      <span class="ee-page-section-badge">Entrega</span>
      <h2 class="ee-page-section-title">COMO A AUDITSEO ESTRUTURA ESSA FRENTE COMERCIAL</h2>
      <p class="ee-page-section-subtitle">{coreOffer}</p>
    </div>
    <div class="ee-page-panels">
      <article class="ee-page-panel">
        <h3>Dores mais comuns</h3>
        <ul class="ee-page-list">
          {painPoints.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </article>
      <article class="ee-page-panel">
        <h3>Entregas mais importantes</h3>
        <ul class="ee-page-list">
          {page.deliveryItems.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </article>
    </div>
  </section>

  <section class="ee-page-section">
    <div class="ee-page-section-head">
      <span class="ee-page-section-badge">Método</span>
      <h2 class="ee-page-section-title">COMO A OPERAÇÃO EVOLUI SEM PERDER FOCO COMERCIAL</h2>
    </div>
    <div class="ee-commercial-process">
      {page.methodSteps.map((step, index) => (
        <article class="ee-page-step">
          <div class="ee-page-step-number">{String(index + 1).padStart(2, '0')}</div>
          <h3>{step.title}</h3>
          <p>{step.copy}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="ee-page-section">
    <div class="ee-page-section-head">
      <span class="ee-page-section-badge">{operationalProofEyebrow}</span>
      <h2 class="ee-page-section-title">{operationalProofTitle}</h2>
      <p class="ee-page-section-subtitle">{operationalProofCopy}</p>
    </div>
    <div class="ee-commercial-operational-grid">
      {operationalProofCards.map((item) => (
        <article class="ee-page-panel ee-commercial-operational-card">
          <span class="ee-page-badge">{item.label}</span>
          <h3>{item.title}</h3>
          <p>{item.copy}</p>
          <ul class="ee-page-list">
            {item.items.map((entry) => (
              <li>{entry}</li>
            ))}
          </ul>
        </article>
      ))}
    </div>
    <div class="ee-commercial-operational-signals">
      {operationalSignals.map((item) => (
        <span>{item}</span>
      ))}
    </div>
  </section>

  <section class="ee-page-section">
    <div class="ee-page-section-head">
      <span class="ee-page-section-badge">Prova</span>
      <h2 class="ee-page-section-title">POR QUE ESSA PÁGINA NÃO É UMA DERIVAÇÃO GENÉRICA</h2>
    </div>
    <div class="ee-commercial-proof-grid">
      <article class="ee-page-panel">
        <h3>Diferenciais da AUDITSEO</h3>
        <ul class="ee-page-list">
          {page.differentiators.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </article>
      <article class="ee-page-panel">
        <h3>Ativos de prova aceitos aqui</h3>
        <ul class="ee-page-list">
          {page.proofPoints.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </article>
      <article class="ee-page-panel">
        <h3>Recursos relacionados</h3>
        <ul class="ee-page-list">
          {page.relatedLinks.map((item) => (
            <li>
              <a class="ee-page-inline-link" href={item.path}>
                {item.label}
              </a>
              <div class="ee-commercial-link-reason">{item.reason}</div>
            </li>
          ))}
        </ul>
      </article>
    </div>
  </section>

  <section class="ee-page-section">
    <div class="ee-page-section-head">
      <span class="ee-page-section-badge">Objeções</span>
      <h2 class="ee-page-section-title">O QUE NORMALMENTE ATRASA ESSA DECISÃO</h2>
      <p class="ee-page-section-subtitle">
        Antes do contato comercial, estas costumam ser as travas mais recorrentes para este tipo de contratação.
      </p>
    </div>
    <div class="ee-commercial-objection-grid">
      {objectionItems.map((item) => (
        <article class="ee-page-card ee-commercial-objection-card">
          <h3>{item.question}</h3>
          <p>{item.answer}</p>
        </article>
      ))}
    </div>
  </section>

  <section class="ee-page-section">
    <div class="ee-page-section-head">
      <span class="ee-page-section-badge">Base institucional</span>
      <h2 class="ee-page-section-title">CAMADA DE CONFIANÇA QUE SUSTENTA A OFERTA</h2>
    </div>
    <div class="ee-commercial-proof-rail">
      {institutionalProofLinks.map((item) => (
        <article class="ee-page-panel ee-commercial-proof-rail-card">
          <span class="ee-page-badge">{item.label}</span>
          <h3>{item.title}</h3>
          <p>{item.copy}</p>
          <a class="ee-page-inline-link" href={item.path}>
            Abrir página
          </a>
        </article>
      ))}
    </div>
  </section>

  {localProofCards.length > 0 && (
    <section class="ee-page-section">
      <div class="ee-page-section-head">
        <span class="ee-page-section-badge">Prova local</span>
        <h2 class="ee-page-section-title">COMO ESTA PRAÇA ENTRA NA ARQUITETURA COMERCIAL</h2>
        <p class="ee-page-section-subtitle">
          A cidade não aparece aqui como adereço. Ela entra como camada comercial própria, com apoio editorial e ligação clara com a vertical.
        </p>
      </div>
      <div class="ee-commercial-local-proof-grid">
        {localProofCards.map((item) => (
          <article class="ee-page-panel ee-commercial-local-proof-card">
            <span class="ee-page-badge">{item.label}</span>
            <h3>{item.title}</h3>
            <p>{item.copy}</p>
            {item.path && item.linkLabel && (
              <a class="ee-page-inline-link" href={item.path}>
                {item.linkLabel}
              </a>
            )}
          </article>
        ))}
      </div>
    </section>
  )}

  <section class="faq-section" id="faq">
    <div class="faq-container">
      <div class="section-header" style="text-align: center; margin-bottom: 3rem;">
        <span class="section-label" style="justify-content: center;">PERGUNTAS FREQUENTES</span>
        <h2 class="section-title">
          Dúvidas sobre<br />
          {displayTitle}?
        </h2>
      </div>

      <div class="faq-list">
        {page.faqItems.map((item) => (
          <div class="faq-item">
            <button class="faq-question" onclick="toggleFaq(this)" aria-expanded="false">
              <span class="faq-question-text">{item.question}</span>
              <span class="faq-question-icon">+</span>
            </button>
            <div class="faq-answer">
              <p>{item.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="ee-page-cta">
    <div class="ee-page-cta-box">
      <span class="ee-page-section-badge">Próximo passo</span>
      <h2 class="ee-page-section-title">{page.ctaTitle}</h2>
      <p class="ee-page-cta-copy">{page.ctaCopy}</p>
      <div class="ee-page-cta-actions">
        <button class="ee-page-primary" type="button" data-open-cta-modal>{ctaPrimaryLabel}</button>
        <a class="ee-page-secondary" href={page.ctaSecondaryPath}>{page.ctaSecondaryLabel}</a>
      </div>
    </div>
  </section>
</div>
