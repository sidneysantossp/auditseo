---
import '../styles/institutional-trust-pages.css';
import '../styles/commercial-service-pages.css';
import type { ServiceFirstCommercialPage } from '../data/service-first-commercial-pages';
import { serviceFirstLocalOperationalProof } from '../data/service-first-local-operational-proof';

interface Props {
  page: ServiceFirstCommercialPage;
}

const { page } = Astro.props as Props;
const displayTitle = page.displayTitle ?? page.brief.pageTitle;
const coreOffer = page.coreOffer ?? page.brief.coreOffer;
const painPoints = page.painPoints ?? page.brief.painPoints;
const ctaPrimaryLabel = page.ctaPrimaryLabel ?? page.brief.ctaPrimary;
const isLocalCommercialPage = page.brief.pageType === 'local-commercial';
const verticalContext = getVerticalContext();
const cityContext = getCityContext();
const localCityLink =
  page.relatedLinks.find((item) => item.label === page.areaServedName || item.reason.includes('Contexto geográfico principal')) ?? null;
const localBofuLink = page.relatedLinks.find((item) => item.reason.includes('Apoio BOFU local')) ?? null;
const localComplementLink = page.relatedLinks.find((item) => item.reason.includes('Complemento local')) ?? null;
const localSectorLink = page.relatedLinks.find((item) => item.reason.includes('setorial-mãe') || item.reason.includes('setorial mae')) ?? null;
const operationalProofOverride = serviceFirstLocalOperationalProof[page.slug] ?? null;
const institutionalProofLinks = [
  {
    label: 'Metodologia',
    title: `Como a AUDITSEO estrutura ${displayTitle.toLowerCase()}`,
    copy: 'Mostra a lógica comercial, técnica e de priorização usada para esta frente.',
    path: '/metodologia/'
  },
  {
    label: 'Fontes e métodos',
    title: 'Como validamos fontes, critério e raciocínio',
    copy: 'Explica como a camada editorial evita conteúdo genérico e deriva página a partir de contexto real.',
    path: '/fontes-e-metodos/'
  },
  {
    label: 'Autor',
    title: 'Quem responde pela camada estratégica',
    copy: 'Conecta a página à autoria, especialidade e responsabilidade editorial.',
    path: '/autores/sidney-santos/'
  },
  {
    label: 'Contato',
    title: 'Canal direto para diagnóstico comercial',
    copy: 'Se a operação já tem contexto suficiente, o próximo passo pode ser avançar para um diagnóstico.',
    path: '/contato/'
  }
];
const localProofCards = isLocalCommercialPage
  ? [
      {
        label: 'Praça',
        title: `${page.areaServedName} entra como mercado próprio`,
        copy: cityContext.marketRole,
        path: localCityLink?.path ?? null,
        linkLabel: localCityLink ? `Abrir ${page.areaServedName}` : null
      },
      {
        label: 'BOFU local',
        title: 'Existe apoio editorial específico para a cidade',
        copy: `A jornada local de ${verticalContext.marketLabel} não depende só da página comercial. Ela também é sustentada por conteúdo de decisão aderente à mesma praça.`,
        path: localBofuLink?.path ?? null,
        linkLabel: localBofuLink?.label ?? null
      },
      {
        label: 'Complemento',
        title: 'A página conversa com o ativo local complementar',
        copy: cityContext.complementRole,
        path: localComplementLink?.path ?? null,
        linkLabel: localComplementLink?.label ?? null
      },
      {
        label: 'Vertical',
        title: 'A praça continua ligada à tese setorial-mãe',
        copy: `A cidade não foi isolada da estratégia. Ela reforça a mesma tese de ${verticalContext.marketLabel}, preservando hierarquia e evitando canibalização.`,
        path: localSectorLink?.path ?? null,
        linkLabel: localSectorLink?.label ?? null
      }
    ]
  : [];
const operationalProofEyebrow = operationalProofOverride?.eyebrow ?? 'Prova operacional';
const operationalProofTitle = operationalProofOverride?.title ?? 'COMO ESSA FRENTE É CONDUZIDA NA PRÁTICA';
const operationalProofCopy =
  operationalProofOverride?.copy ??
  'Aqui a prova não depende de case público antigo. Ela aparece na forma como a AUDITSEO lê contexto, organiza ativos e transforma a página em decisão operacional.';
const operationalProofCards = operationalProofOverride?.cards ?? getOperationalProofCards();
const operationalSignals = operationalProofOverride?.signals ?? getOperationalSignals();
function getFitSignals() {
  if (page.brief.pageType === 'sectoral-anchor') {
    return [
      `Quando ${verticalContext.marketLabel} depende de busca orgânica e descoberta local para gerar novos contatos.`,
      'Quando o site ainda está institucional demais e não tem páginas suficientes para capturar intenção comercial.',
      `Quando ${verticalContext.supportSystem} precisam operar como o mesmo sistema.`
    ];
  }

  if (page.brief.pageType === 'regional-bridge') {
    return [
      'Quando a região já funciona como uma praça comercial reconhecível pela operação.',
      'Quando existem cidades prioritárias abaixo dessa camada ou plano real para abri-las.',
      'Quando a narrativa regional ajuda a reduzir dispersão entre várias páginas locais próximas.'
    ];
  }

  return [
    `Quando ${page.areaServedName} já participa da geração de demanda e a cidade influencia a decisão do cliente.`,
    `Quando a operação precisa alinhar ${verticalContext.localPrimaryAsset}, ativo local complementar e descoberta no Google.`,
    'Quando a meta é gerar contatos locais melhores sem depender exclusivamente de mídia paga.'
  ];
}

function getDeflectionSignals() {
  if (page.brief.pageType === 'sectoral-anchor') {
    return [
      'Se a dúvida principal ainda é preço, prazo ou modelo de contratação, a entrada correta pode ser um artigo BOFU e não a página setorial.',
      'Se o problema real é diagnóstico técnico, talvez auditoria SEO faça mais sentido do que abrir uma frente setorial imediatamente.',
      `Se a operação ainda não trata ${verticalContext.demandCore} como canal comercial, esta página pode entrar cedo demais.`
    ];
  }

  if (page.brief.pageType === 'regional-bridge') {
    return [
      'Se a operação ainda não validou cidades prioritárias, a camada regional pode entrar cedo demais.',
      'Se a região não tem proposta comercial distinta, a página tende a parecer apenas uma agregação geográfica.',
      'Se a dúvida principal é local e imediata, a entrada correta pode ser uma cidade específica e não a região.'
    ];
  }

  return [
    'Se a cidade ainda não participa da aquisição de clientes, abrir uma página local agora pode gerar ruído.',
    `Se a expectativa é resultado imediato sem alinhar ${verticalContext.localPrimaryAsset}, perfil local e contexto comercial, a página entra com premissa errada.`,
    'Se a dúvida principal ainda é setorial e não geográfica, a vertical-mãe pode ser a entrada melhor neste momento.'
  ];
}
const fitSignals = getFitSignals();
const deflectionSignals = getDeflectionSignals();
const intentOrderedLinks = getIntentOrderedLinks();
const decisionStartLinks = intentOrderedLinks.slice(0, 3);
const proofResourceLinks = intentOrderedLinks.slice(0, 5);
const decisionObjectionItems = getDecisionObjectionItems();
const sectoralIntakeLayer = page.brief.pageType === 'sectoral-anchor' ? getSectoralIntakeLayer() : null;
const localIntakeLayer = isLocalCommercialPage ? getLocalIntakeLayer() : null;
const finalCtaLayer = getFinalCtaLayer();

type DecisionObjectionItem = {
  title: string;
  copy: string;
};

type PageIntakeLayer = {
  title: string;
  copy: string;
  prepareItems: string[];
  receiveItems: string[];
  disqualifiers: string[];
};

type FinalCtaCard = {
  title: string;
  items: string[];
};

type FinalCtaLayer = {
  eyebrow: string;
  cards: FinalCtaCard[];
};

function getFinalCtaLayer(): FinalCtaLayer {
  if (page.brief.pageType === 'sectoral-anchor') {
    return {
      eyebrow: 'Próximo passo',
      cards: [
        {
          title: 'Esse contato vale mais quando...',
          items: [
            `A operação quer transformar ${verticalContext.demandCore} em aquisição mais previsível.`,
            'Já existe clareza mínima sobre serviço, mercado e objetivo comercial.',
            'O time quer decidir arquitetura e prioridade, não só pedir orçamento genérico.'
          ]
        },
        {
          title: 'O primeiro escopo normalmente cobre...',
          items: [
            `Leitura da vertical, páginas mais críticas e ativos que precisam entrar primeiro.`,
            'Direção entre serviço canônico, páginas derivadas e apoio BOFU.',
            'Sinal mais claro de timing, dependências e próximo ciclo de execução.'
          ]
        },
        {
          title: 'Talvez outro ativo venha antes se...',
          items: [
            'A dúvida principal ainda for preço, prazo ou modelo de contratação.',
            'O gargalo real ainda for técnico e pedir diagnóstico antes da expansão.',
            'A operação ainda não souber que recorte setorial deveria sustentar a frente.'
          ]
        }
      ]
    };
  }

  if (page.brief.pageType === 'regional-bridge') {
    return {
      eyebrow: 'Próximo passo regional',
      cards: [
        {
          title: 'Esse contato vale mais quando...',
          items: [
            `A região ${page.areaServedName} já funciona como mercado reconhecível para a operação.`,
            'Existem cidades prioritárias abaixo dessa camada ou plano real para abri-las.',
            'A página regional precisa ordenar expansão, não apenas aumentar cobertura geográfica.'
          ]
        },
        {
          title: 'O primeiro escopo normalmente cobre...',
          items: [
            'Validação do papel da região dentro da arquitetura comercial.',
            'Separação entre camada regional, cidades derivadas e vertical principal.',
            'Critério de expansão sem canibalização entre região e cidades.'
          ]
        },
        {
          title: 'Talvez outro ativo venha antes se...',
          items: [
            'A operação ainda não validou as cidades que deveriam puxar essa camada.',
            'A região ainda não tem proposta comercial própria.',
            'O melhor ponto de entrada ainda é uma cidade específica ou a vertical-mãe.'
          ]
        }
      ]
    };
  }

  return {
    eyebrow: 'Próximo passo local',
    cards: [
      {
        title: 'Esse contato vale mais quando...',
        items: [
          `${page.areaServedName} já participa da aquisição e merece leitura própria dentro de ${verticalContext.marketLabel}.`,
          `A operação quer alinhar ${verticalContext.localPrimaryAsset}, ativo complementar e contexto da praça na mesma conversa.`,
          'O objetivo é qualificar melhor a demanda local e não só aumentar cobertura geográfica.'
        ]
      },
      {
        title: 'O primeiro escopo normalmente cobre...',
        items: [
          `Papel de ${page.areaServedName} dentro da arquitetura comercial da vertical.`,
          'Ativos que precisam ser reforçados primeiro para a praça fazer sentido.',
          'Próximos passos de página, ativo complementar e apoio BOFU local.'
        ]
      },
      {
        title: 'Talvez outro ativo venha antes se...',
        items: [
          `A praça ${page.areaServedName} ainda não foi validada como contexto real de aquisição.`,
          'O problema principal ainda está no serviço canônico ou na vertical-mãe, e não na cidade.',
          'A expectativa está concentrada em resultado imediato sem estrutura comercial mínima.'
        ]
      }
    ]
  };
}

function getOperationalProofCards() {
  if (page.brief.pageType === 'sectoral-anchor') {
    return [
      {
        label: 'Leitura',
        title: 'O que entra na leitura da vertical',
        copy: `A página setorial de ${verticalContext.marketLabel} não nasce de volume. Ela nasce da combinação entre demanda, contexto comercial e arquitetura da oferta.`,
        items: [
          verticalContext.readingBullets[0],
          verticalContext.readingBullets[1],
          'Separação entre intenção setorial, intenção local e conteúdo de apoio.',
          `Leitura dos ativos que precisam existir para ${verticalContext.marketLabel} fechar negócio.`
        ]
      },
      {
        label: 'Estrutura',
        title: 'Quais ativos passam a andar juntos',
        copy: `A frente setorial só ganha força quando a página principal organiza ${verticalContext.supportSystem.toLowerCase()} dentro do mesmo sistema comercial.`,
        items: page.deliveryItems.slice(0, 3)
      },
      {
        label: 'Gestão',
        title: 'Como a decisão evolui depois da leitura',
        copy: `A operação deixa de tratar ${verticalContext.demandCore} como canal isolado e passa a priorizar com mais clareza o que realmente precisa entrar.`,
        items: [
          'Definição das próximas páginas locais ou comerciais derivadas.',
          'Uso de BOFU e FAQ para filtrar objeções antes do contato.',
          'Critério para expandir sem sobrepor página setorial e página local.'
        ]
      }
    ];
  }

  if (page.brief.pageType === 'regional-bridge') {
    return [
      {
        label: 'Região',
        title: 'Como a camada regional é validada',
        copy: 'A região só entra quando tem papel comercial próprio e quando ajuda a organizar cidades próximas sob uma mesma lógica.',
        items: [
          `Leitura de ${page.areaServedName} como mercado com dinâmica própria.`,
          'Separação entre página regional, páginas locais e vertical-mãe.',
          'Filtro para evitar que a região vire agregação geográfica sem função.'
        ]
      },
      {
        label: 'Ativos',
        title: 'O que precisa sustentar a ponte regional',
        copy: 'A camada regional só funciona quando deriva de ativos já coerentes e ajuda a organizar a expansão.',
        items: page.deliveryItems.slice(0, 3)
      },
      {
        label: 'Decisão',
        title: 'Como a expansão é mantida sob controle',
        copy: 'A utilidade da página regional está em reduzir dispersão, não em multiplicar variações de URL.',
        items: [
          'Clareza sobre quando abrir cidade específica e quando manter a região.',
          'Vínculo com a vertical principal e com os recursos BOFU corretos.',
          'Critério para priorizar as próximas praças sem canibalização.'
        ]
      }
    ];
  }

  return [
    {
      label: 'Praça',
      title: `Como ${page.areaServedName} entra nesta operação`,
      copy: `A página local só existe porque ${page.areaServedName} muda a decisão comercial, a descoberta orgânica e o tipo de ativo que precisa sustentar ${verticalContext.marketLabel}.`,
      items: [
        cityContext.localBullets[0],
        cityContext.localBullets[1],
        'Filtro para a cidade não virar apenas uma derivação da página principal.'
      ]
    },
    {
      label: 'Ativos',
      title: 'Quais peças precisam operar juntas',
      copy: `A página local precisa conversar com a vertical-mãe, ${verticalContext.localPrimaryAsset} e os recursos de decisão corretos.`,
      items: page.deliveryItems.slice(0, 3)
    },
    {
      label: 'Gestão',
      title: 'O que passa a ser acompanhado com critério',
      copy: `A decisão local melhora quando a operação entende o papel de ${page.areaServedName} e protege a coerência entre os ativos que sustentam ${verticalContext.marketLabel}.`,
      items: [
        'Consistência entre página local, ativo complementar e conteúdo BOFU.',
        cityContext.localBullets[2],
        'Próximos movimentos de expansão guiados pela mesma lógica comercial.'
      ]
    }
  ];
}

function getOperationalSignals() {
  if (page.brief.pageType === 'sectoral-anchor') {
    return ['Vertical-mãe', verticalContext.signal, 'BOFU comercial', 'Expansão controlada'];
  }

  if (page.brief.pageType === 'regional-bridge') {
    return ['Ponte regional', 'Praças derivadas', 'Hierarquia geográfica', 'Decisão de expansão'];
  }

  return [page.areaServedName, verticalContext.signal, 'Ativo local', 'BOFU aderente'];
}

function getSectoralIntakeLayer() {
  if (page.slug.includes('clinicas-medicas')) {
    return {
      title: 'COMO ENTRAR NESTA VERTICAL COM MAIS CLAREZA',
      copy:
        'Na saúde privada, a conversa comercial precisa começar com clareza sobre especialidades, unidades e papel real da busca local. O objetivo aqui é filtrar contexto antes do diagnóstico.',
      prepareItems: [
        'Especialidades, unidades e serviços que mais deveriam gerar contato hoje.',
        'Quais cidades já participam da aquisição e onde a clínica sente mais perda de demanda.',
        'Leitura honesta do papel atual do site, Google Maps e páginas por especialidade.'
      ],
      receiveItems: [
        'Hipótese inicial de como separar página setorial, páginas locais e páginas por especialidade.',
        'Sinal mais claro sobre o que precisa entrar primeiro para melhorar descoberta e contato.',
        'Leitura mais objetiva de timing, escopo e prioridades comerciais da vertical.'
      ],
      disqualifiers: [
        'Se a clínica ainda não sabe quais especialidades ou unidades deveriam ser priorizadas.',
        'Se a expectativa é depender só de blog ou só de mídia para resolver descoberta orgânica.',
        'Se a operação ainda não reconhece busca local como parte real da captação.'
      ]
    };
  }

  if (page.slug.includes('dermatologistas')) {
    return {
      title: 'COMO ENTRAR NA DERMATOLOGIA SEM RUÍDO',
      copy:
        'Dermatologia exige muito mais precisão de oferta e de contexto do que outras verticais. A conversa inicial precisa separar tratamento, praça e objetivo comercial com mais nitidez.',
      prepareItems: [
        'Tratamentos ou frentes que mais deveriam puxar demanda qualificada.',
        'Quais cidades ou bairros concentram a disputa principal hoje.',
        'Como o site, o perfil local e a mensagem comercial estão distribuídos hoje.'
      ],
      receiveItems: [
        'Leitura inicial do que precisa ser setorial, local e BOFU na mesma arquitetura.',
        'Critério mais claro para priorizar páginas de tratamento, cidade e especialidade.',
        'Sinal de quais ruídos hoje atrapalham confiança e descoberta comercial.'
      ],
      disqualifiers: [
        'Se a clínica espera competir só com copy genérica e reputação social.',
        'Se ainda não existe clareza sobre quais tratamentos sustentam melhor a frente.',
        'Se a busca local ainda não é tratada como parte da decisão do paciente.'
      ]
    };
  }

  if (page.slug.includes('odontologia')) {
    return {
      title: 'COMO ENTRAR NA ODONTOLOGIA COM RECORTE CERTO',
      copy:
        'Em odontologia, proximidade, procedimento e velocidade de decisão entram muito cedo. A triagem precisa deixar claro o que é vertical, o que é local e o que é urgência comercial.',
      prepareItems: [
        'Procedimentos e especialidades que mais deveriam puxar agenda.',
        'Praças prioritárias e contexto local que mais pesa na decisão.',
        'Como site, Google Maps e páginas de procedimento estão operando hoje.'
      ],
      receiveItems: [
        'Direção inicial para separar página setorial, páginas locais e páginas de procedimento.',
        'Leitura mais clara de quais ativos ajudam mais a converter primeiro.',
        'Critério para priorizar expansão sem sobrepor intenção entre páginas.'
      ],
      disqualifiers: [
        'Se a operação ainda não sabe quais procedimentos deveriam puxar a frente comercial.',
        'Se a expectativa é resolver a descoberta só com ajustes em Google Maps.',
        'Se ainda falta clareza mínima sobre cidade, oferta e proposta principal.'
      ]
    };
  }

  if (page.slug.includes('cirurgia-plastica')) {
    return {
      title: 'COMO ENTRAR EM CIRURGIA PLÁSTICA COM MAIS PRECISÃO',
      copy:
        'Em cirurgia plástica, a conversa inicial precisa separar procedimento, praça e proposta premium com nitidez. Sem isso, a página perde força comercial e a triagem começa errada.',
      prepareItems: [
        'Procedimentos ou frentes que mais deveriam gerar consulta qualificada.',
        'Praças ou bairros onde a competição pesa mais cedo na decisão.',
        'Como site, prova local e Google Maps estão distribuídos hoje.'
      ],
      receiveItems: [
        'Direção inicial para separar página setorial, páginas locais e páginas por procedimento.',
        'Leitura mais clara dos ativos que precisam reforçar descoberta e confiança primeiro.',
        'Critério para expandir a vertical sem sobrepor intenção entre páginas.'
      ],
      disqualifiers: [
        'Se a clínica ainda não sabe quais procedimentos ou frentes deveriam puxar a frente comercial.',
        'Se a expectativa é competir só com estética visual, social ou reputação difusa.',
        'Se a busca local ainda não é tratada como parte real da decisão do paciente.'
      ]
    };
  }

  if (page.slug.includes('escritorios-de-advocacia')) {
    return {
      title: 'COMO ENTRAR NA ADVOCACIA COM DEMANDA MAIS QUALIFICADA',
      copy:
        'Na advocacia, a primeira conversa precisa separar área de atuação, praça e objetivo comercial. Sem isso, a página vira institucional e perde função de aquisição.',
      prepareItems: [
        'Áreas do direito que mais precisam gerar consulta ou reunião qualificada.',
        'Praças prioritárias e sinais de demanda que já aparecem no site.',
        'Leitura atual das páginas por área, prova institucional e conteúdo de apoio.'
      ],
      receiveItems: [
        'Hipótese inicial sobre qual área deveria ganhar página mais forte primeiro.',
        'Sinal mais claro de como ligar autoridade, área de atuação e contexto local.',
        'Direção sobre o que precisa ser institucional, comercial e BOFU na vertical.'
      ],
      disqualifiers: [
        'Se o escritório ainda não definiu claramente as áreas que quer priorizar.',
        'Se a expectativa é ranquear sem reforçar confiança e clareza jurídica.',
        'Se a operação ainda trata a página como cartão institucional e não como ativo comercial.'
      ]
    };
  }

  if (page.slug.includes('software-b2b')) {
    return {
      title: 'COMO ENTRAR EM SOFTWARE B2B COM MENOS RUÍDO DE PIPELINE',
      copy:
        'Em software B2B, a triagem inicial precisa separar categoria, ICP e estágio de demanda. O objetivo é evitar conversa genérica e direcionar o diagnóstico para pipeline real.',
      prepareItems: [
        'Categoria do produto, ICP e tipo de demanda que mais interessa à operação.',
        'Páginas que hoje deveriam gerar pipeline e ainda não sustentam essa função.',
        'Leitura do papel de conteúdo, comparativos e páginas de solução na aquisição.'
      ],
      receiveItems: [
        'Hipótese inicial de quais páginas ajudam mais a gerar pipeline qualificado.',
        'Direção sobre como separar solução, comparativo e conteúdo de decisão.',
        'Sinal de quais ajustes entram primeiro para reduzir ruído entre tráfego e oportunidade.'
      ],
      disqualifiers: [
        'Se a operação ainda não tem clareza sobre ICP e categoria central da oferta.',
        'Se a expectativa é tratar SEO como substituto de toda a geração outbound.',
        'Se o site ainda não consegue sustentar páginas de solução e decisão com mínima consistência.'
      ]
    };
  }

  if (page.slug.includes('energia-solar')) {
    return {
      title: 'COMO ENTRAR EM ENERGIA SOLAR COM MAIS CLAREZA COMERCIAL',
      copy:
        'Em energia solar, a conversa inicial precisa separar demanda regional, oferta consultiva e papel do SEO frente à mídia paga. Isso evita diagnóstico errado já na entrada.',
      prepareItems: [
        'Praças ou regiões que mais deveriam gerar demanda qualificada hoje.',
        'Tipo de oferta principal e como a empresa hoje explica valor, economia e proposta.',
        'Leitura do papel atual de páginas de solução, comparativos e mídia paga.'
      ],
      receiveItems: [
        'Leitura inicial sobre onde a arquitetura comercial está fraca para gerar demanda.',
        'Direção de como conectar vertical, praça e comparativos sem ruído.',
        'Sinal mais claro do que precisa ser reforçado para a operação deixar de depender só de mídia.'
      ],
      disqualifiers: [
        'Se a empresa ainda não definiu quais regiões realmente importam comercialmente.',
        'Se a expectativa é usar SEO só como complemento tático sem ajustar a mensagem da oferta.',
        'Se o site ainda não tem base mínima para sustentar prova, solução e conteúdo de decisão.'
      ]
    };
  }

  return {
    title: 'COMO ENTRAR NESTA FRENTE COM MAIS CLAREZA',
    copy:
      'A conversa inicial precisa reduzir ruído de timing, escopo e contexto antes do diagnóstico. Esta camada existe para filtrar melhor a demanda.',
