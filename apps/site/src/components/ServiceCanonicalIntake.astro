---
import type { ServiceCanonicalIntakeLayer as ServiceCanonicalIntakeLayerData } from '../data/service-canonical-intake';

interface Props {
  layer: ServiceCanonicalIntakeLayerData;
}

const { layer } = Astro.props as Props;
---
<section class="service-canonical-intake">
  <div class="container-shell">
    <div class="service-canonical-intake__head">
      <span class="section-eyebrow">{layer.eyebrow}</span>
      <h2 class="service-canonical-intake__title">{layer.title}</h2>
      <p class="service-canonical-intake__copy">{layer.copy}</p>
    </div>

    <div class="service-canonical-intake__grid">
      <article class="service-canonical-intake__card">
        <h3>Traga para a conversa</h3>
        <ul>
          {layer.prepareItems.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </article>

      <article class="service-canonical-intake__card">
        <h3>O que você recebe primeiro</h3>
        <ul>
          {layer.receiveItems.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </article>

      <article class="service-canonical-intake__card">
        <h3>Talvez não seja a entrada certa se...</h3>
        <ul>
          {layer.disqualifiers.map((item) => (
            <li>{item}</li>
          ))}
        </ul>
      </article>
    </div>
  </div>
</section>

<style>
  .service-canonical-intake {
    padding: 0 0 5rem;
  }

  .service-canonical-intake__head {
    max-width: 56rem;
    margin-bottom: 2rem;
  }

  .service-canonical-intake__title {
    margin: 1rem 0;
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(2.8rem, 6vw, 4.9rem);
    line-height: 0.95;
    letter-spacing: 0.03em;
    color: var(--text-light);
  }

  .service-canonical-intake__copy {
    max-width: 44rem;
    color: var(--text-muted);
    font-size: 1.08rem;
  }

  .service-canonical-intake__grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 1rem;
  }

  .service-canonical-intake__card {
    padding: 2rem;
    border: 1px solid var(--border-soft);
    background: rgba(14, 14, 16, 0.92);
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.2);
  }

  .service-canonical-intake__card h3 {
    margin: 0 0 0.9rem;
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2rem;
    line-height: 0.98;
    letter-spacing: 0.03em;
    color: var(--text-light);
  }

  .service-canonical-intake__card ul {
    margin: 0;
    padding-left: 1.2rem;
    color: var(--text-muted);
  }

  .service-canonical-intake__card li + li {
    margin-top: 0.85rem;
  }

  @media (max-width: 960px) {
    .service-canonical-intake__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
