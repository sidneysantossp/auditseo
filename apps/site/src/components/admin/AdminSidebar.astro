---
interface NavItem {
  label: string;
  path: string;
  icon: string;
}

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props as Props;

const primaryNav: NavItem[] = [
  {
    label: 'Dashboard',
    path: '/admin/',
    icon: 'dashboard'
  },
  {
    label: 'Pipeline',
    path: '/admin/pipeline/',
    icon: 'pipeline'
  },
  {
    label: 'Leads',
    path: '/admin/leads/',
    icon: 'leads'
  },
  {
    label: 'Atividades',
    path: '/admin/atividades/',
    icon: 'activities'
  },
];

const editorialNav: NavItem[] = [
  {
    label: 'Conteúdos',
    path: '/admin/conteudos/',
    icon: 'content'
  },
  {
    label: 'Clusters',
    path: '/admin/clusters/',
    icon: 'clusters'
  },
  {
    label: 'Workflow',
    path: '/admin/workflow/',
    icon: 'workflow'
  }
];

function isActive(path: string) {
  if (path === '/admin/') {
    return currentPath === '/admin/';
  }

  return currentPath.startsWith(path);
}

function iconPath(icon: string) {
  switch (icon) {
    case 'dashboard':
      return 'M4 5.75A1.75 1.75 0 0 1 5.75 4h4.5A1.75 1.75 0 0 1 12 5.75v4.5A1.75 1.75 0 0 1 10.25 12h-4.5A1.75 1.75 0 0 1 4 10.25zm8 0A1.75 1.75 0 0 1 13.75 4h4.5A1.75 1.75 0 0 1 20 5.75v1.5A1.75 1.75 0 0 1 18.25 9h-4.5A1.75 1.75 0 0 1 12 7.25zm0 8A1.75 1.75 0 0 1 13.75 12h4.5A1.75 1.75 0 0 1 20 13.75v4.5A1.75 1.75 0 0 1 18.25 20h-4.5A1.75 1.75 0 0 1 12 18.25zm-8 1.5A1.75 1.75 0 0 1 5.75 12h1.5A1.75 1.75 0 0 1 9 13.75v4.5A1.75 1.75 0 0 1 7.25 20h-1.5A1.75 1.75 0 0 1 4 18.25z';
    case 'pipeline':
      return 'M5 18.25V13m7 5.25V9m7 9.25V5M3.75 20h16.5';
    case 'leads':
      return 'M12 12a4 4 0 1 0-4-4 4 4 0 0 0 4 4Zm-7 8a7 7 0 0 1 14 0';
    case 'activities':
      return 'M7.75 4v3m8.5-3v3M5 9.25h14M6.75 6h10.5A1.75 1.75 0 0 1 19 7.75v10.5A1.75 1.75 0 0 1 17.25 20H6.75A1.75 1.75 0 0 1 5 18.25V7.75A1.75 1.75 0 0 1 6.75 6Z';
    case 'content':
      return 'M6.75 5h10.5A1.75 1.75 0 0 1 19 6.75v10.5A1.75 1.75 0 0 1 17.25 19H6.75A1.75 1.75 0 0 1 5 17.25V6.75A1.75 1.75 0 0 1 6.75 5Zm2.25 4h6m-6 3h6m-6 3h4';
    case 'clusters':
      return 'M12 5.5 18 9v6l-6 3.5L6 15V9ZM12 5.5V12m0 0 6-3m-6 3-6-3';
    case 'workflow':
      return 'M5 7h8m0 0-2.5-2.5M13 7l-2.5 2.5M19 17h-8m0 0 2.5-2.5M11 17l2.5 2.5';
    default:
      return 'M12 6v12M6 12h12';
  }
}
---
<aside class="admin-sidebar" id="admin-sidebar">
  <div class="admin-sidebar__brand">
    <a class="admin-sidebar__logo" href="/admin/">AUDITSEO</a>
    <p class="admin-sidebar__subtitle">Admin editorial e operação de crescimento</p>
  </div>

  <div class="admin-sidebar__section">
    <div class="admin-sidebar__heading">CRM</div>
    <nav class="admin-sidebar__nav" aria-label="Navegação do painel">
      {primaryNav.map((item) => (
        <a class:list={['admin-sidebar__link', isActive(item.path) && 'is-active']} href={item.path}>
          <span class="admin-sidebar__link-head">
            <span class="admin-sidebar__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d={iconPath(item.icon)} />
              </svg>
            </span>
            <span class="admin-sidebar__link-label">{item.label}</span>
          </span>
        </a>
      ))}
    </nav>
  </div>

  <div class="admin-sidebar__section">
    <div class="admin-sidebar__heading">Editorial</div>
    <nav class="admin-sidebar__nav" aria-label="Navegação editorial do painel">
      {editorialNav.map((item) => (
        <a class:list={['admin-sidebar__link', isActive(item.path) && 'is-active']} href={item.path}>
          <span class="admin-sidebar__link-head">
            <span class="admin-sidebar__icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
                <path d={iconPath(item.icon)} />
              </svg>
            </span>
            <span class="admin-sidebar__link-label">{item.label}</span>
          </span>
        </a>
      ))}
    </nav>
  </div>

  <div class="admin-sidebar__section">
    <div class="admin-sidebar__heading">Base pública</div>
    <div class="admin-sidebar__meta-card">
      <div class="admin-sidebar__meta-label">Stack atual</div>
      <div class="admin-sidebar__meta-value">Astro + conteúdo tipado</div>
      <p class="admin-sidebar__meta-copy">
        O `/admin` usa o shell visual do CRM, mas governa a arquitetura pública do site sem soltar as regras de SEO.
      </p>
    </div>
  </div>

  <div class="admin-sidebar__section admin-sidebar__section--footer">
    <div class="admin-sidebar__user">
      <strong>Acesso aberto</strong>
      <span>Painel operacional no diretório `/admin`</span>
    </div>
    <a class="admin-sidebar__ghost-link" href="/">Abrir site público</a>
    <a class="admin-sidebar__ghost-link" href="/metodologia/">Ver metodologia</a>
  </div>
</aside>
