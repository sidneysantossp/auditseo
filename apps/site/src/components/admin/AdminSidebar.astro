---
interface NavItem {
  label: string;
  path: string;
  description: string;
  icon: string;
}

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props as Props;

const primaryNav: NavItem[] = [
  {
    label: 'Dashboard',
    path: '/admin/',
    description: 'Leitura executiva da operação editorial',
    icon: '📊'
  },
  {
    label: 'Conteúdos',
    path: '/admin/conteudos/',
    description: 'Inventário, categorias e backlog',
    icon: '🗂️'
  },
  {
    label: 'Clusters',
    path: '/admin/clusters/',
    description: 'Mapa mestre e prioridade comercial',
    icon: '🧭'
  },
  {
    label: 'Workflow',
    path: '/admin/workflow/',
    description: 'Fila, governança e operação',
    icon: '⚙️'
  }
];

function isActive(path: string) {
  if (path === '/admin/') {
    return currentPath === '/admin/';
  }

  return currentPath.startsWith(path);
}
---
<aside class="admin-sidebar" id="admin-sidebar">
  <div class="admin-sidebar__brand">
    <a class="admin-sidebar__logo" href="/admin/">AUDITSEO</a>
    <p class="admin-sidebar__subtitle">Admin editorial e operação de crescimento</p>
  </div>

  <div class="admin-sidebar__section">
    <div class="admin-sidebar__heading">Operação</div>
    <nav class="admin-sidebar__nav" aria-label="Navegação do painel">
      {primaryNav.map((item) => (
        <a class:list={['admin-sidebar__link', isActive(item.path) && 'is-active']} href={item.path}>
          <span class="admin-sidebar__link-head">
            <span class="admin-sidebar__icon" aria-hidden="true">{item.icon}</span>
            <span class="admin-sidebar__link-label">{item.label}</span>
          </span>
          <span class="admin-sidebar__link-copy">{item.description}</span>
        </a>
      ))}
    </nav>
  </div>

  <div class="admin-sidebar__section">
    <div class="admin-sidebar__heading">Base pública</div>
    <div class="admin-sidebar__meta-card">
      <div class="admin-sidebar__meta-label">Stack atual</div>
      <div class="admin-sidebar__meta-value">Astro + conteúdo tipado</div>
      <p class="admin-sidebar__meta-copy">
        O `/admin` usa o shell visual do CRM, mas governa a arquitetura pública do site sem soltar as regras de SEO.
      </p>
    </div>
  </div>

  <div class="admin-sidebar__section admin-sidebar__section--footer">
    <a class="admin-sidebar__ghost-link" href="/">Abrir site público</a>
    <a class="admin-sidebar__ghost-link" href="/metodologia/">Ver metodologia</a>
  </div>
</aside>
