---
interface Props {
  currentPath: string;
}

interface NavItem {
  label: string;
  path: string;
}

const { currentPath } = Astro.props as Props;

const navItems: NavItem[] = [
  { label: 'Dashboard', path: '/admin/' },
  { label: 'Pipeline', path: '/admin/pipeline/' },
  { label: 'Leads', path: '/admin/leads/' },
  { label: 'Atividades', path: '/admin/atividades/' },
  { label: 'Conteúdos', path: '/admin/conteudos/' },
  { label: 'Clusters', path: '/admin/clusters/' },
  { label: 'Workflow', path: '/admin/workflow/' }
];

function isActive(path: string) {
  if (path === '/admin/') {
    return currentPath === '/admin/';
  }

  return currentPath.startsWith(path);
}
---
<header class="admin-topbar">
  <a class="admin-topbar__brand" href="/admin/">AUDITSEO</a>

  <nav class="admin-topbar__nav" aria-label="Navegação principal do admin">
    {navItems.map((item) => (
      <a class:list={['admin-topbar__nav-link', isActive(item.path) && 'is-active']} href={item.path}>
        {item.label}
      </a>
    ))}
  </nav>

  <div class="admin-topbar__actions">
    <div class="admin-session" data-admin-session-box></div>
    <a class="admin-topbar__button admin-topbar__button--ghost" href="/politica-editorial/">
      Governança editorial
    </a>
    <a class="admin-topbar__button admin-topbar__button--primary" href="/blog/">
      Ver blog público
    </a>
  </div>
</header>
