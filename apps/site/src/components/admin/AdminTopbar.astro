---
interface Props {
  eyebrow: string;
  title: string;
}

const { eyebrow, title } = Astro.props as Props;
const breadcrumb = eyebrow
  .split('/')
  .map((item) => item.trim())
  .filter(Boolean)
  .join(' / ');
---
<header class="admin-topbar">
  <div class="admin-topbar__left">
    <button
      class="admin-topbar__toggle"
      type="button"
      aria-label="Abrir navegação do admin"
      aria-controls="admin-sidebar"
      aria-expanded="false"
      data-admin-toggle
    >
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
        <path d="M4 7h16" />
        <path d="M4 12h16" />
        <path d="M4 17h16" />
      </svg>
    </button>

    <div class="admin-topbar__meta">
      <div class="admin-topbar__eyebrow">{breadcrumb}</div>
      <div class="admin-topbar__context">{title}</div>
    </div>
  </div>

  <div class="admin-topbar__actions">
    <div class="admin-session" data-admin-session-box></div>
    <a class="admin-topbar__button admin-topbar__button--ghost" href="/politica-editorial/">
      Padrões editoriais
    </a>
    <a class="admin-topbar__button admin-topbar__button--primary" href="/blog/">
      Abrir site
    </a>
  </div>
</header>
