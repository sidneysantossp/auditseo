<script is:inline>
  (() => {
    const titleField = document.getElementById('snippet-title');
    const descriptionField = document.getElementById('snippet-description');
    const urlField = document.getElementById('snippet-url');
    const titlePreview = document.getElementById('snippet-preview-title');
    const descriptionPreview = document.getElementById('snippet-preview-description');
    const urlPreview = document.getElementById('snippet-preview-url');
    const titleCounter = document.getElementById('snippet-title-counter');
    const descriptionCounter = document.getElementById('snippet-description-counter');
    const resetButton = document.getElementById('snippet-reset');

    if (
      !(titleField instanceof HTMLInputElement) ||
      !(descriptionField instanceof HTMLTextAreaElement) ||
      !(urlField instanceof HTMLInputElement) ||
      !(titlePreview instanceof HTMLElement) ||
      !(descriptionPreview instanceof HTMLElement) ||
      !(urlPreview instanceof HTMLElement) ||
      !(titleCounter instanceof HTMLElement) ||
      !(descriptionCounter instanceof HTMLElement)
    ) {
      return;
    }

    const defaults = {
      title:
        'AI Overview Optimization | Estrategia para aparecer nas respostas de IA | AUDITSEO',
      description:
        'Otimize paginas, estrutura e entidades para aumentar a chance da sua marca ser citada em AI Overviews e outras superficies de busca generativa.',
      url: 'https://www.auditseo.com.br/servicos/ai-overview-optimization/'
    };

    const applyCounterState = (node, length, goodLimit, maxLimit) => {
      node.classList.remove('is-good', 'is-warn', 'is-over');

      if (length <= goodLimit) {
        node.classList.add('is-good');
      } else if (length <= maxLimit) {
        node.classList.add('is-warn');
      } else {
        node.classList.add('is-over');
      }
    };

    const updatePreview = () => {
      const title = titleField.value.trim() || defaults.title;
      const description = descriptionField.value.trim() || defaults.description;
      const url = urlField.value.trim() || defaults.url;

      titlePreview.textContent = title;
      descriptionPreview.textContent = description;
      urlPreview.textContent = url.replace(/^https?:\/\//, '');

      titleCounter.textContent = `${titleField.value.length}/60`;
      descriptionCounter.textContent = `${descriptionField.value.length}/155`;

      applyCounterState(titleCounter, titleField.value.length, 55, 60);
      applyCounterState(descriptionCounter, descriptionField.value.length, 145, 155);
    };

    resetButton?.addEventListener('click', () => {
      titleField.value = defaults.title;
      descriptionField.value = defaults.description;
      urlField.value = defaults.url;
      updatePreview();
    });

    [titleField, descriptionField, urlField].forEach((field) => {
      field.addEventListener('input', updatePreview);
    });

    titleField.value = defaults.title;
    descriptionField.value = defaults.description;
    urlField.value = defaults.url;
    updatePreview();
  })();
</script>
