---
import '../styles/institutional-trust-pages.css';
import '../styles/commercial-service-pages.css';

const sectorLinks = [
  {
    title: 'SEO para Clínicas Médicas',
    copy: 'Página comercial setorial para clínicas médicas com foco em descoberta, GBP e páginas de decisão.',
    path: '/servicos/seo-para-clinicas-medicas/'
  },
  {
    title: 'SEO para Dermatologistas',
    copy: 'Vertical comercial para dermatologia com foco em tratamentos, busca local e contexto de alta concorrência.',
    path: '/servicos/seo-para-dermatologistas/'
  },
  {
    title: 'SEO para Odontologia',
    copy: 'Página comercial para odontologia orientada a procedimentos, mapa e agenda qualificada.',
    path: '/servicos/seo-para-odontologia/'
  },
  {
    title: 'SEO para Escritórios de Advocacia em São Paulo',
    copy: 'Página comercial jurídica para São Paulo com foco em áreas de atuação, autoridade e descoberta qualificada.',
    path: '/servicos/seo-para-escritorios-de-advocacia-em-sao-paulo/'
  },
  {
    title: 'Consultoria SEO para Energia Solar em São Paulo',
    copy: 'Frente B2B voltada a energia solar com foco em páginas de solução, demanda regional e geração comercial.',
    path: '/servicos/consultoria-seo-para-energia-solar-em-sao-paulo/'
  },
  {
    title: 'Consultoria SEO para Software B2B em São Paulo',
    copy: 'Página comercial para software B2B, SaaS e tecnologia com foco em categoria, comparação e descoberta orgânica.',
    path: '/servicos/consultoria-seo-para-software-b2b-em-sao-paulo/'
  },
  {
    title: 'Consultoria SEO para Empresas no Interior de São Paulo',
    copy: 'Ponte regional para polos do interior paulista com foco em expansão comercial planejada.',
    path: '/servicos/consultoria-seo-para-empresas-no-interior-de-sao-paulo/'
  },
  {
    title: 'SEO Local para Clínicas Médicas no Rio de Janeiro',
    copy: 'Página local para clínicas médicas no Rio com foco em geografia, especialidades e Google Maps.',
    path: '/servicos/seo-local-para-clinicas-medicas-em-rio-de-janeiro/'
  },
  {
    title: 'SEO Local para Clínicas Médicas em Belo Horizonte',
    copy: 'Página local para clínicas médicas em BH com foco em descoberta urbana, página comercial e Maps.',
    path: '/servicos/seo-local-para-clinicas-medicas-em-belo-horizonte/'
  },
  {
    title: 'SEO Local para Clínicas Médicas em Curitiba',
    copy: 'Página local para clínicas médicas em Curitiba com foco em descoberta urbana, página comercial e Maps.',
    path: '/servicos/seo-local-para-clinicas-medicas-em-curitiba/'
  },
  {
    title: 'SEO Local para Clínicas Médicas em Brasília',
    copy: 'Página local para clínicas médicas em Brasília com foco em descoberta urbana, página comercial e Maps.',
    path: '/servicos/seo-local-para-clinicas-medicas-em-brasilia/'
  }
];
---
<section class="ee-page-section ee-commercial-hub-extension">
  <div class="ee-page-section-head">
    <span class="ee-page-section-badge">Aplicações Comerciais</span>
    <h2 class="ee-page-section-title">VERTICAIS SERVICE-FIRST JÁ DISPONÍVEIS</h2>
    <p class="ee-page-section-subtitle">
      Essas páginas comerciais existem para capturar intenção de contratação sem expor a taxonomia interna do projeto na URL pública.
    </p>
  </div>
  <div class="ee-page-grid three">
    {sectorLinks.map((item) => (
      <article class="ee-page-card">
        <h3>{item.title}</h3>
        <p>{item.copy}</p>
        <div class="ee-page-links">
          <a href={item.path}>Abrir página</a>
        </div>
      </article>
    ))}
  </div>
</section>
