---
import { siteMetadata } from '../data/site';
---
<div class="modal-overlay" id="cta-modal" data-endpoint={siteMetadata.forms.diagnosticEndpoint} aria-hidden="true">
  <div class="modal-container">
    <button class="modal-close" type="button" data-close-cta-modal aria-label="Fechar formulario">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M18 6L6 18M6 6l12 12"></path>
      </svg>
    </button>

    <div class="modal-header">
      <span class="modal-badge">DIAGNOSTICO AI-FIRST</span>
      <h2 class="modal-title">Vamos comecar sua<br />transformacao digital</h2>
      <p class="modal-subtitle">
        Preencha as informacoes abaixo e receba seu diagnostico personalizado em ate 48h.
      </p>
    </div>

    <div class="form-steps" aria-hidden="true">
      <div class="form-step-dot active" data-step-dot="1"></div>
      <div class="form-step-dot" data-step-dot="2"></div>
      <div class="form-step-dot" data-step-dot="3"></div>
      <div class="form-step-dot" data-step-dot="4"></div>
      <div class="form-step-dot" data-step-dot="5"></div>
    </div>

    <form class="form-content" id="cta-diagnostic-form">
      <div class="form-slide active" data-form-slide="1">
        <div class="form-group">
          <label class="form-label" for="cta-name">Qual e o seu nome? <span>*</span></label>
          <input class="form-input" id="cta-name" name="Nome" type="text" placeholder="Digite seu nome completo" required />
        </div>
        <div class="form-nav">
          <button class="form-nav-btn btn-next" type="button" data-next-step="1">Continuar</button>
        </div>
      </div>

      <div class="form-slide" data-form-slide="2">
        <div class="form-group">
          <label class="form-label" for="cta-whatsapp">Seu WhatsApp <span>*</span></label>
          <input class="form-input" id="cta-whatsapp" name="WhatsApp" type="tel" placeholder="(11) 99999-9999" required />
        </div>
        <div class="form-nav">
          <button class="form-nav-btn btn-back" type="button" data-prev-step="2">Voltar</button>
          <button class="form-nav-btn btn-next" type="button" data-next-step="2">Continuar</button>
        </div>
      </div>

      <div class="form-slide" data-form-slide="3">
        <div class="form-group">
          <label class="form-label" for="cta-site">Qual e o site da sua empresa?</label>
          <input class="form-input" id="cta-site" name="Site" type="url" placeholder="https://suaempresa.com.br" />
        </div>
        <div class="form-nav">
          <button class="form-nav-btn btn-back" type="button" data-prev-step="3">Voltar</button>
          <button class="form-nav-btn btn-next" type="button" data-next-step="3">Continuar</button>
        </div>
      </div>

      <div class="form-slide" data-form-slide="4">
        <div class="form-group">
          <label class="form-label" for="cta-services">Cite 3 servicos ou produtos <span>*</span></label>
          <textarea class="form-input form-textarea" id="cta-services" name="Servicos_Produtos" placeholder="Ex: Consultoria empresarial, Treinamentos corporativos, Mentoria executiva" required></textarea>
        </div>
        <div class="form-nav">
          <button class="form-nav-btn btn-back" type="button" data-prev-step="4">Voltar</button>
          <button class="form-nav-btn btn-next" type="button" data-next-step="4">Continuar</button>
        </div>
      </div>

      <div class="form-slide" data-form-slide="5">
        <div class="form-group">
          <label class="form-label">Ja faz investimentos em SEO? <span>*</span></label>
          <div class="form-options">
            <div class="form-option">
              <input id="seo-1" name="Investimento_SEO" type="radio" value="Sim, atualmente invisto em SEO" />
              <label for="seo-1">
                <span class="form-option-radio"></span>
                <span class="form-option-text">Sim, atualmente invisto em SEO</span>
              </label>
            </div>
            <div class="form-option">
              <input id="seo-2" name="Investimento_SEO" type="radio" value="Ja investi, mas parei" />
              <label for="seo-2">
                <span class="form-option-radio"></span>
                <span class="form-option-text">Ja investi, mas parei</span>
              </label>
            </div>
            <div class="form-option">
              <input id="seo-3" name="Investimento_SEO" type="radio" value="Nunca investi em SEO" />
              <label for="seo-3">
                <span class="form-option-radio"></span>
                <span class="form-option-text">Nunca investi em SEO</span>
              </label>
            </div>
            <div class="form-option">
              <input id="seo-4" name="Investimento_SEO" type="radio" value="Faco SEO internamente" />
              <label for="seo-4">
                <span class="form-option-radio"></span>
                <span class="form-option-text">Faco SEO internamente</span>
              </label>
            </div>
          </div>
        </div>
        <div class="form-nav">
          <button class="form-nav-btn btn-back" type="button" data-prev-step="5">Voltar</button>
          <button class="form-nav-btn btn-next" id="cta-submit-button" type="button">
            <span class="btn-text">Enviar diagnostico</span>
            <span class="btn-loading" hidden>Enviando...</span>
          </button>
        </div>
      </div>

      <div class="form-slide" data-form-slide="success">
        <div class="form-success">
          <div class="form-success-icon">
            <svg viewBox="0 0 24 24" fill="none">
              <path d="M20 6L9 17l-5-5" stroke-linecap="round" stroke-linejoin="round"></path>
            </svg>
          </div>
          <h3 class="form-success-title">Enviado com sucesso</h3>
          <p class="form-success-text">
            Obrigado pelo seu interesse. Nossa equipe analisara suas informacoes e entrara em
            contato em ate 48 horas com seu diagnostico personalizado.
          </p>
          <button class="form-nav-btn btn-next" type="button" data-close-cta-modal>Fechar</button>
        </div>
      </div>
    </form>
  </div>
</div>

<script is:inline>
  (() => {
    const overlay = document.getElementById('cta-modal');
    if (!overlay) return;

    const form = overlay.querySelector('#cta-diagnostic-form');
    const slides = Array.from(overlay.querySelectorAll('[data-form-slide]'));
    const dots = Array.from(overlay.querySelectorAll('[data-step-dot]'));
    const submitButton = overlay.querySelector('#cta-submit-button');
    const submitText = submitButton?.querySelector('.btn-text');
    const submitLoading = submitButton?.querySelector('.btn-loading');
    const endpoint = overlay.dataset.endpoint;
    const totalSteps = 5;

    const whatsappField = overlay.querySelector('#cta-whatsapp');

    const showStep = (step) => {
      slides.forEach((slide) => {
        const isMatch = slide.getAttribute('data-form-slide') === String(step);
        slide.classList.toggle('active', isMatch);
      });
      dots.forEach((dot, index) => {
        dot.classList.remove('active', 'completed');
        if (index + 1 === step) dot.classList.add('active');
        if (index + 1 < step) dot.classList.add('completed');
      });
    };

    const showSuccess = () => {
      slides.forEach((slide) => {
        slide.classList.toggle('active', slide.getAttribute('data-form-slide') === 'success');
      });
      dots.forEach((dot) => dot.classList.remove('active', 'completed'));
    };

    const resetForm = () => {
      form?.reset();
      showStep(1);
      if (submitButton) submitButton.disabled = false;
      if (submitText) submitText.hidden = false;
      if (submitLoading) submitLoading.hidden = true;
    };

    const openModal = () => {
      overlay.classList.add('active');
      overlay.setAttribute('aria-hidden', 'false');
      document.body.style.overflow = 'hidden';
    };

    const closeModal = () => {
      overlay.classList.remove('active');
      overlay.setAttribute('aria-hidden', 'true');
      document.body.style.overflow = '';
      window.setTimeout(resetForm, 350);
    };

    const validateStep = (step) => {
      if (step === 1) return overlay.querySelector('#cta-name')?.reportValidity() ?? false;
      if (step === 2) return overlay.querySelector('#cta-whatsapp')?.reportValidity() ?? false;
      if (step === 3) {
        const siteField = overlay.querySelector('#cta-site');
        if (!siteField || !siteField.value) return true;
        return siteField.reportValidity();
      }
      if (step === 4) return overlay.querySelector('#cta-services')?.reportValidity() ?? false;
      if (step === 5) {
        const checked = overlay.querySelector('input[name="Investimento_SEO"]:checked');
        if (!checked) {
          window.alert('Selecione uma opcao antes de continuar.');
          return false;
        }
        return true;
      }
      return true;
    };

    overlay.querySelectorAll('[data-next-step]').forEach((button) => {
      button.addEventListener('click', () => {
        const step = Number(button.getAttribute('data-next-step'));
        if (!validateStep(step)) return;
        showStep(Math.min(step + 1, totalSteps));
      });
    });

    overlay.querySelectorAll('[data-prev-step]').forEach((button) => {
      button.addEventListener('click', () => {
        const step = Number(button.getAttribute('data-prev-step'));
        showStep(Math.max(step - 1, 1));
      });
    });

    overlay.querySelectorAll('[data-close-cta-modal]').forEach((button) => {
      button.addEventListener('click', closeModal);
    });

    overlay.addEventListener('click', (event) => {
      if (event.target === overlay) closeModal();
    });

    document.addEventListener('auditseo:open-cta-modal', openModal);
    document.addEventListener('auditseo:close-cta-modal', closeModal);
    window.openModal = openModal;
    window.closeModal = closeModal;
    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && overlay.classList.contains('active')) closeModal();
    });

    whatsappField?.addEventListener('input', (event) => {
      const target = event.currentTarget;
      if (!(target instanceof HTMLInputElement)) return;

      let value = target.value.replace(/\D/g, '');
      if (value.length > 11) value = value.slice(0, 11);

      if (value.length > 0) {
        if (value.length <= 2) {
          value = `(${value}`;
        } else if (value.length <= 7) {
          value = `(${value.slice(0, 2)}) ${value.slice(2)}`;
        } else {
          value = `(${value.slice(0, 2)}) ${value.slice(2, 7)}-${value.slice(7)}`;
        }
      }

      target.value = value;
    });

    submitButton?.addEventListener('click', async () => {
      if (!validateStep(5) || !form || !endpoint) return;

      const payload = Object.fromEntries(new FormData(form).entries());
      payload._subject = 'Novo Diagnostico AI-First - AUDITSEO';
      payload._captcha = 'false';

      submitButton.disabled = true;
      if (submitText) submitText.hidden = true;
      if (submitLoading) submitLoading.hidden = false;

      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json'
          },
          body: JSON.stringify(payload)
        });

        if (!response.ok) {
          throw new Error('Falha ao enviar o formulario.');
        }

        showSuccess();
      } catch (error) {
        console.error(error);
        window.alert('Nao foi possivel enviar agora. Tente novamente em instantes.');
        submitButton.disabled = false;
        if (submitText) submitText.hidden = false;
        if (submitLoading) submitLoading.hidden = true;
      }
    });

    const params = new URLSearchParams(window.location.search);
    if (params.get('diagnostico') === '1') {
      openModal();
      params.delete('diagnostico');
      const nextQuery = params.toString();
      const cleanUrl = `${window.location.pathname}${nextQuery ? `?${nextQuery}` : ''}${window.location.hash}`;
      window.history.replaceState({}, document.title, cleanUrl);
    }
  })();
</script>
