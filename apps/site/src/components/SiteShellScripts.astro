---
import { siteMetadata } from '../data/site';
---
<script
  is:inline
  type="application/json"
  id="auditseo-crm-capture-config"
  set:html={JSON.stringify({ endpoint: siteMetadata.forms.crmCaptureEndpoint })}
></script>
<script is:inline>
  (() => {
    const body = document.body;
    const header = document.querySelector('.as-header');
    const mobileMenu = document.getElementById('site-mobile-nav');
    const burger = document.querySelector('[data-mobile-toggle]');
    const landingKey = 'auditseo:first-landing-url';
    const referrerKey = 'auditseo:first-referrer';
    const utmKey = 'auditseo:utm-context';

    const safeReadStorage = (key) => {
      try {
        return window.sessionStorage.getItem(key);
      } catch {
        return null;
      }
    };

    const safeWriteStorage = (key, value) => {
      try {
        window.sessionStorage.setItem(key, value);
      } catch {
        return null;
      }
    };

    if (!safeReadStorage(landingKey)) {
      safeWriteStorage(landingKey, window.location.href);
    }

    if (!safeReadStorage(referrerKey) && document.referrer) {
      safeWriteStorage(referrerKey, document.referrer);
    }

    const utmParams = ['utm_source', 'utm_medium', 'utm_campaign', 'utm_content', 'utm_term'];
    const urlParams = new URLSearchParams(window.location.search);
    const utmContext = Object.fromEntries(
      utmParams
        .map((key) => [key, urlParams.get(key)])
        .filter(([, value]) => Boolean(value))
    );

    if (Object.keys(utmContext).length > 0) {
      safeWriteStorage(utmKey, JSON.stringify(utmContext));
    }

    const parseStoredUtm = () => {
      const raw = safeReadStorage(utmKey);
      if (!raw) return {};

      try {
        return JSON.parse(raw);
      } catch {
        return {};
      }
    };

    const getAttributionContext = () => {
      const storedLanding = safeReadStorage(landingKey);
      const storedReferrer = safeReadStorage(referrerKey);
      const storedUtm = parseStoredUtm();

      return {
        pageUrl: window.location.href,
        pagePath: window.location.pathname,
        pageTitle: document.title,
        firstLandingUrl: storedLanding || window.location.href,
        referrer: document.referrer || storedReferrer || 'direto',
        utm: storedUtm
      };
    };

    const captureConfigNode = document.getElementById('auditseo-crm-capture-config');
    let captureEndpoint = '';

    if (captureConfigNode?.textContent) {
      try {
        captureEndpoint = JSON.parse(captureConfigNode.textContent).endpoint || '';
      } catch {
        captureEndpoint = '';
      }
    }

    const sendLeadCapture = async (payload, options = {}) => {
      if (!captureEndpoint) {
        return { ok: false, skipped: true };
      }

      const context = getAttributionContext();
      const body = {
        source: 'site',
        pagePath: context.pagePath,
        pageUrl: context.pageUrl,
        pageTitle: context.pageTitle,
        firstLandingUrl: context.firstLandingUrl,
        referrer: context.referrer,
        utm: context.utm,
        ...payload
      };

      if (options.beacon && navigator.sendBeacon) {
        const blob = new Blob([JSON.stringify(body)], { type: 'application/json' });
        return {
          ok: navigator.sendBeacon(captureEndpoint, blob),
          mode: 'beacon'
        };
      }

      const response = await fetch(captureEndpoint, {
        method: 'POST',
        headers: {
          'Content-Type': 'application/json',
          Accept: 'application/json'
        },
        body: JSON.stringify(body),
        keepalive: options.keepalive === true
      });

      return {
        ok: response.ok,
        mode: 'fetch'
      };
    };

    const buildTrackedWhatsappUrl = (rawUrl) => {
      const context = getAttributionContext();
      const url = new URL(rawUrl, window.location.origin);
      const originalText = url.searchParams.get('text') || 'Olá! Vim pelo site da AUDITSEO e gostaria de mais informações.';
      const extraLines = [
        '',
        '---',
        `Página atual: ${context.pagePath}`,
        `URL atual: ${context.pageUrl}`,
        `Título: ${context.pageTitle}`,
        `Primeira página da sessão: ${context.firstLandingUrl}`,
        `Referrer: ${context.referrer}`
      ];

      const utmEntries = Object.entries(context.utm);
      if (utmEntries.length > 0) {
        extraLines.push(`UTMs: ${utmEntries.map(([key, value]) => `${key}=${value}`).join(', ')}`);
      }

      url.searchParams.set('text', `${originalText}\n${extraLines.join('\n')}`);
      return url.toString();
    };

    window.auditseoAttribution = {
      getContext: getAttributionContext,
      buildTrackedWhatsappUrl
    };
    window.auditseoLeadCapture = {
      getEndpoint: () => captureEndpoint,
      send: sendLeadCapture
    };

    const enhanceWhatsappLinks = () => {
      document.querySelectorAll('a[href*="wa.me/5511996384376"], a[href*="api.whatsapp.com/send"]').forEach((link) => {
        if (!(link instanceof HTMLAnchorElement)) return;
        if (link.dataset.whatsappTracked === 'true') return;

        link.dataset.whatsappTracked = 'true';
        link.addEventListener('click', () => {
          void sendLeadCapture(
            {
              captureType: 'whatsapp-click',
              channel: 'whatsapp',
              anchorText: link.textContent?.trim() || link.getAttribute('aria-label') || 'WhatsApp'
            },
            { beacon: true }
          ).catch(() => null);
          link.href = buildTrackedWhatsappUrl(link.href);
        });
      });
    };

    window.toggleFaq = (button) => {
      const item = button?.parentElement;
      const answer = item?.querySelector('.faq-answer');
      const icon = button?.querySelector('.faq-question-icon');
      const isOpen = Boolean(answer?.style.maxHeight && answer.style.maxHeight !== '0px');

      document.querySelectorAll('.faq-answer').forEach((node) => {
        node.style.maxHeight = '0px';
      });
      document.querySelectorAll('.faq-question-icon').forEach((node) => {
        node.style.transform = 'rotate(0deg)';
        node.textContent = '+';
      });
      document.querySelectorAll('.faq-question').forEach((node) => {
        node.setAttribute('aria-expanded', 'false');
      });

      if (!answer || !icon || isOpen) return;
      answer.style.maxHeight = `${answer.scrollHeight}px`;
      icon.style.transform = 'rotate(45deg)';
      button.setAttribute('aria-expanded', 'true');
    };

    const closeMobile = () => {
      body.classList.remove('as-mobile-open');
      mobileMenu?.classList.remove('is-open');
      burger?.setAttribute('aria-expanded', 'false');
    };

    const openMobile = () => {
      body.classList.add('as-mobile-open');
      mobileMenu?.classList.add('is-open');
      burger?.setAttribute('aria-expanded', 'true');
    };

    burger?.addEventListener('click', () => {
      if (mobileMenu?.classList.contains('is-open')) {
        closeMobile();
      } else {
        openMobile();
      }
    });

    document.querySelectorAll('[data-close-mobile-menu]').forEach((link) => {
      link.addEventListener('click', closeMobile);
    });

    document.querySelectorAll('[data-open-cta-modal]').forEach((button) => {
      button.addEventListener('click', () => {
        closeMobile();
        document.dispatchEvent(new CustomEvent('auditseo:open-cta-modal'));
      });
    });

    window.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && mobileMenu?.classList.contains('is-open')) {
        closeMobile();
      }
    });

    const syncHeaderState = () => {
      header?.classList.toggle('as-scrolled', window.scrollY > 16);
    };

    enhanceWhatsappLinks();
    document.addEventListener('scroll', syncHeaderState, { passive: true });
    syncHeaderState();
  })();
</script>
