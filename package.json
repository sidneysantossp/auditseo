{
  "name": "auditseo-workspace",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run site:dev",
    "build": "npm run site:build",
    "preview": "npm run site:preview",
    "check": "npm run site:check",
    "qa": "npm run site:qa",
    "site:dev": "npm --prefix apps/site run dev",
    "site:build": "npm --prefix apps/site run build",
    "site:preview": "npm --prefix apps/site run preview",
    "site:check": "npm --prefix apps/site run check",
    "site:qa": "npm --prefix apps/site run qa:site",
    "cms:dev": "npm --prefix apps/cms-api run dev",
    "cms:start": "npm --prefix apps/cms-api run start",
    "cms:reset": "npm --prefix apps/cms-api run reset",
    "legacy:build:home": "node scripts/build-home.mjs",
    "legacy:build:site": "node scripts/build-site.mjs",
    "legacy:preview:dist": "node scripts/preview-dist.mjs",
    "legacy:map:pages": "node scripts/map-pages.mjs",
    "legacy:seo:implement": "node scripts/seo-implement.mjs",
    "legacy:sitemap:generate": "node scripts/generate-sitemaps.mjs"
  }
}
