# Application
APP_NAME="AuditSEO"
APP_ENV=local
APP_URL=http://localhost/auditseo
APP_DEBUG=true

# Database
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=auditseo
DB_USERNAME=root
DB_PASSWORD=

# Mail
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@auditseo.com.br
MAIL_FROM_NAME="${APP_NAME}"

# Security
JWT_SECRET=your-secret-key-here
SESSION_LIFETIME=120

# SEO
GOOGLE_ANALYTICS_ID=
GOOGLE_TAG_MANAGER_ID=
