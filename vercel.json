{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm --prefix apps/site install && npm --prefix apps/site run build",
  "outputDirectory": "apps/site/dist",
  "cleanUrls": true,
  "trailingSlash": true,
  "redirects": [
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "auditseo.com.br"
        }
      ],
      "destination": "https://www.auditseo.com.br/$1",
      "permanent": true
    },
    {
      "source": "/blog/checklist-tecnico-ai-seo/:match*",
      "destination": "/blog/auditoria-tecnica-ai-seo/",
      "permanent": true
    },
    {
      "source": "/blog/seo-tecnico-para-ia/:match*",
      "destination": "/blog/auditoria-tecnica-ai-seo/",
      "permanent": true
    },
    {
      "source": "/blog/ferramentas-rastreamento-llm/:match*",
      "destination": "/blog/monitorar-citacoes-ia/",
      "permanent": true
    },
    {
      "source": "/blog/ferramentas-tracking-llm/:match*",
      "destination": "/blog/monitorar-citacoes-ia/",
      "permanent": true
    },
    {
      "source": "/servicos/seo-tecnico/:match*",
      "destination": "/servicos/auditoria-seo/",
      "permanent": true
    },
    {
      "source": "/saude/dermatologistas/:match*",
      "destination": "/nichos/dermatologistas/",
      "permanent": true
    },
    {
      "source": "/b2b/energia-solar/:match*",
      "destination": "/nichos/energia-solar/",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/_astro/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/images/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}
